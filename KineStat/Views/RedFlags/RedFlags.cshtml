@model IEnumerable<Question>
@{
    ViewData["Title"] = "Red Flags";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    ViewData["ShowFloatingEye"] = true;
    ViewData["ShowSuspendButton"] = true;
    var patientId = ViewData["PatientId"]; 
    var assessmentId = ViewData["AssessmentId"];
    var folderId = ViewData["FolderId"];
    ViewData["Breadcrumbs"] =
        $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Anamnese'>Anamnèse</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Dossier/{folderId}/Details'>Dossier</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Socrate/{assessmentId}'>SOCRATE</a></li>" +
        $"<li class='breadcrumb-item active'>Red Flags</li>";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <a asp-controller="Assessments" asp-action="Socrate" asp-route-id="@patientId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <div>
                    <h1 class="h2 fw-bold text-danger mb-2">
                        <i class="bi bi-exclamation-triangle me-2"></i>Red Flags
                    </h1>
                </div>
                <a asp-controller="ClinicalExam" asp-action="ExamenClinique" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-right me-2"></i>Suivant
                </a>
            </div>
            <hr class="border-danger border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="row g-2" id="redflagsTabs">
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-primary w-100 h-100 py-3" data-category="1">Tumeur / Métastase</button>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="2">Infection</button>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="3">Neurologique</button>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="4">Traumatisme / Fracture</button>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="5">Inflammatoire</button>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="6">Vasculaire / Circulatoire</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div id="questionnaireContainer" class="col-12 col-lg-8 mb-4 mb-lg-0">
        </div>
        <div id="testsContainer" class="col-12 col-lg-4">
        </div>
    </div>
</div>

<!-- Modal Red Flag Critique -->
<div class="modal fade" id="redFlagCriticalModal" tabindex="-1" aria-labelledby="redFlagCriticalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title fw-bold" id="redFlagCriticalModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Alerte Red Flag Critique
                </h5>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2">
                    Un seuil de redflags grave a été detecté. Souhaitez vous continuer le bilan ?
                </p>
                <p class="text-secondary small mb-0">
                    Vous pouvez poursuivre le questionnaire ou passer immédiatement aux résultats.
                </p>
            </div>
            <div class="modal-footer bg-light d-flex justify-content-between">
                <button class="btn btn-outline-secondary fw-medium" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-right me-2"></i>Continuer
                </button>
                <a id="redirectToSummaryBtn" class="btn btn-danger fw-medium">
                    <i class="bi bi-x-circle me-2"></i>Arrêter
                </a>
            </div>
        </div>
    </div>
</div>

<script src="~/js/gauge.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        if (window.RedFlagsStore) {
            RedFlagsStore.clear();
        }
    });
</script>

<script>
    let hasDisplayedCriticalModal = false;
    let criticalRedflagThreshold = 20;

    async function loadQuestionsByCategory(categoryId) {
        const patientId = @patientId;
        const assessmentId = @assessmentId;
        const response = await fetch(`/RedFlags/${patientId}/Assessment/${assessmentId}/Questions/${categoryId}`);
        const html = await response.text();
        document.getElementById("questionnaireContainer").innerHTML = html;
        attachNoteToggleEvents();
        attachAnswerListeners();
        initializeTooltips();
    }

    function initializeTooltips() {
        const tooltipElements = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipElements.forEach(el => {
            new bootstrap.Tooltip(el);
        });
    }

    function attachNoteToggleEvents() {
        document.querySelectorAll("[id^='notes_button_']").forEach(btn => {
            if (btn.dataset.listenersAdded === "true") return;
            btn.dataset.listenersAdded = "true";
            const targetSelector = btn.getAttribute("data-bs-target");
            const target = document.querySelector(targetSelector);

            if (!target) return;

            const textarea = target.querySelector('textarea');
            let btnText = "";
            if (textarea && textarea.value.trim() !== "") {
                btnText = "Afficher la note";
            } else {
                btnText = "Ajouter une note";
            }
            btn.textContent = btnText;

            target.addEventListener('shown.bs.collapse', () => {
                btn.textContent = "Masquer la note";
            });

            target.addEventListener('hidden.bs.collapse', () => {
                btn.textContent = btnText;
            });
        });
    }

    function showCriticalRedFlagModal(patientId) {
        if (hasDisplayedCriticalModal) return;
        hasDisplayedCriticalModal = true;
        const assessmentId = @assessmentId;
        const folderId = @folderId;
        const btn = document.getElementById("redirectToSummaryBtn");
        btn.href = `/Patient/${patientId}/Dossier/${folderId}/Resultat/${assessmentId}`;

        const modal = new bootstrap.Modal(document.getElementById("redFlagCriticalModal"));
        modal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        initializeTabs();
        loadQuestionsByCategory(1);
        initializeGauge();

        fetchInitialState();

        RedFlagsStore.subscribe(function(newValue) {
            updateGauge(newValue);
        });
    });

    function fetchInitialState() {
        const patientId = @patientId;
        const assessmentId = @assessmentId;

        fetch(`/Patient/${patientId}/Assessment/${assessmentId}/CategoryPercentages`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.totalPercentage !== undefined) {
                        RedFlagsStore.set(data.totalPercentage);
                    } else if (data.redflags !== undefined) {
                         RedFlagsStore.set(data.redflags);
                    }

                    if (data.categories) {
                        RedFlagsStore.setCategories(data.categories);
                    }
                }
            });
    }

    function attachAnswerListeners() {
        const radios = document.querySelectorAll('input[name^="q_"]');
        radios.forEach(radio => {
            radio.addEventListener('change', handleRadioChange);
        });
        const textareas = document.querySelectorAll('textarea[name^="note_"]');
        textareas.forEach(textarea => {
            textarea.addEventListener('change', handleTextareaInput);
        });
    }

    function handleRadioChange(event) {
        const radio = event.target;
        const questionId = radio.dataset.questionId;
        const value = radio.value === "true";
        const patientId = @ViewData["PatientId"];
        const comment = getCommentForQuestion(questionId);
        saveAnswer(patientId, questionId, value, comment);
    }

    function handleTextareaInput(event) {
        const textarea = event.target;
        const questionId = textarea.dataset.questionId;
        const comment = textarea.value;
        const patientId = @ViewData["PatientId"];
        const value = getRadioValueForQuestion(questionId);

        saveAnswer(patientId, questionId, value, comment);
    }

    function getCommentForQuestion(questionId) {
        const textarea = document.querySelector(`textarea[name="note_${questionId}"]`);
        return textarea ? textarea.value : "";
    }

    function getRadioValueForQuestion(questionId) {
        const radio = document.querySelector(`input[name="q_${questionId}"]:checked`);
        return radio ? (radio.value === "true") : null;
    }

    function saveAnswer(patientId, questionId, boolValue, comment) {
        const assessmentId = @assessmentId;
        const dto = {
            PatientId: patientId,
            QuestionId: questionId,
            BoolValue: boolValue,
            Comment: comment,
            AssessmentId: assessmentId
        };
        fetch(`/Patient/SaveOrUpdateAnswer`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dto)
        })
        .then(async response => {
            if (!response.ok) {
                throw new Error('Erreur serveur');
            }
            return response.json();
        })
        .then(data => {
            RedFlagsStore.set(data.redflags);
            if (data.categories) {
                RedFlagsStore.setCategories(data.categories);
            }
            if (data.redflags >= criticalRedflagThreshold) {
                showCriticalRedFlagModal(patientId);
            }
        });
    }

    function updateGauge(newValue) {
        if (typeof moveNeedle === 'function') {
            moveNeedle(newValue);
        }
        const elem = document.getElementById('probabilityValue');
        if (elem) elem.textContent = newValue.toFixed(2) + '%';
    }

    function initializeTabs() {
        document.querySelectorAll('#redflagsTabs button[data-category]').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();

                document.querySelectorAll('#redflagsTabs button')
                    .forEach(el => {
                        el.classList.remove('btn-primary');
                        el.classList.add('btn-outline-primary');
                    });
                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary');

                const categoryId = this.dataset.category;
                loadQuestionsByCategory(categoryId);
            });
        });
    }
</script>