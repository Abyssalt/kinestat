@model List<KineStat.Models.Cluster>
@using KineStat.Models

@{
    ViewData["Title"] = "Tests";
    ViewData["HideFloatingEye"] = true;
    var clusters = Model;
    var patientNom = ViewData["PatientNom"]?.ToString() ?? "Patient";
    var patientId = ViewData["PatientId"] != null ? Convert.ToInt32(ViewData["PatientId"]) : 0;
    var patient = ViewData["Patient"] as Patient;
    var assessmentId = ViewData["AssessmentId"];
    var folderId = ViewData["FolderId"];
    ViewData["Breadcrumbs"] =
        $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Anamnese'>Anamnèse</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Dossier/{folderId}/Details'>Dossier</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Socrate/{assessmentId}'>SOCRATE</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Dossier/{folderId}/RedFlags/{assessmentId}'>Red Flags</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Dossier/{folderId}/ExamenClinique/{assessmentId}'>Examen Clinique</a></li>" +
        $"<li class='breadcrumb-item active'>Tests</li>";

    int totalQuestions = clusters.Sum(c => c.Questions.Count);
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="card border-0 shadow mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                
                <a asp-controller="ClinicalExam" asp-action="ExamenClinique" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-clipboard2-pulse me-2"></i>Évaluation complète
                    </h1></div>
                <a asp-controller="Assessments" asp-action="Resultat" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-right me-2"></i>Passer aux résultats
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-list-check me-2"></i>Progression globale
                </h6>
                <span class="badge bg-primary" id="progressBadge">0 / @totalQuestions</span>
            </div>
            <div class="progress" style="height: 25px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     role="progressbar"
                     id="progressBar"
                     style="width: 0%"
                     aria-valuenow="0"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    0%
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-primary fw-medium" onclick="toggleAddTestForm()">
            <i class="bi bi-plus-circle me-2"></i>Ajouter un test spécifique
        </button>
    </div>

    <div class="collapse mt-3" id="addTestForm">
        <div class="card border-0 shadow border-start border-primary border-4">
            <div class="card-header bg-primary text-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-plus-square me-2"></i>Ajouter un test personnalisé
                </h6>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-medium">
                            <i class="bi bi-folder2-open me-1"></i>Dans quel cluster ajouter ce test ?
                        </label>
                        <select class="form-select" id="customTestCluster">
                            <option value="">-- Sélectionnez un cluster --</option>
                            @foreach (var cluster in clusters)
                            {
                                <option value="@cluster.Id">@cluster.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="button" class="btn btn-primary fw-medium" onclick="addCustomTest()">
                        <i class="bi bi-check-circle me-2"></i>Ajouter ce test
                    </button>
                    <button type="button" class="btn btn-outline-secondary fw-medium" onclick="toggleAddTestForm()">
                        <i class="bi bi-x-circle me-2"></i>Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="formTests">
        <input type="hidden" name="patientId" value="@patientId">

        @{
            int globalTestIndex = 0;
            int clusterIndex = 0;
        }

        <div class="clusters-grid">
            @foreach (var cluster in clusters)
            {
                var collapseId = "collapse-cluster-" + cluster.Id;

                <div class="cluster-card" data-cluster-id="@cluster.Id">
                    <div class="cluster-card-header" onclick="toggleClusterTests(@cluster.Id)">
                        <div class="cluster-title">
                            <span class="cluster-icon">📋</span>
                            <span>@cluster.Name</span>
                        </div>
                        <div class="cluster-badge-group">
                            <span class="cluster-progress-badge">0/@cluster.Questions.Count</span>
                            <span class="cluster-status-badge">Non commencé</span>
                        </div>
                    </div>

                    <div class="cluster-card-body">
                        <p class="cluster-description">
                            @cluster.Questions.Count test(s) à effectuer
                        </p>

                        <div class="cluster-progress-bar">
                            <div class="cluster-progress-fill" style="width: 0%"></div>
                        </div>

                        <div class="cluster-actions">
                            <button class="btn-cluster-action btn-start" onclick="toggleClusterTests(@cluster.Id)">
                                ▶ Commencer
                            </button>
                        </div>

                        <div id="@collapseId" class="collapse mt-3">
                            <div id="testsContainer-@cluster.Id">
                                @foreach (var question in cluster.Questions)
                                {
                                    globalTestIndex++;
                                    <div class="card border-0 shadow-sm mb-3 test-card" id="test-@question.Id" data-test-id="@question.Id">
                                        <div class="card-header bg-light py-3">
                                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                                                <div class="flex-grow-1">
                                                    <h5 class="mb-2 fw-bold">
                                                        <span class="badge bg-primary me-2">@globalTestIndex</span>
                                                        @question.Title
                                                    </h5>
                                                    <small class="text-secondary">
                                                        RV+ : <span class="badge bg-danger">@question.RVPositive</span>
                                                        @if (!string.IsNullOrWhiteSpace(question.SourceRv))
                                                        {
                                                            <span class="ms-2">
                                                                <i class="bi bi-book me-1"></i>@question.SourceRv
                                                            </span>
                                                        }
                                                    </small>
                                                </div>

                                                <span class="badge bg-success answered-badge" id="badge-@question.Id" style="display: none;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Complété
                                                </span>
                                            </div>
                                        </div>

                                        <div class="card-body p-3 p-md-4">
                                            @if (question is QuestionBool)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label fw-medium">Résultat</label>
                                                    <div class="btn-group w-100" role="group">
                                                        <input type="radio"
                                                               class="btn-check"
                                                               name="test-@question.Id-value"
                                                               id="oui-@question.Id"
                                                               value="true"
                                                               onchange="markAsAnswered(@question.Id); autoSaveTest(@question.Id)" />
                                                        <label class="btn btn-outline-success btn-lg fw-medium" for="oui-@question.Id">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Positif
                                                        </label>

                                                        <input type="radio"
                                                               class="btn-check"
                                                               name="test-@question.Id-value"
                                                               id="non-@question.Id"
                                                               value="false"
                                                               onchange="markAsAnswered(@question.Id); autoSaveTest(@question.Id)" />
                                                        <label class="btn btn-outline-secondary btn-lg fw-medium" for="non-@question.Id">
                                                            <i class="bi bi-x-circle-fill me-1"></i>Négatif
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="mb-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary fw-medium"
                                                            onclick="toggleObservations(@question.Id)">
                                                        <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                                    </button>
                                                </div>

                                                <div class="collapse" id="observations-@question.Id">
                                                    <div class="card border-0 bg-light mt-3">
                                                        <div class="card-body p-3">
                                                            <label class="form-label fw-medium">
                                                                <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                            </label>
                                                            <textarea class="form-control"
                                                          name="test-@question.Id-observations"
                                                          rows="3"
                                                          placeholder="Notez ici vos observations..."
                                                          oninput="autoSaveTest(@question.Id)"></textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else if (question is QuestionLadder ladder)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label fw-medium">
                                                        Valeur mesurée (@ladder.Min - @ladder.Max)
                                                    </label>
                                                    <input type="number"
                                                           class="form-control form-control-lg mb-3"
                                                           name="test-@question.Id-value"
                                                           min="@ladder.Min"
                                                           max="@ladder.Max"
                                                           placeholder="Entrez la valeur"
                                                           onchange="markAsAnswered(@question.Id); updateRangeFromInput(this, 'range-@question.Id', 'display-@question.Id')"
                                                           oninput="autoSaveTest(@question.Id)"
                                                           id="input-@question.Id">

                                                    <label class="form-label small text-secondary">Ou utilisez le curseur :</label>
                                                    <input type="range"
                                                           class="form-range"
                                                           id="range-@question.Id"
                                                           min="@ladder.Min"
                                                           max="@ladder.Max"
                                                           value="@ladder.Min"
                                                           step="1"
                                                           oninput="syncInputs(this, 'input-@question.Id', 'display-@question.Id'); autoSaveTest(@question.Id)" />
                                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                                        <small class="text-secondary fw-semibold">@ladder.Min</small>
                                                        <span class="badge bg-primary fs-5" id="display-@question.Id">@ladder.Min</span>
                                                        <small class="text-secondary fw-semibold">@ladder.Max</small>
                                                    </div>
                                                </div>

                                                <div class="mb-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary fw-medium"
                                                            onclick="toggleObservations(@question.Id)">
                                                        <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                                    </button>
                                                </div>

                                                <div class="collapse" id="observations-@question.Id">
                                                    <div class="card border-0 bg-light mt-3">
                                                        <div class="card-body p-3">
                                                            <label class="form-label fw-medium">
                                                                <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                            </label>
                                                            <textarea class="form-control"
                                                          name="test-@question.Id-observations"
                                                          rows="3"
                                                          placeholder="Notez ici vos observations..."
                                                          oninput="autoSaveTest(@question.Id)"></textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else if (question is QuestionQCM qcm)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label fw-medium">Observation</label>
                                                    <select class="form-select form-select-lg"
                                                            name="test-@question.Id-value"
                                                            onchange="markAsAnswered(@question.Id); autoSaveTest(@question.Id)">
                                                        <option value="">-- Sélectionnez une observation --</option>
                                                    </select>
                                                </div>

                                                <div class="mb-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary fw-medium"
                                                            onclick="toggleObservations(@question.Id)">
                                                        <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                                    </button>
                                                </div>

                                                <div class="collapse" id="observations-@question.Id">
                                                    <div class="card border-0 bg-light mt-3">
                                                        <div class="card-body p-3">
                                                            <label class="form-label fw-medium">
                                                                <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                            </label>
                                                            <textarea class="form-control"
                                                          name="test-@question.Id-observations"
                                                          rows="3"
                                                          placeholder="Notez ici vos observations..."
                                                          oninput="autoSaveTest(@question.Id)"></textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="text-center mt-4 mb-3">
                                    <button type="button" 
                                            class="btn-back-to-top" 
                                            onclick="scrollToClusterTop(@cluster.Id)">
                                        <i class="bi bi-arrow-up-circle"></i>
                                        Remonter en haut
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card border-0 shadow">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-between align-items-center">

                    <div class="d-flex gap-2 w-100 w-sm-auto">
                        <a asp-controller="Assessments" asp-action="Resultat" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                            <i class="bi bi-arrow-right me-2"></i>Passer aux résultats
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/Tests.js"></script>
    <link rel="stylesheet" href="~/css/tests.css" />
    <script>
        globalPatientId = @patientId;
        globalAssessmentId = @assessmentId;



        @{
            var existingResponsesList = ViewData["ExistingResponses"] as IEnumerable<PatientAnswerTests>;
            var responsesData = new List<object>();

            if (existingResponsesList != null)
            {
                foreach (var r in existingResponsesList)
                {
                    responsesData.Add(new
                    {
                        questionId = r.QuestionId,
                        answerId = r.AnswerId,
                        assessmentId = r.AssessmentId,
                        value = r.ResponseValue,
                        observations = r.Observations,
                        isCustom = r.IsCustomTest,
                        customName = r.CustomTestName,
                        customType = r.CustomTestType
                    });
                }
            }
        }


        const assessmentId = @assessmentId;

        var existingResponses = @Html.Raw(Json.Serialize(responsesData));

    document.addEventListener('DOMContentLoaded', function() {
        loadExistingResponses(existingResponses);
    });


        function calculateClusterProgress(clusterId) {
            const container = document.getElementById('testsContainer-' + clusterId);
            if (!container) return { completed: 0, total: 0, percentage: 0 };

            const tests = container.querySelectorAll('.test-card');
            const total = tests.length;
            const completed = container.querySelectorAll('.answered-badge[style*="inline-block"]').length;
            const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

            return { completed, total, percentage };
        }

        function updateClusterCard(clusterId) {
            const progress = calculateClusterProgress(clusterId);
            const card = document.querySelector(`[data-cluster-id="${clusterId}"]`);

            if (!card) return;

            const progressBadge = card.querySelector('.cluster-progress-badge');
            if (progressBadge) {
                progressBadge.textContent = `${progress.completed}/${progress.total}`;
            }

            const progressFill = card.querySelector('.cluster-progress-fill');
            if (progressFill) {
                progressFill.style.width = `${progress.percentage}%`;
            }


            const statusBadge = card.querySelector('.cluster-status-badge');
            const actionBtn = card.querySelector('.btn-cluster-action');

            if (progress.percentage === 0) {
                if (statusBadge) statusBadge.textContent = 'Non commencé';
                if (actionBtn) {
                    actionBtn.textContent = '▶ Commencer';
                    actionBtn.className = 'btn-cluster-action btn-start';
                }
                card.classList.remove('has-progress', 'completed');
            } else if (progress.percentage === 100) {
                if (statusBadge) statusBadge.textContent = '✓ Complété';
                if (actionBtn) {
                    actionBtn.textContent = '✓ Revoir les tests';
                    actionBtn.className = 'btn-cluster-action btn-review';
                }
                card.classList.remove('has-progress');
                card.classList.add('completed');
            } else {
                if (statusBadge) statusBadge.textContent = 'En cours';
                if (actionBtn) {
                    actionBtn.textContent = '→ Continuer';
                    actionBtn.className = 'btn-cluster-action btn-continue';
                }
                card.classList.add('has-progress');
                card.classList.remove('completed');
            }
        }

        function toggleClusterTests(clusterId) {
            const collapseId = 'collapse-cluster-' + clusterId;
            const collapse = document.getElementById(collapseId);

            if (!collapse) return;

            const bsCollapse = new bootstrap.Collapse(collapse, {
                toggle: true
            });
        }

        function scrollToClusterTop(clusterId) {
            const card = document.querySelector(`[data-cluster-id="${clusterId}"]`);
            if (card) {
                card.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        }
       


        const originalUpdateProgress = window.updateProgress;
        window.updateProgress = function() {
    
            if (originalUpdateProgress) {
                originalUpdateProgress();
            }

            document.querySelectorAll('[data-cluster-id]').forEach(card => {
                const clusterId = card.getAttribute('data-cluster-id');
                updateClusterCard(clusterId);
            });
        };

        window.addEventListener('load', function() {

            setTimeout(function() {
                document.querySelectorAll('[data-cluster-id]').forEach(card => {
                    const clusterId = card.getAttribute('data-cluster-id');
                    updateClusterCard(clusterId);
                });
            }, 100);
        });


    </script>

}