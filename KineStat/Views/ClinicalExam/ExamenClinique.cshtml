@{
    ViewData["Title"] = "Examen clinique";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    var patientId = ViewData["PatientId"];
    var assessmentId = ViewData["AssessmentId"];
    var folderId = ViewData["FolderId"];
    ViewData["ShowClinicalFloatingEye"] = true;
    ViewData["ShowSuspendButton"] = true;
    ViewData["Breadcrumbs"] =
        $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Anamnese'>Anamnèse</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Dossier/{folderId}/Details'>Dossier</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Socrate/{assessmentId}'>SOCRATE</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Dossier/{folderId}/RedFlags/{assessmentId}'>Red Flags</a></li>" +
        $"<li class='breadcrumb-item active'>Examen Clinique</li>";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <a asp-controller="RedFlags" asp-action="RedFlags" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-search me-2"></i>Examen clinique
                    </h1>
                </div>
                <a asp-controller="Tests" asp-action="Tests" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    Suivant<i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="row g-2 mb-2">
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-primary w-100 h-100 py-3 fw-medium" data-category="Articulaire / Structurel" style="min-height: 80px;">
                        <div style="font-size: 0.9rem;">ARTICULAIRE<br />/<br />STRUCTUREL</div>
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Myofascial" style="min-height: 80px;">
                        MYOFASCIAL
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Douleur Nociceptive" style="min-height: 80px;">
                        NOCICEPTIF
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Douleur Neuropathique" style="min-height: 80px;">
                        NEUROPATHIQUE
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Douleur Nociplastique" style="min-height: 80px;">
                        NOCIPLASTIQUE
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Controle Sensorimoteur" style="min-height: 80px;">
                        <div style="font-size: 0.9rem;">CONTRÔLE<br />SENSORIMOTEUR</div>
                    </button>
                </div>
                <div class="col-6 col-md-3 col-xl">
                    <button class="btn btn-outline-secondary w-100 h-100 py-3 fw-medium" data-category="Croyances et Cognition" style="min-height: 80px;">
                        <div style="font-size: 0.9rem;">CROYANCES<br />ET<br />COGNITION</div>
                    </button>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <button class="btn btn-outline-secondary w-100 py-3 fw-medium" data-category="Socio-environnemental" style="min-height: 80px;">
                        SOCIO-ENVIRONNEMENTAL
                    </button>
                </div>
                <div class="col-6">
                    <button class="btn btn-outline-secondary w-100 py-3 fw-medium" data-category="Emotionnel / Affectif" style="min-height: 80px;">
                        ÉMOTIONNEL / AFFECTIF
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 mb-4 mb-lg-0">
            <div id="questionnaireContainer">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="text-muted mt-3">Chargement des questions...</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow sticky-top" style="top: 20px;">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-lightbulb me-2"></i>Tests suggérés
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div id="suggestedTestsContainer" class="p-3">
                        <p class="text-muted small mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Répondez aux questions pour voir les tests recommandés
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="RedFlags" asp-action="RedFlags" asp-route-id="@patientId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <a asp-controller="Tests" asp-action="Tests" asp-route-id="@patientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium">
                    Suivant<i class="bi bi-arrow-right ms-2"></i>
                </a>
                <hr class="border-primary border-2 opacity-25 mt-3">
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/examenClinique.js"></script>
    <script>
        ExamenClinique.init(@patientId, @assessmentId);
    </script>
}
