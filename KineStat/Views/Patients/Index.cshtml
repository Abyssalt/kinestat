</div>

<style>
    .is-valid-custom {
        border-color: #28a745 !important;
        background-color: #f0fff4 !important;
    }
    
    .is-invalid-custom {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
    }
</style>

@section Scripts {
    <script>
        const STORAGE_KEY = 'patient_form_data';
        let currentPatientId = null;
        let formData = {};
        let isSaving = false;

        function validateField(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (!isRequired && !value) {
                return true;
            }

            if (isRequired && !value) {
                return false;
            }

            switch (validationType) {
                case 'text':
                    return value.length >= 2;
                
                
                case 'phone':
                    const phoneRegex = /^[\d\s\+\-\(\)]+$/;
                    const digitsOnly = value.replace(/[\s\+\-\(\)]/g, '');
                    return phoneRegex.test(value) && digitsOnly.length >= 9;
                
                case 'number':
                    const num = parseInt(value);
                    return !isNaN(num) && num > 0;
                
                case 'decimal':
                    if (!value) return true; 
                    const dec = parseFloat(value);
                    return !isNaN(dec) && dec > 0;
                
                case 'date':
                    if (!value) return false;
                    const date = new Date(value);
                    const now = new Date();
                    return date < now; 
                
                case 'select':
                    return value !== '';
                
                default:
                    return value.length > 0;
            }
        }

        function updateFieldVisualState(input) {
            const isValid = validateField(input);
            
            input.classList.remove('is-valid-custom', 'is-invalid-custom');
            
            if (input.value.trim()) {
                if (isValid) {
                    input.classList.add('is-valid-custom');
                } else {
                    input.classList.add('is-invalid-custom');
                }
            }
            
            return isValid;
        }

        function loadFromStorage() {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored) {
                formData = JSON.parse(stored);
            }
        }

        function saveToStorage() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(formData));
        }

        function clearStorage() {
            localStorage.removeItem(STORAGE_KEY);
            formData = {};
        }

        function showStatus(message, isError = false, isEditForm = false) {
            const statusDiv = isEditForm ? document.getElementById('editSaveStatus') : document.getElementById('saveStatus');
            statusDiv.className = isError ? 'alert alert-danger' : 'alert alert-success';
            statusDiv.textContent = message;
            statusDiv.style.display = 'block';
            
            setTimeout(() => {
                statusDiv.style.display = 'none';
            }, 3000);
        }

        function areRequiredFieldsFilled() {
            const required = ['LastName', 'FirstName', 'Email', 'PhoneNumber', 'Genre', 'BirthDate', 'SocialSecurityNumber', 'PhysioId'];
            for (let field of required) {
                const value = formData[field];
                
                if (!value || value === '' || value === 'undefined' || value === 'null') {
                    return false;
                }
                
                if (field === 'PhysioId' || field === 'SocialSecurityNumber') {
                    const numValue = parseInt(value);
                    if (isNaN(numValue) || numValue === 0) {
                        return false;
                    }
                }
            }
            return true;
        }

        async function trySavePatient() {
            if (!areRequiredFieldsFilled() || currentPatientId || isSaving) {
                return;
            }

            isSaving = true;

            try {
                const payload = {
                    lastName: formData.LastName,
                    firstName: formData.FirstName,
                    email: formData.Email,
                    phoneNumber: formData.PhoneNumber,
                    address: formData.Address || '',
                    genre: parseInt(formData.Genre) || 0,
                    birthDate: formData.BirthDate,
                    socialSecurityNumber: parseInt(formData.SocialSecurityNumber) || 0,
                    physioId: parseInt(formData.PhysioId) || 0,
                    weight: parseFloat(formData.Weight) || 0,
                    height: parseFloat(formData.Height) || 0,
                    doctorName: formData.DoctorName || '',
                    doctorINAMI: formData.DoctorINAMI || ''
                };

                const response = await fetch('/Patients/AutoSavePatient', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success && result.isComplete) {
                    currentPatientId = result.patientId;
                    document.getElementById('add_PatientId').value = currentPatientId;
                    showStatus(`Patient créé avec succès`);
                    clearStorage();
                }
            } catch (error) {
                showStatus(`Erreur: ${error.message}`, true);
            } finally {
                isSaving = false;
            }
        }

        async function autoSaveField(input) {
            const isValid = updateFieldVisualState(input);
            
            if (!isValid) {
                return;
            }

            const fieldName = input.dataset.field;
            const fieldValue = input.value;

            formData[fieldName] = fieldValue;
            saveToStorage();

            await trySavePatient();
        }

        async function autoSaveEditField(input) {
            const isValid = updateFieldVisualState(input);
            
            if (!isValid || isSaving) {
                return;
            }

            const patientId = document.getElementById('edit_Id').value;
            const fieldName = input.dataset.field;
            const fieldValue = input.value;

            if (input.hasAttribute('required') && !fieldValue) {
                return;
            }

            isSaving = true;

            try {
                const response = await fetch('/Patients/AutoSaveField', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        patientId: parseInt(patientId),
                        fieldName: fieldName,
                        fieldValue: fieldValue
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showStatus(`${fieldName} modifié`, false, true);
                } else {
                    showStatus(`Erreur: ${result.message}`, true, true);
                }
            } catch (error) {
                showStatus(`Erreur: ${error.message}`, true, true);
            } finally {
                isSaving = false;
            }
        }

        function restoreFormData() {
            if (Object.keys(formData).length > 0) {
                for (let [field, value] of Object.entries(formData)) {
                    const input = document.querySelector(`.auto-save-field[data-field="${field}"]`);
                    if (input && value) {
                        input.value = value;
                        updateFieldVisualState(input);
                    }
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadFromStorage();
            
            document.querySelectorAll('.auto-save-field').forEach(input => {
                input.addEventListener('blur', function() {
                    autoSaveField(this);
                });

                input.addEventListener('change', function() {
                    autoSaveField(this);
                });

                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                });
            });

            document.querySelectorAll('.auto-save-edit-field').forEach(input => {
                input.addEventListener('blur', function() {
                    autoSaveEditField(this);
                });

                input.addEventListener('change', function() {
                    autoSaveEditField(this);
                });

                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                });
            });
        });

        document.getElementById('addPatientModal').addEventListener('shown.bs.modal', function() {
            restoreFormData();
        });

        document.getElementById('addPatientModal').addEventListener('hidden.bs.modal', function() {
            const hadPatientId = currentPatientId !== null;
            
            if (hadPatientId) {
                currentPatientId = null;
                clearStorage();
                document.getElementById('addPatientForm').reset();
                document.getElementById('add_PatientId').value = '';
                location.reload();
            }
        });

        document.getElementById('editPatientModal').addEventListener('hidden.bs.modal', function() {
            location.reload();
        });

        document.getElementById('searchInput').addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#patientsTable tbody tr');

            tableRows.forEach(function(row) {
                const nom = row.cells[0].textContent.toLowerCase();
                const prenom = row.cells[1].textContent.toLowerCase();

                if (nom.includes(searchValue) || prenom.includes(searchValue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        function editPatient(id, lastName, firstName, email, phoneNumber, genre, birthDate, socialSecurityNumber, physioId, weight, height, doctorName, doctorINAMI, address) {
            document.getElementById('edit_Id').value = id;
            document.getElementById('edit_LastName').value = lastName;
            document.getElementById('edit_FirstName').value = firstName;
            document.getElementById('edit_Email').value = email;
            document.getElementById('edit_PhoneNumber').value = phoneNumber;
            document.getElementById('edit_Address').value = address || '';
            document.getElementById('edit_Genre').value = genre;
            document.getElementById('edit_BirthDate').value = birthDate;
            document.getElementById('edit_SocialSecurityNumber').value = socialSecurityNumber;
            document.getElementById('edit_PhysioId').value = physioId;
            document.getElementById('edit_Weight').value = weight;
            document.getElementById('edit_Height').value = height;
            document.getElementById('edit_DoctorName').value = doctorName || '';
            document.getElementById('edit_DoctorINAMI').value = doctorINAMI || '';

            const editModal = new bootstrap.Modal(document.getElementById('editPatientModal'));
            editModal.show();
        }
    </script>
}
