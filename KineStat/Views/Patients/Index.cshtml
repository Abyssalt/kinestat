@model IEnumerable<KineStat.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item active' aria-current='page'>Patients</li>";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patients</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPatientModal">
            <i class="bi bi-plus-circle"></i> Nouveau patient
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-8">
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Rechercher un patient par nom ou prénom..."
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="Tous">Tous les statuts</option>
                        <option value="Actif">Actif</option>
                        <option value="Terminé">Terminé</option>
                        <option value="Suspendu">Suspendu</option>
                        <option value="Abandonné">Abandonné</option>
                    </select>
                </div>
            </div>

            <div id="loadingIndicator" class="alert alert-info" style="display:none;">
                <i class="bi bi-hourglass-split"></i> Chargement en cours...
            </div>

            <div id="noResultsMessage" class="alert alert-warning" style="display:none;">
                Aucun patient ne correspond à votre recherche.
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="patientsTable">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Email</th>
                                <th>Genre</th>
                                <th>Statut</th>
                                <th>Date de naissance</th>
                                <th>Téléphone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="patientsTableBody">
                            @foreach (Patient patient in Model)
                            {
                                <tr>
                                    <td>@patient.LastName</td>
                                    <td>@patient.FirstName</td>
                                    <td>
                                        <a href="mailto:@patient.Email" class="text-decoration-none">
                                            @patient.Email
                                        </a>
                                    </td>
                                    <td>
                                        @switch (patient.Gender)
                                        {
                                            case Gender.Homme:
                                                <span class="badge bg-primary">H</span>
                                                break;
                                            case Gender.Femme:
                                                <span class="badge bg-danger">F</span>
                                                break;
                                            case Gender.Autre:
                                                <span class="badge bg-secondary">A</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @switch (patient.Status)
                                        {
                                            case PatientStatus.Actif:
                                                <span class="badge bg-success">Actif</span>
                                                break;
                                            case PatientStatus.Terminé:
                                                <span class="badge bg-secondary">Terminé</span>
                                                break;
                                            case PatientStatus.Suspendu:
                                                <span class="badge bg-warning">Suspendu</span>
                                                break;
                                            case PatientStatus.Abandonné:
                                                <span class="badge bg-danger">Abandonné</span>
                                                break;
                                        }
                                    </td>
                                    <td>@patient.BirthDate.ToString("dd/MM/yyyy")</td>
                                    <td>@patient.PhoneNumber</td>
                                    <td>
                                        <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@patient.Id" class="btn btn-sm btn-info" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-controller="Patients" asp-action="Delete" asp-route-id="@patient.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer ce patient ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Page navigation" id="paginationContainer">
                    <ul class="pagination justify-content-center" id="paginationControls">
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="addPatientModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nouveau patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addPatientForm" asp-controller="Patients" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nom *</label>
                            <input type="text" class="form-control cache-field" name="LastName" data-field="LastName" data-validation="text" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prénom *</label>
                            <input type="text" class="form-control cache-field" name="FirstName" data-field="FirstName" data-validation="text" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control cache-field" name="Email" data-field="Email" data-validation="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control cache-field" name="PhoneNumber" data-field="PhoneNumber" data-validation="phone" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse du patient</label>
                        <input type="text" class="form-control cache-field" id="edit_Address" data-field="Address" name="Address">
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Genre *</label>
                            <select class="form-select cache-field" name="Genre" data-field="Genre" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control cache-field" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">N° Sécurité sociale *</label>
                            <input type="text" class="form-control cache-field" 
                                   name="SocialSecurityNumber" 
                                   data-field="SocialSecurityNumber"
                                   data-validation="SocialSecNumber" 
                                   placeholder="XX.XX.XX-XXX.XX" 
                                   required>                        
                         </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Poids (kg)</label>
                            <input type="number" class="form-control cache-field" name="Weight" data-field="Weight" data-validation="decimal" min="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taille (cm)</label>
                            <input type="number" class="form-control cache-field" name="Height" data-field="Height" data-validation="decimal" min="0">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nom du médecin</label>
                            <input type="text" class="form-control cache-field" name="DoctorName" data-field="DoctorName">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">N° INAMI du médecin</label>
                            <input type="text" class="form-control cache-field" name="DoctorINAMI" data-field="DoctorINAMI">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kinésithérapeute *</label>
                        <select class="form-select cache-field" name="PhysioId" data-field="PhysioId" data-validation="select" required>
                            <option value="">-- Sélectionner --</option>
                            @foreach (var physio in ViewBag.Physios)
                            {
                                <option value="@physio.Id">@physio.FirstName @physio.LastName</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-secondary" id="createPatientBtn" disabled>
                    <i class="bi bi-check-circle"></i> Créer le patient
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .is-valid-custom {
            border-color: #198754 !important;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        .is-invalid-custom {
            border-color: #dc3545 !important;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>

    <script>
        const ADD_STORAGE_KEY = 'addPatientFormData';
        
        let addFormData = {};

        function updateFieldVisualState(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();
            
            if (value === '') {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
                return;
            }

            const isValid = validateField(input);

            if (isValid) {
                input.classList.remove('is-invalid-custom');
                input.classList.add('is-valid-custom');
            } else {
                input.classList.remove('is-valid-custom');
                input.classList.add('is-invalid-custom');
            }
        }

        function validateField(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();

            if (!validationType) return true;

            switch (validationType) {
                case 'text':
                    return value.length >= 2;

                case 'email':
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    return emailRegex.test(value);

                case 'phone':
                    const phoneClean = value.replace(/[\s\-\(\)\.]/g, '');
                    return phoneClean.length >= 9;

                case 'decimal':
                    if (!value) return true;
                    const dec = parseFloat(value);
                    return !isNaN(dec) && dec > 0;

                case 'date':
                    if (!value) return false;
                    const date = new Date(value);
                    const now = new Date();
                    return date < now;

                case 'select':
                    return value !== '';

                case 'SocialSecNumber':
                    if (!value) return false;
                    const nissClean = value.replace(/[\s\.\-]/g, '');
                    if (!/^\d{11}$/.test(nissClean)) return false;

                    const year = parseInt(nissClean.substring(0, 2));
                    const month = parseInt(nissClean.substring(2, 4));
                    const day = parseInt(nissClean.substring(4, 6));
                    const checkDigits = parseInt(nissClean.substring(9, 11));

                    const validMonths = (month >= 1 && month <= 12) ||
                                      (month >= 21 && month <= 32) ||
                                      (month >= 41 && month <= 52) ||
                                      (month >= 61 && month <= 72);
                    if (!validMonths) return false;
                    if (day < 1 || day > 31) return false;

                    let baseNumber = parseInt(nissClean.substring(0, 9));
                    let calculatedCheck = 97 - (baseNumber % 97);

                    if (calculatedCheck !== checkDigits) {
                        baseNumber = parseInt('2' + nissClean.substring(0, 9));
                        calculatedCheck = 97 - (baseNumber % 97);
                    }

                    return calculatedCheck === checkDigits;

                default:
                    return value.length > 0;
            }
        }

        function loadFromStorage(storageKey) {
            const stored = localStorage.getItem(storageKey);
            if (stored) {
                try {
                    return JSON.parse(stored);
                } catch (e) {
                    console.error('Error parsing localStorage:', e);
                    return {};
                }
            }
            return {};
        }

        function saveToStorage(storageKey, data) {
            try {
                localStorage.setItem(storageKey, JSON.stringify(data));
            } catch (e) {
                console.error('Error saving to localStorage:', e);
            }
        }

        function clearStorage(storageKey) {
            localStorage.removeItem(storageKey);
        }

        function areAddRequiredFieldsFilled() {
            const required = ['LastName', 'FirstName', 'Email', 'PhoneNumber', 'Genre', 'BirthDate', 'SocialSecurityNumber', 'PhysioId'];
            
            for (let field of required) {
                const input = document.querySelector(`.cache-field[data-field="${field}"]`);
                
                if (!input) continue;
                
                const value = input.value.trim();
                
                if (!value || value === '') {
                    return false;
                }
                
                if (!validateField(input)) {
                    return false;
                }
            }
            
            return true;
        }

        function updateCreateButton() {
            const btn = document.getElementById('createPatientBtn');
            const allValid = areAddRequiredFieldsFilled();
            
            if (allValid) {
                btn.disabled = false;
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-primary');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-secondary');
            }
        }

        function saveAddField(input) {
            updateFieldVisualState(input);
            const fieldName = input.dataset.field;
            const fieldValue = input.value;

            addFormData[fieldName] = fieldValue;
            
            saveToStorage(ADD_STORAGE_KEY, addFormData);

            updateCreateButton();
        }

        function restoreAddFormData() {
            const cached = loadFromStorage(ADD_STORAGE_KEY);
            
            if (Object.keys(cached).length > 0) {
                addFormData = cached;
                
                for (let [field, value] of Object.entries(cached)) {
                    const input = document.querySelector(`.cache-field[data-field="${field}"]`);
                    if (input && value !== null && value !== undefined && value !== '') {
                        input.value = value;
                        updateFieldVisualState(input);
                    }
                }
                
                updateCreateButton();
            }
        }

        let currentPage = 1;
        let currentSearch = '';
        let currentStatus = 'Tous';
        const pageSize = 5;
        let searchTimeout = null;

        function performSearch() {
            const searchValue = document.getElementById('searchInput').value;
            const statusValue = document.getElementById('statusFilter').value;

            currentSearch = searchValue;
            currentStatus = statusValue;
            currentPage = 1;

            if (currentSearch.trim() === '') {
                const tableBody = document.getElementById('patientsTableBody');
                const paginationContainer = document.getElementById('paginationContainer');
                const noResultsMessage = document.getElementById('noResultsMessage');

                if (tableBody) tableBody.innerHTML = '';
                if (paginationContainer) paginationContainer.style.display = 'none';
                noResultsMessage.style.display = 'none';
                return;
            }

            loadPatients();
        }

        function loadPatients() {
            const loadingIndicator = document.getElementById('loadingIndicator');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const tableBody = document.getElementById('patientsTableBody');
            const paginationContainer = document.getElementById('paginationContainer');
            
            loadingIndicator.style.display = 'block';
            noResultsMessage.style.display = 'none';
            if (tableBody) tableBody.style.opacity = '0.5';
            
            const params = new URLSearchParams({
                search: currentSearch,
                status: currentStatus,
                page: currentPage,
                pageSize: pageSize
            });
            
            fetch(`/Patients/SearchPatients?${params.toString()}`)
                .then(response => response.json())
                .then(data => {
                    loadingIndicator.style.display = 'none';
                    if (tableBody) tableBody.style.opacity = '1';
                    
                    if (data.patients.length === 0) {
                        noResultsMessage.style.display = 'block';
                        if (tableBody) {
                            tableBody.innerHTML = '';
                        }
                        if (paginationContainer) {
                            paginationContainer.style.display = 'none';
                        }
                    } else {
                        noResultsMessage.style.display = 'none';
                        updateTable(data.patients);
                        updatePagination(data.currentPage, data.totalPages);
                        if (paginationContainer) {
                            paginationContainer.style.display = 'block';
                        }
                    }
                })
                .catch(error => {
                    console.error('Erreur lors de la recherche:', error);
                    loadingIndicator.style.display = 'none';
                    if (tableBody) tableBody.style.opacity = '1';
                    alert('Une erreur est survenue lors de la recherche.');
                });
        }

        function updateTable(patients) {
            const tbody = document.getElementById('patientsTableBody');
            if (!tbody) return;
            
            tbody.innerHTML = '';
            
            patients.forEach(patient => {
                const row = document.createElement('tr');
                
                let genderBadge = '';
                switch(patient.gender) {
                    case 0: genderBadge = '<span class="badge bg-primary">H</span>'; break;
                    case 1: genderBadge = '<span class="badge bg-danger">F</span>'; break;
                    case 2: genderBadge = '<span class="badge bg-secondary">A</span>'; break;
                }
                
                let statusBadge = '';
                switch(patient.status) {
                    case 0: statusBadge = '<span class="badge bg-success">Actif</span>'; break;
                    case 1: statusBadge = '<span class="badge bg-secondary">Terminé</span>'; break;
                    case 2: statusBadge = '<span class="badge bg-warning">Suspendu</span>'; break;
                    case 3: statusBadge = '<span class="badge bg-danger">Abandonné</span>'; break;
                }
                
                const birthDate = new Date(patient.birthDate);
                const formattedDate = `${birthDate.getDate().toString().padStart(2, '0')}/${(birthDate.getMonth() + 1).toString().padStart(2, '0')}/${birthDate.getFullYear()}`;
                
                row.innerHTML = `
                    <td>${patient.lastName}</td>
                    <td>${patient.firstName}</td>
                    <td><a href="mailto:${patient.email}" class="text-decoration-none">${patient.email}</a></td>
                    <td>${genderBadge}</td>
                    <td>${statusBadge}</td>
                    <td>${formattedDate}</td>
                    <td>${patient.phoneNumber}</td>
                    <td>
                        <a href="/Patient/${patient.id}/Anamnese/" class="btn btn-sm btn-info" title="Voir">
                            <i class="bi bi-eye"></i>
                        </a>
                        <form action="/Patients/${patient.id}/Delete" method="post" style="display:inline;">
                            <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]').value}">
                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer ce patient ?');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                `;
                
                tbody.appendChild(row);
            });
        }

        function updatePagination(current, total) {
            const paginationControls = document.getElementById('paginationControls');
            if (!paginationControls) return;
            
            paginationControls.innerHTML = '';
            
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${current === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<a class="page-link" href="#" data-page="${current - 1}">Précédent</a>`;
            paginationControls.appendChild(prevLi);
            
            for (let i = 1; i <= total; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${i === current ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
                paginationControls.appendChild(li);
            }
            
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${current === total ? 'disabled' : ''}`;
            nextLi.innerHTML = `<a class="page-link" href="#" data-page="${current + 1}">Suivant</a>`;
            paginationControls.appendChild(nextLi);
            
            paginationControls.querySelectorAll('a.page-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (!this.parentElement.classList.contains('disabled') && 
                        !this.parentElement.classList.contains('active')) {
                        currentPage = parseInt(this.dataset.page);
                        loadPatients();
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.cache-field').forEach(input => {
                input.addEventListener('input', function() {
                    saveAddField(this);
                });

                input.addEventListener('blur', function() {
                    saveAddField(this);
                });

                input.addEventListener('change', function() {
                    saveAddField(this);
                });
            });

            document.getElementById('createPatientBtn').addEventListener('click', function() {
                if (areAddRequiredFieldsFilled()) {
                    clearStorage(ADD_STORAGE_KEY);
                    addFormData = {};
                    document.getElementById('addPatientForm').submit();
                }
            });

            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(performSearch, 300);
                });
            }
            
            if (statusFilter) {
                statusFilter.addEventListener('change', performSearch);
            }
            
            performSearch();
        });

        document.getElementById('addPatientModal').addEventListener('shown.bs.modal', function() {
            restoreAddFormData();
        });

        document.getElementById('addPatientModal').addEventListener('hidden.bs.modal', function() {
            document.querySelectorAll('.cache-field').forEach(input => {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
            });
        });
    </script>
}
