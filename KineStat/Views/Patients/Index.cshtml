                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control auto-save-edit-field" id="edit_BirthDate" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">N° Sécurité sociale *</label>
                            <input type="number" class="form-control auto-save-edit-field" id="edit_SocialSecurityNumber" name="SocialSecurityNumber" data-field="SocialSecurityNumber" data-validation="number" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Kinésithérapeute *</label>
                            <select class="form-select auto-save-edit-field" id="edit_PhysioId" name="PhysioId" data-field="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control auto-save-edit-field" id="edit_Weight" name="Weight" data-field="Weight" data-validation="decimal">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control auto-save-edit-field" id="edit_Height" name="Height" data-field="Height" data-validation="decimal">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Médecin traitant</label>
                            <input type="text" class="form-control auto-save-edit-field" id="edit_DoctorName" name="DoctorName" data-field="DoctorName" data-validation="text">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">N° INAMI du médecin</label>
                            <input type="text" class="form-control auto-save-edit-field" id="edit_DoctorINAMI" name="DoctorINAMI" data-field="DoctorINAMI" data-validation="text">
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Les modifications se sauvegardent automatiquement à chaque changement de champ.
                    </div>
                    <div id="editSaveStatus" class="alert" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
