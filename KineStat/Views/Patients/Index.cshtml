@model IEnumerable<KineStat.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item active' aria-current='page'>Patients</li>";
}

<!-- Success/error messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patients</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPatientModal">
            <i class="bi bi-plus-circle"></i> Nouveau patient
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher un patient par nom ou prénom...">
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="patientsTable">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Genre</th>
                                <th>Date de naissance</th>
                                <th>Téléphone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Patient patient in Model)
                            {
                                <tr>
                                    <td>@patient.LastName</td>
                                    <td>@patient.FirstName</td>
                                    <td>
                                        @switch (patient.Genre)
                                        {
                                            case Gender.Homme:
                                                <span class="badge bg-primary">H</span>
                                                break;
                                            case Gender.Femme:
                                                <span class="badge bg-danger">F</span>
                                                break;
                                            case Gender.Autre:
                                                <span class="badge bg-secondary">A</span>
                                                break;
                                        }
                                    </td>
                                    <td>@patient.BirthDate.ToString("dd/MM/yyyy")</td>
                                    <td>@patient.PhoneNumber</td>
                                    <td>
                                        <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@patient.Id" class="btn btn-sm btn-info" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-warning" title="Modifier"
                                                onclick="editPatient(@patient.Id, '@patient.LastName', '@patient.FirstName', '@patient.Email', '@patient.PhoneNumber', @((int)patient.Genre), '@patient.BirthDate.ToString("yyyy-MM-dd")', @patient.SocialSecurityNumber, @patient.PhysioId, @(patient.Weight.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), @(patient.Height.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), '@(patient.DoctorName ?? "")', '@(patient.DoctorINAMI ?? "")', '@(patient.Address ?? "")')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-controller="Patients" asp-action="Delete" asp-route-id="@patient.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer ce patient ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Aucun patient enregistré pour le moment. Cliquez sur "Nouveau patient" pour ajouter votre premier patient.
                </div>
            }
        </div>
    </div>
</div>

<!-- Add a patient modal -->
<div class="modal fade" id="addPatientModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nouveau patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addPatientForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="add_PatientId" value="">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nom *</label>
                            <input type="text" class="form-control auto-save-field" name="LastName" data-field="LastName" data-validation="text" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prénom *</label>
                            <input type="text" class="form-control auto-save-field" name="FirstName" data-field="FirstName" data-validation="text" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control auto-save-field" name="Email" data-field="Email" data-validation="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control auto-save-field" name="PhoneNumber" data-field="PhoneNumber" data-validation="phone" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse du patient</label>
                        <textarea class="form-control auto-save-field" name="Address" data-field="Address" data-validation="text" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Genre *</label>
                            <select class="form-select auto-save-field" name="Genre" data-field="Genre" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control auto-save-field" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">N° Sécurité sociale *</label>
                            <input type="number" class="form-control auto-save-field" name="SocialSecurityNumber" data-field="SocialSecurityNumber" data-validation="number" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Kinésithérapeute *</label>
                            <select class="form-select auto-save-field" name="PhysioId" data-field="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control auto-save-field" name="Weight" data-field="Weight" data-validation="decimal">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control auto-save-field" name="Height" data-field="Height" data-validation="decimal">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Médecin traitant</label>
                            <input type="text" class="form-control auto-save-field" name="DoctorName" data-field="DoctorName" data-validation="text">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">N° INAMI du médecin</label>
                            <input type="text" class="form-control auto-save-field" name="DoctorINAMI" data-field="DoctorINAMI" data-validation="text">
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Les champs se sauvegardent automatiquement. Le patient sera créé quand tous les champs obligatoires (*) sont correctement remplis.
                    </div>
                    <div id="saveStatus" class="alert" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit patient modal -->
