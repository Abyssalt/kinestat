@model IEnumerable<KineStat.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item active' aria-current='page'>Patients</li>";
}

<!-- Success/error messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patients</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPatientModal">
            <i class="bi bi-plus-circle"></i> Nouveau patient
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher un patient par nom ou prénom...">
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="patientsTable">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Genre</th>
                                <th>Date de naissance</th>
                                <th>Téléphone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Patient patient in Model)
                            {
                                <tr>
                                    <td>@patient.LastName</td>
                                    <td>@patient.FirstName</td>
                                    <td>
                                        @switch (patient.Genre)
                                        {
                                            case Gender.Homme:
                                                <span class="badge bg-primary">H</span>
                                                break;
                                            case Gender.Femme:
                                                <span class="badge bg-danger">F</span>
                                                break;
                                            case Gender.Autre:
                                                <span class="badge bg-secondary">A</span>
                                                break;
                                        }
                                    </td>
                                    <td>@patient.BirthDate.ToString("dd/MM/yyyy")</td>
                                    <td>@patient.PhoneNumber</td>
                                    <td>
                                        <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@patient.Id" class="btn btn-sm btn-info" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-warning" title="Modifier"
                                                onclick="editPatient(@patient.Id, '@patient.LastName', '@patient.FirstName', '@patient.Email', '@patient.PhoneNumber', @((int)patient.Genre), '@patient.BirthDate.ToString("yyyy-MM-dd")', @patient.SocialSecurityNumber, @patient.PhysioId, @(patient.Weight.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), @(patient.Height.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), '@(patient.DoctorName ?? "")', '@(patient.DoctorINAMI ?? "")', '@(patient.Address ?? "")')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-controller="Patients" asp-action="Delete" asp-route-id="@patient.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer ce patient ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Aucun patient enregistré pour le moment. Cliquez sur "Nouveau patient" pour ajouter votre premier patient.
                </div>
            }
        </div>
    </div>
</div>

<!-- Add a patient modal -->
<div class="modal fade" id="addPatientModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nouveau patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addPatientForm" asp-controller="Patients" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nom *</label>
                            <input type="text" class="form-control cache-field" name="LastName" data-field="LastName" data-validation="text" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prénom *</label>
                            <input type="text" class="form-control cache-field" name="FirstName" data-field="FirstName" data-validation="text" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control cache-field" name="Email" data-field="Email" data-validation="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control cache-field" name="PhoneNumber" data-field="PhoneNumber" data-validation="phone" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse du patient</label>
                        <textarea class="form-control cache-field" name="Address" data-field="Address" data-validation="text" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Genre *</label>
                            <select class="form-select cache-field" name="Genre" data-field="Genre" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control cache-field" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">N° Sécurité sociale *</label>
                            <input type="number" class="form-control cache-field" name="SocialSecurityNumber" data-field="SocialSecurityNumber" data-validation="number" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Kinésithérapeute *</label>
                            <select class="form-select cache-field" name="PhysioId" data-field="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control cache-field" name="Weight" data-field="Weight" data-validation="decimal">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control cache-field" name="Height" data-field="Height" data-validation="decimal">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Médecin traitant</label>
                            <input type="text" class="form-control cache-field" name="DoctorName" data-field="DoctorName" data-validation="text">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">N° INAMI du médecin</label>
                            <input type="text" class="form-control cache-field" name="DoctorINAMI" data-field="DoctorINAMI" data-validation="text">
                        </div>
                    </div>
                    <div id="saveStatus" class="alert" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="createPatientBtn" class="btn btn-primary" disabled>
                    <i class="bi bi-save"></i> Créer le patient
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit patient modal -->
<div class="modal fade" id="editPatientModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modifier patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editPatientForm" asp-controller="Patients" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit_Id" name="Id">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nom *</label>
                            <input type="text" class="form-control cache-edit-field" id="edit_LastName" name="LastName" data-field="LastName" data-validation="text" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prénom *</label>
                            <input type="text" class="form-control cache-edit-field" id="edit_FirstName" name="FirstName" data-field="FirstName" data-validation="text" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control cache-edit-field" id="edit_Email" name="Email" data-field="Email" data-validation="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control cache-edit-field" id="edit_PhoneNumber" name="PhoneNumber" data-field="PhoneNumber" data-validation="phone" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse du patient</label>
                        <textarea class="form-control cache-edit-field" id="edit_Address" name="Address" data-field="Address" data-validation="text" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Genre *</label>
                            <select class="form-select cache-edit-field" id="edit_Genre" name="Genre" data-field="Genre" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control cache-edit-field" id="edit_BirthDate" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">N° Sécurité sociale *</label>
                            <input type="number" class="form-control cache-edit-field" id="edit_SocialSecurityNumber" name="SocialSecurityNumber" data-field="SocialSecurityNumber" data-validation="number" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Kinésithérapeute *</label>
                            <select class="form-select cache-edit-field" id="edit_PhysioId" name="PhysioId" data-field="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control cache-edit-field" id="edit_Weight" name="Weight" data-field="Weight" data-validation="decimal">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control cache-edit-field" id="edit_Height" name="Height" data-field="Height" data-validation="decimal">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Médecin traitant</label>
                            <input type="text" class="form-control cache-edit-field" id="edit_DoctorName" name="DoctorName" data-field="DoctorName" data-validation="text">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">N° INAMI du médecin</label>
                            <input type="text" class="form-control cache-edit-field" id="edit_DoctorINAMI" name="DoctorINAMI" data-field="DoctorINAMI" data-validation="text">
                        </div>
                    </div>
                    <div id="editSaveStatus" class="alert" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-warning" disabled>
                    <i class="bi bi-save"></i> Enregistrer les modifications
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .is-valid-custom {
        border-color: #28a745 !important;
        background-color: #f0fff4 !important;
    }

    .is-invalid-custom {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
    }
</style>

@section Scripts {
    <script>
        const ADD_STORAGE_KEY = 'patient_add_form_data';
        const EDIT_STORAGE_KEY = 'patient_edit_form_data';
        let addFormData = {};
        let editFormData = {};

        // ========== VALIDATION ==========
        function validateField(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (!isRequired && !value) {
                return true;
            }

            if (isRequired && !value) {
                return false;
            }

            switch (validationType) {
                case 'text':
                    return value.length >= 1;

                case 'email':
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    return emailRegex.test(value);

                case 'phone':
                    const phoneRegex = /^[\d\s\+\-\(\)]+$/;
                    const digitsOnly = value.replace(/[\s\+\-\(\)]/g, '');
                    return phoneRegex.test(value) && digitsOnly.length >= 9;

                case 'number':
                    const num = parseInt(value);
                    return !isNaN(num) && num > 0;

                case 'decimal':
                    if (!value) return true;
                    const dec = parseFloat(value);
                    return !isNaN(dec) && dec > 0;

                case 'date':
                    if (!value) return false;
                    const date = new Date(value);
                    const now = new Date();
                    return date < now;

                case 'select':
                    return value !== '';

                default:
                    return value.length > 0;
            }
        }

        function updateFieldVisualState(input) {
            const isValid = validateField(input);

            input.classList.remove('is-valid-custom', 'is-invalid-custom');

            if (input.value.trim()) {
                if (isValid) {
                    input.classList.add('is-valid-custom');
                } else {
                    input.classList.add('is-invalid-custom');
                }
            }

            return isValid;
        }

        // ========== CACHE MANAGEMENT ==========
        function loadFromStorage(storageKey) {
            const stored = localStorage.getItem(storageKey);
            if (stored) {
                return JSON.parse(stored);
            }
            return {};
        }

        function saveToStorage(storageKey, data) {
            localStorage.setItem(storageKey, JSON.stringify(data));
        }

        function clearStorage(storageKey) {
            localStorage.removeItem(storageKey);
        }

        // ========== ADD FORM ==========
        function areAddRequiredFieldsFilled() {
            const required = ['LastName', 'FirstName', 'Email', 'PhoneNumber', 'Genre', 'BirthDate', 'SocialSecurityNumber', 'PhysioId'];
            for (let field of required) {
                const value = addFormData[field];

                if (!value || value === '' || value === 'undefined' || value === 'null') {
                    return false;
                }

                if (field === 'PhysioId' || field === 'SocialSecurityNumber') {
                    const numValue = parseInt(value);
                    if (isNaN(numValue) || numValue === 0) {
                        return false;
                    }
                }
            }
            return true;
        }

        function updateCreateButton() {
            const btn = document.getElementById('createPatientBtn');
            if (areAddRequiredFieldsFilled()) {
                btn.disabled = false;
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-primary');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-secondary');
            }
        }

        function saveAddField(input) {
            const isValid = updateFieldVisualState(input);
            const fieldName = input.dataset.field;
            const fieldValue = input.value;

            addFormData[fieldName] = fieldValue;
            saveToStorage(ADD_STORAGE_KEY, addFormData);

            updateCreateButton();
        }

        function restoreAddFormData() {
            addFormData = loadFromStorage(ADD_STORAGE_KEY);
            if (Object.keys(addFormData).length > 0) {
                for (let [field, value] of Object.entries(addFormData)) {
                    const input = document.querySelector(`.cache-field[data-field="${field}"]`);
                    if (input && value) {
                        input.value = value;
                        updateFieldVisualState(input);
                    }
                }
            }
            updateCreateButton();
        }

        // ========== EDIT FORM ==========
        function areEditRequiredFieldsFilled() {
            const required = ['LastName', 'FirstName', 'Email', 'PhoneNumber', 'Genre', 'BirthDate', 'SocialSecurityNumber', 'PhysioId'];
            for (let field of required) {
                const value = editFormData[field];

                if (!value || value === '' || value === 'undefined' || value === 'null') {
                    return false;
                }

                if (field === 'PhysioId' || field === 'SocialSecurityNumber') {
                    const numValue = parseInt(value);
                    if (isNaN(numValue) || numValue === 0) {
                        return false;
                    }
                }
            }
            return true;
        }

        function updateEditButton() {
            const btn = document.getElementById('saveEditBtn');
            if (areEditRequiredFieldsFilled()) {
                btn.disabled = false;
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-warning');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-secondary');
            }
        }

        function saveEditField(input) {
            const isValid = updateFieldVisualState(input);
            const fieldName = input.dataset.field;
            const fieldValue = input.value;

            editFormData[fieldName] = fieldValue;
            saveToStorage(EDIT_STORAGE_KEY, editFormData);

            updateEditButton();
        }

        function restoreEditFormData() {
            editFormData = loadFromStorage(EDIT_STORAGE_KEY);
            if (Object.keys(editFormData).length > 0) {
                for (let [field, value] of Object.entries(editFormData)) {
                    const input = document.querySelector(`.cache-edit-field[data-field="${field}"]`);
                    if (input && value) {
                        input.value = value;
                        updateFieldVisualState(input);
                    }
                }
            }
            updateEditButton();
        }

        // ========== EVENT LISTENERS ==========
        document.addEventListener('DOMContentLoaded', function() {
            // Add form fields
            document.querySelectorAll('.cache-field').forEach(input => {
                input.addEventListener('blur', function() {
                    saveAddField(this);
                });

                input.addEventListener('change', function() {
                    saveAddField(this);
                });

                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                });
            });

            // Edit form fields
            document.querySelectorAll('.cache-edit-field').forEach(input => {
                input.addEventListener('blur', function() {
                    saveEditField(this);
                });

                input.addEventListener('change', function() {
                    saveEditField(this);
                });

                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                });
            });

            // Create patient button
            document.getElementById('createPatientBtn').addEventListener('click', function() {
                if (areAddRequiredFieldsFilled()) {
                    clearStorage(ADD_STORAGE_KEY);
                    addFormData = {};
                    document.getElementById('addPatientForm').submit();
                }
            });

            // Save edit button
            document.getElementById('saveEditBtn').addEventListener('click', function() {
                if (areEditRequiredFieldsFilled()) {
                    clearStorage(EDIT_STORAGE_KEY);
                    editFormData = {};
                    document.getElementById('editPatientForm').submit();
                }
            });
        });

        // ========== MODAL EVENTS ==========
        document.getElementById('addPatientModal').addEventListener('shown.bs.modal', function() {
            restoreAddFormData();
        });

        document.getElementById('addPatientModal').addEventListener('hidden.bs.modal', function() {
            // Clear form and cache when closing modal
            addFormData = {};
            clearStorage(ADD_STORAGE_KEY);
            document.getElementById('addPatientForm').reset();
            updateCreateButton();
        });

        document.getElementById('editPatientModal').addEventListener('shown.bs.modal', function() {
            // Load current form values into cache
            document.querySelectorAll('.cache-edit-field').forEach(input => {
                const fieldName = input.dataset.field;
                editFormData[fieldName] = input.value;
            });
            saveToStorage(EDIT_STORAGE_KEY, editFormData);
            updateEditButton();
        });

        document.getElementById('editPatientModal').addEventListener('hidden.bs.modal', function() {
            // Clear edit cache when closing
            editFormData = {};
            clearStorage(EDIT_STORAGE_KEY);
        });

        // ========== SEARCH ==========
        document.getElementById('searchInput').addEventListener('input', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#patientsTable tbody tr');

            tableRows.forEach(function(row) {
                const nom = row.cells[0].textContent.toLowerCase();

                if (nom.includes(searchValue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // ========== EDIT PATIENT ==========
        function editPatient(id, lastName, firstName, email, phoneNumber, genre, birthDate, socialSecurityNumber, physioId, weight, height, doctorName, doctorINAMI, address) {
            document.getElementById('edit_Id').value = id;
            document.getElementById('edit_LastName').value = lastName;
            document.getElementById('edit_FirstName').value = firstName;
            document.getElementById('edit_Email').value = email;
            document.getElementById('edit_PhoneNumber').value = phoneNumber;
            document.getElementById('edit_Address').value = address || '';
            document.getElementById('edit_Genre').value = genre;
            document.getElementById('edit_BirthDate').value = birthDate;
            document.getElementById('edit_SocialSecurityNumber').value = socialSecurityNumber;
            document.getElementById('edit_PhysioId').value = physioId;
            document.getElementById('edit_Weight').value = weight;
            document.getElementById('edit_Height').value = height;
            document.getElementById('edit_DoctorName').value = doctorName || '';
            document.getElementById('edit_DoctorINAMI').value = doctorINAMI || '';

            const editModal = new bootstrap.Modal(document.getElementById('editPatientModal'));
            editModal.show();
        }
    </script>
}
