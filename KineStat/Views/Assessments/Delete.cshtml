@model KineStat.Models.Assessment

@{
    ViewData["Title"] = "Supprimer l'évaluation";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 fw-bold text-danger mb-2">
                <i class="bi bi-trash me-2"></i>Supprimer l'évaluation
            </h1>
            <p class="text-secondary mb-3">Confirmez la suppression de cette évaluation</p>
            <hr class="border-danger border-2 opacity-25">
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle me-2"></i>Confirmation requise
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Êtes-vous sûr de vouloir supprimer cette évaluation ? Cette action est irréversible.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary fw-medium">
                            @Html.DisplayNameFor(model => model.Date)
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            @Html.DisplayFor(model => model.Date)
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-medium">
                            @Html.DisplayNameFor(model => model.Patient)
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            @Html.DisplayFor(model => model.Patient.Email)
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-medium">
                            @Html.DisplayNameFor(model => model.Physio)
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @Html.DisplayFor(model => model.Physio.Email)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex">
                            <button type="submit" class="btn btn-danger fw-medium">
                                <i class="bi bi-trash-fill me-2"></i>Supprimer
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-medium">
                                <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>