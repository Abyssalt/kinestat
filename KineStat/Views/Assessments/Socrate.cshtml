@model KineStat.Models.Socrate

@{
    ViewData["Title"] = "SOCRATE";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    var folderId = ViewData["FolderId"]; 
    var firstName = ViewBag.FirstName;
    var lastName = ViewBag.LastName;
    var patientId = ViewData["PatientId"];
    ViewData["ShowSuspendButton"] = true;

    ViewData["Breadcrumbs"] = 
        $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Anamnese'>Anamnèse</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Dossier/{folderId}/Details'>Dossier</a></li>" +
        $"<li class='breadcrumb-item active'>SOCRATE</li>";

    var assessmentId = ViewData["AssessmentId"];
    ViewData["HideFloatingEye"] = true;
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <a asp-controller="Folder" asp-action="DossierDetails" asp-route-id="@folderId" class="btn btn-outline-secondary fw-medium btn-tablet-lg">
                    <i class="bi bi-arrow-left me-2"></i>Revenir au dossier
                </a>
            </div>

            <hr class="border-primary border-2 opacity-25 mt-3">

        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-info text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-question-circle me-2"></i>Questionnaire SOCRATE
                        </h5>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form asp-controller="Assessments" asp-action="SaveSocrate" method="post" id="socrateForm">
                        <input type="hidden" name="PatientId" value="@patientId" />
                        <input type="hidden" name="AssessmentId" value="@assessmentId" />

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">S</span>Site
                            </label>
                            <p class="text-secondary small">Où se situe la douleur ? Pouvez-vous montrer exactement où ?</p>
                            <textarea class="form-control socrate-field" name="Site" rows="2" data-field="site">@Model?.Site</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">O</span>Onset (Début)
                            </label>
                            <p class="text-secondary small">Quand la douleur a-t-elle commencé ? Comment a-t-elle débuté (progressive, soudaine) ?</p>
                            <textarea class="form-control socrate-field" name="Onset" rows="2" data-field="onset">@Model?.Onset</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">C</span>Character (Caractère)
                            </label>
                            <p class="text-secondary small">Comment décririez-vous la douleur ? (brûlure, coup de poignard, pression, pulsatile...)</p>
                            <textarea class="form-control socrate-field" name="Character" rows="2" data-field="character">@Model?.Character</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">R</span>Radiation
                            </label>
                            <p class="text-secondary small">La douleur se propage-t-elle ailleurs ? Si oui, où ?</p>
                            <textarea class="form-control socrate-field" name="Radiation" rows="2" data-field="radiation">@Model?.Radiation</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">A</span>Association
                            </label>
                            <p class="text-secondary small">Y a-t-il d'autres symptômes associés ? (nausées, sueurs, engourdissements, faiblesse...)</p>
                            <textarea class="form-control socrate-field" name="Association" rows="2" data-field="association">@Model?.Association</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">T</span>Timing (Temporalité)
                            </label>
                            <p class="text-secondary small">La douleur est-elle constante ou intermittente ? À quels moments survient-elle ?</p>
                            <textarea class="form-control socrate-field" name="Timing" rows="2" data-field="timing">@Model?.Timing</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">E</span>Exacerbating Factor (Facteurs aggravants)
                            </label>
                            <p class="text-secondary small">Qu'est-ce qui aggrave la douleur ? (mouvement, position, activité...)</p>
                            <textarea class="form-control socrate-field" name="ExacerbatingFactor" rows="2" data-field="exacerbatingFactor">@Model?.ExacerbatingFactor</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">
                                <span class="badge bg-info me-2">R</span>Relieving Factor (Facteurs soulageants)
                            </label>
                            <p class="text-secondary small">Qu'est-ce qui soulage la douleur ? (repos, position, médicaments...)</p>
                            <textarea class="form-control socrate-field" name="RelievingFactor" rows="2" data-field="relievingFactor">@Model?.RelievingFactor</textarea>
                        </div>
                        
                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 p-3">
                            <button type="submit" id="saveButton" class="btn btn-secondary fw-medium btn-tablet-lg border border-1 rounded">
                                <i class="bi bi-save me-2"></i>Enregistrer et continuer<i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                        <hr class="my-4 border-secondary opacity-25" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>