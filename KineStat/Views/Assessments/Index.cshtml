@model IEnumerable<KineStat.Models.Assessment>

@{
    ViewData["Title"] = "Évaluations";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 fw-bold text-primary mb-2">
                <i class="bi bi-clipboard-check me-2"></i>Évaluations
            </h1>
            <p class="text-secondary mb-3">Liste de toutes les évaluations</p>
            <hr class="border-primary border-2 opacity-25">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="Create" class="btn btn-success fw-medium">
                <i class="bi bi-plus-circle me-2"></i>Nouvelle évaluation
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul me-2"></i>Liste des évaluations
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="fw-semibold">
                                            @Html.DisplayNameFor(model => model.Date)
                                        </th>
                                        <th scope="col" class="fw-semibold d-none d-md-table-cell">
                                            @Html.DisplayNameFor(model => model.Patient)
                                        </th>
                                        <th scope="col" class="fw-semibold d-none d-lg-table-cell">
                                            @Html.DisplayNameFor(model => model.Physio)
                                        </th>
                                        <th scope="col" class="fw-semibold text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Date)
                                            </td>
                                            <td class="d-none d-md-table-cell">
                                                <a href="mailto:@item.Patient.Email" class="text-decoration-none text-primary">
                                                    @Html.DisplayFor(modelItem => item.Patient.Email)
                                                </a>
                                            </td>
                                            <td class="d-none d-lg-table-cell text-secondary">
                                                @Html.DisplayFor(modelItem => item.Physio.Email)
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Détails">
                                                        <i class="bi bi-eye-fill"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-4 text-secondary"></i>
                            <p class="text-secondary mt-3 mb-0">Aucune évaluation enregistrée</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>