@model KineStat.Models.Assessment

@{
    ViewData["Title"] = "Détails du bilan";
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Patient/{Model.Patient.Id}/Anamnese'>Anamnèse - {Model.Patient.FirstName} {Model.Patient.LastName}</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Dossier/{Model.DossierId}/details'>Dossier {Model.Dossier.Titre}</a></li>" +
                              $"<li class='breadcrumb-item active'>Bilan du {Model.Date:dd/MM/yyyy}</li>";
    var tintivJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.TintivValues ?? new List<double> { 0, 0, 0, 0, 0, 0 }
    );

    var clinicalJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.ClinicalValues ?? new List<double> { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
    );
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <a asp-controller="Folder" asp-action="DossierDetails"
                    asp-route-id="@Model.DossierId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-clipboard2-pulse me-2"></i>Détails du bilan
                    </h1>
                    <p class="text-secondary mb-0">Bilan du @Model.Date.ToString("dd/MM/yyyy")</p>
                </div>
                <button class="btn btn-outline-primary fw-medium" disabled>
                    <i class="bi bi-file-earmark-pdf me-2"></i>Exporter PDF
                </button>

                <button class="btn btn-outline-danger fw-medium"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteAssessmentModal">
                    <i class="bi bi-trash me-2"></i>Supprimer
                </button>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12 mb-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Informations générales
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Date</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-calendar3 text-primary me-2"></i>@Model.Date.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Patient</label>
                            <p class="form-control-plaintext fw-semibold mb-0">
                                <i class="bi bi-person text-primary me-2"></i>@Model.Patient.FirstName @Model.Patient.LastName
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Kinésithérapeute</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-person-badge text-primary me-2"></i>@Model.Physio.FirstName @Model.Physio.LastName
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3 mb-md-0">
                            <label class="form-label fw-medium text-secondary small">Dossier</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-folder text-info me-2"></i>@Model.Dossier.Titre
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-check me-2"></i>Tests effectués
                </h5>
            </div>
            <ul class="list-group list-group-flush">

                @if (ViewBag.Tests != null && ((List<PatientAnswerTests>)ViewBag.Tests).Any())
                {
                    var groupedTests = ((List<PatientAnswerTests>)ViewBag.Tests)
                    .GroupBy(t => t.IsCustomTest
                    ? "Tests personnalisés"
                    : t.Question?.Cluster?.Name ?? "Autres")
                    .ToList();

                    int index = 0;

                    foreach (var group in groupedTests)
                    {
                        var collapseId = $"details-cluster-{index++}";

                        <li class="list-group-item px-2">
                            <button class="btn btn-link fw-bold text-decoration-none w-100 text-start"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId">
                                <i class="bi bi-folder2-open me-2"></i>
                                @group.Key
                                <span class="badge bg-primary ms-2">@group.Count()</span>
                            </button>

                            <div class="collapse mt-2" id="@collapseId">
                                <ul class="list-group list-group-flush">
                                    @foreach (var test in group)
                                    {
                                        <li class="list-group-item">
                                            <strong>
                                                @(test.IsCustomTest ? test.CustomTestName : test.Question?.Title)
                                </strong>

                                            <div class="text-muted small">
                                                Résultat : @test.ResponseValue
                                            </div>

                                @if (!string.IsNullOrWhiteSpace(test.Observations))
                                            {
                                                <div class="fst-italic text-secondary small">
                                                    💬 @test.Observations
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">
                        Aucun test enregistré
                    </li>
                }

            </ul>

        </div>
    </div>
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-warning text-center">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-activity text-danger me-2"></i>Analyse du risque
                </h5>
            </div>

            <div class="card-body d-flex flex-column justify-content-center text-center">
                <div style="height:45px;" class="mb-3">
                    <canvas id="redFlagsGaugeDetails"></canvas>
                </div>

                <span id="redFlagsGaugeDetailsValue"
                      class="fs-3 fw-bold text-primary">
                    0 %
                </span>

                <small class="text-muted mt-2">
                    Probabilité 
                </small>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Pathologies suspectées
                </h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    Tumoral <span class="badge bg-primary">26%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Infectieux <span class="badge bg-primary">10%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Neurologique <span class="badge bg-primary">12%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Vasculaire <span class="badge bg-primary">32%</span>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow">

            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-pentagon me-2"></i>Profil clinique
                </h5>
            </div>

            <div class="card-body">
                <div class="row text-center">
                    <div class="col-lg-6 mb-4">
                        <h6 class="fw-bold mb-2">Profil clinique</h6>
                        <div style="height:350px">
                            <canvas id="radarChart9"></canvas>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h6 class="fw-bold mb-2">TINTIV </h6>
                        <div style="height:350px">
                            <canvas id="radarChart6"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@{
    var socrate = ViewBag.Socrate as KineStat.Models.Socrate;
}

<div class="row mt-4">
    <div class="col-12">
        <div class="accordion shadow-sm" id="socrateAccordion">

            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingSocrate">
                    <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseSocrate">
                        <i class="bi bi-clipboard-heart text-danger me-2"></i>
                        SOCRATE – Anamnèse douleur
                    </button>
                </h2>

                <div id="collapseSocrate"
                     class="accordion-collapse collapse"
                     data-bs-parent="#socrateAccordion">

                    <div class="accordion-body">

                        @if (socrate == null)
                        {
                            <p class="text-muted mb-0">
                                Aucun SOCRATE enregistré pour ce bilan.
                            </p>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <strong>Site :</strong>
                                    <div class="text-muted">@socrate.Site</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Onset :</strong>
                                    <div class="text-muted">@socrate.Onset</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Caractère :</strong>
                                    <div class="text-muted">@socrate.Character</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Irradiation :</strong>
                                    <div class="text-muted">@socrate.Radiation</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Association :</strong>
                                    <div class="text-muted">@socrate.Association</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Temporalité :</strong>
                                    <div class="text-muted">@socrate.Timing</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Facteurs aggravants :</strong>
                                    <div class="text-muted">@socrate.ExacerbatingFactor</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Facteurs soulageants :</strong>
                                    <div class="text-muted">@socrate.RelievingFactor</div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="deleteAssessmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Supprimer le bilan
                </h5>
            </div>

            <div class="modal-body">
                <p class="mb-2">
                    Êtes-vous sûr de vouloir supprimer ce bilan ?
                </p>
                <p class="text-muted small mb-0">
                    Cette action est <strong>irréversible</strong>.
                </p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Annuler
                </button>

                <form asp-controller="Assessments"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      asp-route-dossierId="@Model.DossierId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger fw-medium">
                        <i class="bi bi-trash me-2"></i>
                        Supprimer définitivement
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const redFlagsPercentage = @((Model.RedFlagsPercentage ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        
        GaugeManager.createGauge("redFlagsGaugeDetails", "redFlagsGaugeDetailsValue");
        GaugeManager.updateGauge("redFlagsGaugeDetails", redFlagsPercentage);
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tintivValues = @Html.Raw(tintivJson);
        const clinicalValues = @Html.Raw(clinicalJson);
        const defaultOptions = {
            responsive: true,
            maintainAspectRatio: false,
            elements: {
                line: { tension: 0.3 },
                point: { radius: 5, hoverRadius: 7 }
            },
            scales: {
                r: {
                    min: 0,
                    grid: {
                        color: "rgba(0,0,0,0.1)"
                    },
                    angleLines: {
                        color: "rgba(0,0,0,0.2)"
                    },
                    ticks: {
                        backdropColor: "transparent",
                        showLabelBackdrop: false
                    }
                }
            },
            plugins: {
                legend: { display: false }
            }
        };

        new Chart(document.getElementById("radarChart9"), {
            type: 'radar',
            data: {
                labels: [
                    "Articulaire/structurel",
                    "Myofascial",
                    "Nociceptif",
                    "Neuropathique",
                    "Nociplastique",
                    "Contrôle sensorimoteur",
                    "Croyance & cognition",
                    "Socio-environnemental",
                    "Émotionnel/Affectif"
                ],
                datasets: [{
                    label: "Profil clinique",
                    data: clinicalValues,
                    backgroundColor: "rgba(13,110,253,0.25)",
                    borderColor: "rgb(13,110,253)",
                    borderWidth: 3,
                    pointBackgroundColor: "rgb(13,110,253)",
                    pointBorderColor: "#fff"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        min: 0,
                        max: 10,
                        ticks: {
                            stepSize: 10,
                            backdropColor: "transparent"
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        new Chart(document.getElementById("radarChart6"), {
            type: 'radar',
            data: {
                labels: [
                    "Tumeur",
                    "Infection",
                    "Neurologique",
                    "Traumatisme",
                    "Inflammatoire",
                    "Vasculaire"
                ],
                datasets: [{
                    label: "Profil TINTIV",
                    data: tintivValues,
                    backgroundColor: "rgba(255,99,132,0.25)",
                    borderColor: "rgb(255,99,132)",
                    borderWidth: 3,
                    pointBackgroundColor: "rgb(255,99,132)",
                    pointBorderColor: "#fff"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        min: 0,
                        max: 10,
                        ticks: {
                            stepSize: 10,
                            backdropColor: "transparent"
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

    });
</script>
