@using Microsoft.EntityFrameworkCore
@model KineStat.Models.Assessment

@{
    ViewData["Title"] = "Détails du bilan";
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Index'>Patients</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Patient/{Model.Patient.Id}/Anamnese'>Anamnèse - {Model.Patient.FirstName} {Model.Patient.LastName}</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Dossier/{Model.DossierId}/details'>Dossier {Model.Dossier.Titre}</a></li>" +
                              $"<li class='breadcrumb-item active'>Bilan du {Model.Date:dd/MM/yyyy}</li>";
    var tintivJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.TintivValues ?? new List<double> { 0, 0, 0, 0, 0, 0 }
    );

    var clinicalJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.ClinicalValues ?? new List<double> { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
    );
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <a asp-controller="Folder" asp-action="DossierDetails"
                    asp-route-id="@Model.DossierId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-clipboard2-pulse me-2"></i>Détails du bilan
                    </h1>
                    <p class="text-secondary mb-0">Bilan du @Model.Date.ToString("dd/MM/yyyy")</p>
                </div>
                <button class="btn btn-outline-primary fw-medium" disabled>
                    <i class="bi bi-file-earmark-pdf me-2"></i>Exporter PDF
                </button>

                <button class="btn btn-outline-danger fw-medium"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteAssessmentModal">
                    <i class="bi bi-trash me-2"></i>Supprimer
                </button>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12 mb-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Informations générales
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Date</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-calendar3 text-primary me-2"></i>@Model.Date.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Patient</label>
                            <p class="form-control-plaintext fw-semibold mb-0">
                                <i class="bi bi-person text-primary me-2"></i>@Model.Patient.FirstName @Model.Patient.LastName
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Kinésithérapeute</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-person-badge text-primary me-2"></i>@Model.Physio.FirstName @Model.Physio.LastName
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3 mb-md-0">
                            <label class="form-label fw-medium text-secondary small">Dossier</label>
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-folder text-info me-2"></i>@Model.Dossier.Titre
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-check me-2"></i>Tests effectués
                </h5>
            </div>
            <ul class="list-group list-group-flush">

                @if (ViewBag.Tests != null && ((List<PatientAnswerTests>)ViewBag.Tests).Any())
                {
                    var groupedTests = ((List<PatientAnswerTests>)ViewBag.Tests)
                    .GroupBy(t => t.IsCustomTest
                    ? "Tests personnalisés"
                    : t.Question?.Cluster?.Name ?? "Autres")
                    .ToList();

                    int index = 0;

                    foreach (var group in groupedTests)
                    {
                        var collapseId = $"details-cluster-{index++}";

                        <li class="list-group-item px-2">
                            <button class="btn btn-link fw-bold text-decoration-none w-100 text-start"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId">
                                <i class="bi bi-folder2-open me-2"></i>
                                @group.Key
                                <span class="badge bg-primary ms-2">@group.Count()</span>
                            </button>

                            <div class="collapse mt-2" id="@collapseId">
                                <ul class="list-group list-group-flush">
                                    @foreach (var test in group)
                                    {
                                        <li class="list-group-item">
                                            <strong>
                                                @(test.IsCustomTest ? test.CustomTestName : test.Question?.Title)
                                </strong>

                                <div class="text-muted small">
                                    Résultat :
                                    @(
                                    test.ResponseValue == "true" ? "Positif" :
                                    test.ResponseValue == "false" ? "Negatif" :
                                    test.ResponseValue
                                    )
                                </div>

                                @if (!string.IsNullOrWhiteSpace(test.Observations))
                                            {
                                                <div class="fst-italic text-secondary small">
                                                    💬 @test.Observations
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">
                        Aucun test enregistré
                    </li>
                }

            </ul>

        </div>
    </div>
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-warning text-center">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-activity text-danger me-2"></i>Analyse du risque
                </h5>
            </div>

            <div class="card-body d-flex flex-column justify-content-center text-center">
                <div style="height:45px;" class="mb-3">
                    <canvas id="redFlagsGaugeDetails"></canvas>
                </div>

                <span id="redFlagsGaugeDetailsValue"
                      class="fs-3 fw-bold text-primary">
                    0 %
                </span>

                <small class="text-muted mt-2">
                    Probabilité 
                </small>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4 mb-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Pathologies suspectées
                </h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    Tumoral <span class="badge bg-primary">26%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Infectieux <span class="badge bg-primary">10%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Neurologique <span class="badge bg-primary">12%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Vasculaire <span class="badge bg-primary">32%</span>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow">

            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-pentagon me-2"></i>Profil clinique
                </h5>
            </div>

            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-12 col-md-6 mx-auto">
                        <label class="form-label fw-medium text-secondary">
                            <i class="bi bi-graph-up me-2"></i>Comparer avec un autre bilan :
                        </label>
                        <select id="comparisonAssessmentSelect" class="form-select">
                            <option value="">-- Aucune comparaison --</option>
                            @if (ViewBag.FirstTintivValues != null)
                            {
                                var firstAssessmentLocal = await Context.RequestServices
                                .GetService<KineStat.Data.KineDbContext>()
                                .Assessments
                                .Where(a => a.DossierId == Model.DossierId)
                                .OrderBy(a => a.Date)
                                .FirstOrDefaultAsync();

                                if (firstAssessmentLocal != null && firstAssessmentLocal.Id != Model.Id)
                                {
                                    <option value="@firstAssessmentLocal.Id" selected>
                                        ⭐ Premier bilan - @firstAssessmentLocal.Date.ToString("dd/MM/yyyy")
                                    </option>
                                }
                            }
                            @if (ViewBag.OtherAssessments != null)
                            {
                                foreach (var otherAssessment in ViewBag.OtherAssessments)
                                {
                                    <option value="@otherAssessment.Id">
                                        Bilan du @otherAssessment.Date.ToString("dd/MM/yyyy")
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col-lg-6 mb-4">
                        <h6 class="fw-bold mb-2">Profil clinique</h6>
                        <div style="height:350px">
                            <canvas id="radarChart9"></canvas>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h6 class="fw-bold mb-2">TINTIV </h6>
                        <div style="height:350px">
                            <canvas id="radarChart6"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@{
    var socrate = ViewBag.Socrate as KineStat.Models.Socrate;
}

<div class="row mt-4">
    <div class="col-12">
        <div class="accordion shadow-sm" id="socrateAccordion">

            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingSocrate">
                    <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseSocrate">
                        <i class="bi bi-clipboard-heart text-danger me-2"></i>
                        SOCRATE – Anamnèse douleur
                    </button>
                </h2>

                <div id="collapseSocrate"
                     class="accordion-collapse collapse"
                     data-bs-parent="#socrateAccordion">

                    <div class="accordion-body">

                        @if (socrate == null)
                        {
                            <p class="text-muted mb-0">
                                Aucun SOCRATE enregistré pour ce bilan.
                            </p>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <strong>Site :</strong>
                                    <div class="text-muted">@socrate.Site</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Onset :</strong>
                                    <div class="text-muted">@socrate.Onset</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Caractère :</strong>
                                    <div class="text-muted">@socrate.Character</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Irradiation :</strong>
                                    <div class="text-muted">@socrate.Radiation</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Association :</strong>
                                    <div class="text-muted">@socrate.Association</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Temporalité :</strong>
                                    <div class="text-muted">@socrate.Timing</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Facteurs aggravants :</strong>
                                    <div class="text-muted">@socrate.ExacerbatingFactor</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Facteurs soulageants :</strong>
                                    <div class="text-muted">@socrate.RelievingFactor</div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="row mt-4">
    <div class="col-12">
        <div class="accordion shadow-sm" id="redFlagsAccordion">
            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingRedFlags">
                    <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseRedFlags">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Red Flags – Réponses
                    </button>
                </h2>

                <div id="collapseRedFlags"
                     class="accordion-collapse collapse"
                     data-bs-parent="#redFlagsAccordion">
                    <div class="accordion-body">
                        @if (ViewBag.RedFlagsAnswers != null && ((List<PatientAnswerBool>)ViewBag.RedFlagsAnswers).Any())
                        {
                            var groupedRedFlags = ((List<PatientAnswerBool>)ViewBag.RedFlagsAnswers)
                            .GroupBy(a => a.Question?.Category?.Name ?? "Autres")
                            .ToList();

                            int rfIndex = 0;

                            foreach (var group in groupedRedFlags)
                            {
                                var collapseId = $"rf-collapse-{rfIndex++}";

                                <div class="mb-3">
                                    <button class="btn btn-link fw-bold text-decoration-none w-100 text-start"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId">
                                        <i class="bi bi-folder2-open me-2"></i>
                                        @group.Key
                                        <span class="badge bg-danger ms-2">@group.Count()</span>
                                    </button>

                                    <div class="collapse mt-2" id="@collapseId">
                                        <ul class="list-group">
                                            @foreach (var answer in group)
                                            {
                                                <li class="list-group-item">
                                                    <strong>@answer.Question?.Title</strong>
                                                    <div class="text-muted small">
                                                        Réponse : @(answer.Value ? "Oui" : "Non")
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(answer.Comment))
                                                    {
                                                        <div class="fst-italic text-secondary small">
                                                            💬 @answer.Comment
                                                        </div>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Aucune réponse Red Flags enregistrée pour ce bilan.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row mt-4">
    <div class="col-12">
        <div class="accordion shadow-sm" id="clinicalExamAccordion">
            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingClinicalExam">
                    <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseClinicalExam">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>
                        Examen Clinique – Réponses
                    </button>
                </h2>

                <div id="collapseClinicalExam"
                     class="accordion-collapse collapse"
                     data-bs-parent="#clinicalExamAccordion">
                    <div class="accordion-body">
                        @if (ViewBag.ClinicalAnswers != null && ((List<PatientAnswerTests>)ViewBag.ClinicalAnswers).Any())
                        {
                            var groupedClinical = ((List<PatientAnswerTests>)ViewBag.ClinicalAnswers)
                            .GroupBy(a => a.Question?.Category?.Name ?? "Autres")
                            .ToList();

                            int clinIndex = 0;

                            foreach (var group in groupedClinical)
                            {
                                var collapseId = $"clin-collapse-{clinIndex++}";

                                <div class="mb-3">
                                    <button class="btn btn-link fw-bold text-decoration-none w-100 text-start"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId">
                                        <i class="bi bi-folder2-open me-2"></i>
                                        @group.Key
                                        <span class="badge bg-primary ms-2">@group.Count()</span>
                                    </button>

                                    <div class="collapse mt-2" id="@collapseId">
                                        <ul class="list-group">
                                            @foreach (var answer in group)
                                            {
                                                <li class="list-group-item">
                                                    <strong>@answer.Question?.Title</strong>
                                                    <div class="text-muted small">
                                                        Réponse : @answer.ResponseValue
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(answer.Observations))
                                                    {
                                                        <div class="fst-italic text-secondary small">
                                                            💬 @answer.Observations
                                                        </div>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Aucune réponse d'examen clinique enregistrée pour ce bilan.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteAssessmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Supprimer le bilan
                </h5>
            </div>

            <div class="modal-body">
                <p class="mb-2">
                    Êtes-vous sûr de vouloir supprimer ce bilan ?
                </p>
                <p class="text-muted small mb-0">
                    Cette action est <strong>irréversible</strong>.
                </p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Annuler
                </button>

                <form asp-controller="Assessments"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      asp-route-dossierId="@Model.DossierId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger fw-medium">
                        <i class="bi bi-trash me-2"></i>
                        Supprimer définitivement
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const redFlagsPercentage = @((Model.RedFlagsPercentage ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        
        GaugeManager.createGauge("redFlagsGaugeDetails", "redFlagsGaugeDetailsValue");
        GaugeManager.updateGauge("redFlagsGaugeDetails", redFlagsPercentage);
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tintivValues = @Html.Raw(tintivJson);
        const clinicalValues = @Html.Raw(clinicalJson);
        const firstTintivValues = @Html.Raw(ViewBag.FirstTintivValues != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.FirstTintivValues) : "null");

        let radarChart9, radarChart6;

        const colors = {
            current: {
                background: "rgba(13,110,253,0.25)",
                border: "rgb(13,110,253)"
            },
            first: {
                background: "rgba(108,117,125,0.25)",
                border: "rgb(108,117,125)"
            },
            comparison: {
                background: "rgba(40,167,69,0.25)",
                border: "rgb(40,167,69)"
            }
        };

        const colorsTintiv = {
            current: {
                background: "rgba(255,99,132,0.30)",
                border: "rgb(255,99,132)"
            },
            first: {
                background: "rgba(108,117,125,0.25)",
                border: "rgb(108,117,125)"
            },
            comparison: {
                background: "rgba(255,193,7,0.30)",
                border: "rgb(255,193,7)"
            }
        };

        const defaultOptions = {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                r: {
                    min: 0,
                    max: 10,
                    ticks: {
                        stepSize: 2,
                        backdropColor: "transparent",
                        showLabelBackdrop: false
                    },
                    grid: {
                        color: "rgba(0,0,0,0.1)"
                    },
                    angleLines: {
                        color: "rgba(0,0,0,0.2)"
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom'
                }
            }
        };

        initCharts();

        const selector = document.getElementById('comparisonAssessmentSelect');
        if (selector) {
            if (selector.value && firstTintivValues) {
                loadFirstAssessment();
            }

            selector.addEventListener('change', async (e) => {
                const selectedAssessmentId = e.target.value;

                if (selectedAssessmentId) {

                    if (e.target.options[e.target.selectedIndex].text.includes('⭐')) {
                        loadFirstAssessment();
                    } else {
                        await loadComparisonData(selectedAssessmentId);
                    }
                } else {

                    initCharts();
                }
            });
        }

        function initCharts() {

            if (radarChart9) radarChart9.destroy();
            if (radarChart6) radarChart6.destroy();

            radarChart9 = new Chart(document.getElementById("radarChart9"), {
                type: 'radar',
                data: {
                    labels: ["Articulaire/structurel", "Myofascial", "Nociceptif", "Neuropathique",
                             "Nociplastique", "Contrôle sensorimoteur", "Croyance & cognition",
                             "Socio-environnemental", "Émotionnel/Affectif"],
                    datasets: [{
                        label: "Bilan actuel",
                        data: clinicalValues,
                        backgroundColor: colors.current.background,
                        borderColor: colors.current.border,
                        borderWidth: 3,
                        pointBackgroundColor: colors.current.border,
                        pointBorderColor: "#fff"
                    }]
                },
                options: defaultOptions
            });

            radarChart6 = new Chart(document.getElementById("radarChart6"), {
                type: 'radar',
                data: {
                    labels: ["Tumeur", "Infection", "Neurologique", "Traumatisme", "Inflammatoire", "Vasculaire"],
                    datasets: [{
                        label: "Bilan actuel",
                        data: tintivValues,
                        backgroundColor: colorsTintiv.current.background,
                        borderColor: colorsTintiv.current.border,
                        borderWidth: 4,
                        pointRadius: 6,
                        pointHoverRadius: 9,
                        pointBackgroundColor: colorsTintiv.current.border,
                        pointBorderColor: "#fff",
                        tension: 0.25
                    }]
                },
                options: defaultOptions
            });
        }

        function loadFirstAssessment() {
            if (!firstTintivValues) return;

            initCharts();

            radarChart9.data.datasets.push({
                label: "Premier bilan",
                data: firstTintivValues.slice(6),                 backgroundColor: colors.first.background,
                borderColor: colors.first.border,
                borderWidth: 2,
                pointBackgroundColor: colors.first.border,
                pointBorderColor: "#fff",
                borderDash: [5, 5]
            });
            radarChart9.update();

            radarChart6.data.datasets.push({
                label: "Premier bilan",
                data: firstTintivValues.slice(0, 6),                backgroundColor: colorsTintiv.first.background,
                borderColor: colorsTintiv.first.border,
                borderWidth: 3,
                pointRadius: 5,
                pointBackgroundColor: colorsTintiv.first.border,
                pointBorderColor: "#fff",
                borderDash: [5, 5],
                tension: 0.25
            });
            radarChart6.update();
        }

        async function loadComparisonData(assessmentId) {
            try {
                const response = await fetch(`/Assessment/${assessmentId}/ComparisonData`);
                if (!response.ok) {
                    console.error('Erreur lors du chargement des données');
                    return;
                }

                const data = await response.json();

                initCharts();

                radarChart9.data.datasets.push({
                    label: `Bilan du ${data.date}`,
                    data: data.clinicalValues,
                    backgroundColor: colors.comparison.background,
                    borderColor: colors.comparison.border,
                    borderWidth: 3,
                    pointBackgroundColor: colors.comparison.border,
                    pointBorderColor: "#fff"
                });
                radarChart9.update();
                radarChart6.data.datasets.push({
                    label: `Bilan du ${data.date}`,
                    data: data.tintivValues,
                    backgroundColor: colorsTintiv.comparison.background,
                    borderColor: colorsTintiv.comparison.border,
                    borderWidth: 4,
                    pointRadius: 6,
                    pointBackgroundColor: colorsTintiv.comparison.border,
                    pointBorderColor: "#fff",
                    tension: 0.25
                });
                radarChart6.update();

            } catch (error) {
                console.error('Erreur:', error);
            }
        }
    });
</script>