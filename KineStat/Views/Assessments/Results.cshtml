@using KineStat.Models.DTO
@model KineStat.Models.Assessment


﻿@{
    ViewData["Title"] = "Résultats";
    var patientId = ViewContext.RouteData.Values["id"]?.ToString();
    var assessmentId = ViewData["AssessmentId"];
    var folderId = ViewData["FolderId"];

ViewData["HideFloatingEye"] = true;
ViewData["Breadcrumbs"] =
    $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Anamnese'>Anamnèse</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Folder/{folderId}/Details'>Dossier</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Socrate/{assessmentId}'>SOCRATE</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Folder/{folderId}/RedFlags/{assessmentId}'>Red Flags</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Folder/{folderId}/ExamenClinique/{assessmentId}'>Examen Clinique</a></li>" +
    $"<li class='breadcrumb-item'><a href='/Patient/{patientId}/Folder/{folderId}/Tests/{assessmentId}'>Tests</a></li>" +
    $"<li class='breadcrumb-item active'>Résultats</li>";
 }

 @{
     var tintivJson = System.Text.Json.JsonSerializer.Serialize(
         ViewBag.TintivValues ?? new List<double> { 0, 0, 0, 0, 0, 0 }
     );
     var clinicalJson = System.Text.Json.JsonSerializer.Serialize(
         ViewBag.ClinicalValues ?? new List<double> { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
     );
 }

<meta name="patient-id" content="@Model.PatientId" />
<meta name="assessment-id" content="@Model.Id" />
<div class="container-fluid px-3 px-md-4 py-4">

     <div class="row mb-4">
         <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-graph-up me-2"></i>Résultat
                    </h1>
                </div>
                <a asp-controller="Tests" asp-action="Tests" asp-route-id="@Model.PatientId" asp-route-folderId="@folderId" asp-route-assessmentId="@assessmentId" class="btn btn-outline-secondary fw-medium btn-tablet-lg">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>
             <hr class="border-primary border-2 opacity-25 mt-3">
         </div>
     </div>
     <div class="row"> 
     <div class="col-12 col-lg-4 mb-4">
         <div class="card border-0 shadow h-100">
             <div class="card-header bg-primary text-white py-3">
                 <h5 class="mb-0 fw-bold">
                     <i class="bi bi-list-check me-2"></i>Tests effectués
                 </h5>
             </div>
                <ul class="list-group list-group-flush">

                    @if (ViewBag.Tests != null && ((List<PatientAnswerTests>)ViewBag.Tests).Any())
                    {
                        var testsByCluster = ((List<PatientAnswerTests>)ViewBag.Tests)
                        .GroupBy(t => t.IsCustomTest
                        ? "Tests personnalisés"
                        : t.Question?.Cluster?.Name ?? "Autres");

                        int index = 0;

                        foreach (var clusterGroup in testsByCluster)
                        {
                            var collapseId = $"cluster-collapse-{index++}";

                            <li class="list-group-item px-2">
                                <button class="btn btn-link text-decoration-none fw-bold w-100 text-start"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false">
                                    <i class="bi bi-folder2-open me-2"></i>
                                    @clusterGroup.Key
                                    <span class="badge bg-primary ms-2">
                                        @clusterGroup.Count()
                                    </span>
                                </button>

                                <div class="collapse mt-2" id="@collapseId">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var test in clusterGroup)
                                        {
                                            <li class="list-group-item">
                                                <strong>
                                                    @(test.IsCustomTest ? test.CustomTestName : test.Question?.Title)
                                        </strong>

                                                <div class="text-muted small">
                                                    Résultat :
                                                    @(
                                                    test.ResponseValue == "true" ? "Positif" :
                                                    test.ResponseValue == "false" ? "Negatif" :
                                                    test.ResponseValue
                                                    )
                                                </div>

                                    @if (!string.IsNullOrWhiteSpace(test.Observations))
                                                {
                                                    <div class="fst-italic text-secondary small">
                                                        💬 @test.Observations
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">
                            Aucun test enregistré
                        </li>
                    }

                </ul>

         </div>
     </div>


         <div class="col-12 col-lg-4 mb-4">
             <div class="card border-0 shadow h-100 d-flex">

                 <div class="card-header bg-warning py-3 text-center">
                     <h5 class="mb-0 fw-bold">
                         <i class="bi bi-activity text-danger me-2"></i>
                         Analyse du risque
                     </h5>
                 </div>

                 <div class="card-body d-flex flex-column justify-content-center text-center px-4">

                     <div class="mb-3" style="height:45px;">
                         <canvas id="redFlagsGaugeEye"></canvas>
                     </div>

                     <div>
                         <span id="redFlagsGaugeEyeValue"
                               class="fs-3 fw-bold text-primary">
                             0 %
                         </span>
                     </div>

                 </div>

             </div>
         </div>


         <div class="col-12 col-lg-4 mb-4">
             <div class="card border-0 shadow h-100">
                 <div class="card-header bg-info text-white py-3">
                     <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard2-pulse me-2"></i>Pathologies suspectées</h5>
                 </div>
                @{
                    var detectedPathologies = ViewBag.DetectedPathologies
                    as List<KineStat.Models.DTO.DetectedPathologyDTO>;
                }
                <ul class="list-group list-group-flush">
                    @if (detectedPathologies != null && detectedPathologies.Any())
                    {
                        foreach (var pathology in detectedPathologies.OrderByDescending(p => p.PathologyProbability))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@pathology.PathologyName</span>
                                <span class="badge bg-primary">
                                    @(Math.Round(pathology.PathologyProbability * 100, 2, MidpointRounding.AwayFromZero).ToString("0.00")) %
                                </span>
                           
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">
                            Aucune pathologie détectée
                        </li>
                    }
                </ul>

              
             </div>
         </div>
     </div>

     <div class="row">
         <div class="col-12">
             <div class="card border-0 shadow mb-4">
                 <div class="card-header bg-secondary text-white py-3">
                     <h5 class="mb-0 fw-bold"><i class="bi bi-pentagon me-2"></i>Profil clinique</h5>
                 </div>
                 <div class="card-body p-3 p-md-4">
                     <div class="row text-center">
                         <div class="col-12 col-lg-6 mb-4 mb-lg-0">
                             <h6 class="fw-bold mb-3">Profil clinique (9 catégories)</h6>
                             <div style="height: 350px;">
                                 <canvas id="radarChart9" height="350"></canvas>
                             </div>
                         </div>

                         <div class="col-12 col-lg-6">
                             <h6 class="fw-bold mb-3">TINTIV (6 catégories)</h6>
                             <div style="height: 350px;">
                                 <canvas id="radarChart6" height="350"></canvas>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>
         </div>
     </div>

     <div class="d-flex justify-content-end mb-4">
             <button type="button" class="btn btn-primary btn-lg fw-medium" data-bs-toggle="modal" data-bs-target="#saveAssessmentModal">
                 <i class="bi bi-save me-2"></i>Clôturer le bilan 
             </button>
     </div>

 </div>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        const modal = document.getElementById("saveAssessmentModal");
        const input = document.getElementById("redFlagsPercentageInput");

        if (!modal || !input) return;

            modal.addEventListener("show.bs.modal", () => {
        let value = 0;

        if (window.RedFlagsStore) {
            value = Number(RedFlagsStore.get());
        }

        if (isNaN(value)) value = 0;

        value = Math.max(0, Math.min(100, value));

        input.value = value.toFixed(2).replace(".", ",");

        console.log("RedFlags enregistré :", input.value);

        });
    });
</script>

 <div class="modal fade" id="saveAssessmentModal" tabindex="-1">
     <div class="modal-dialog modal-dialog-centered">
         <div class="modal-content border-0 shadow">

             <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold btn-tablet-lg">
                     <i class="bi bi-save me-2"></i>
                     Clôturer le bilan
                 </h5>
             </div>

             <div class="modal-body">
                 <p class="mb-2">
                     Souhaitez-vous clôturer définitivement ce bilan ?
                 </p>
                 <p class="text-muted small mb-0">
                     Les données seront mises à jour.
                 </p>
             </div>

             <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-tablet-lg"
                         data-bs-dismiss="modal">
                     Annuler
                 </button>

                 <form asp-controller="RedFlags"
                       asp-action="SaveRedFlagsPercentage"
                       method="post">


                     @Html.AntiForgeryToken()

                     <input type="hidden"
                            name="assessmentId"
                            value="@Model.Id" />

                     <input type="hidden"
                            id="redFlagsPercentageInput"
                            name="redFlagsPercentage"/>

                     <button type="submit"
                            class="btn btn-primary fw-medium btn-tablet-lg">
                         <i class="bi bi-check-circle me-2"></i>
                         Clôturer le bilan
                     </button>
                 </form>
             </div>

         </div>
     </div>
 </div>

 


