@model KineStat.Models.Assessment

@{
    ViewData["Title"] = "Nouveau bilan";
    ViewData["PatientId"] = Model.PatientId;
    ViewData["HideFloatingEye"] = true;
}


<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 fw-bold text-primary mb-2">
                <i class="bi bi-clipboard2-pulse me-2"></i>Nouveau bilan
            </h1>
            <p class="text-secondary mb-0">
                Suivez les étapes pour réaliser le bilan complet
            </p>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-clipboard-heart display-5 text-info mb-3"></i>
                    <h5 class="fw-bold text-dark">SOCRATE</h5>
                    <p class="text-secondary small mb-0">
                        Analyse détaillée de la douleur
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle display-5 text-danger mb-3"></i>
                    <h5 class="fw-bold text-dark">Red Flags</h5>
                    <p class="text-secondary small mb-0">
                        Signes de gravité et exclusions
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-search display-5 text-success mb-3"></i>
                    <h5 class="fw-bold text-dark">Examen clinique</h5>
                    <p class="text-secondary small mb-0">
                        Observation et tests fonctionnels
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-list-check display-5 text-warning mb-3"></i>
                    <h5 class="fw-bold text-dark">Tests</h5>
                    <p class="text-secondary small mb-0">
                        Tests spécifiques et cliniques
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-5 text-primary mb-3"></i>
                    <h5 class="fw-bold text-dark">Résultat</h5>
                    <p class="text-secondary small mb-0">
                        Synthèse et orientation
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>


<form asp-controller="Assessments"
      asp-action="StartAssessment"
      method="post"
      class="card border-0 shadow-sm p-3">

    @Html.AntiForgeryToken()

    <input type="hidden" name="PatientId" value="@Model.PatientId" />
    <input type="hidden" name="DossierId" value="@Model.DossierId" />
    <input type="hidden" name="PhysioId" value="@Model.PhysioId" />

    <h6 class="fw-bold mb-3">
        <i class="bi bi-geo-alt me-2"></i>Contexte de prise en charge
    </h6>

    <div class="row g-2 mb-3">

        <div class="col-6 col-md-3">
            <label class="compact-context w-100">
                <input class="form-check-input me-2"
                       type="radio"
                       name="MedicalContextId"
                       value="1"
                       required>
                Cabinet libéral
            </label>
        </div>

        <div class="col-6 col-md-3">
            <label class="compact-context w-100">
                <input class="form-check-input me-2"
                       type="radio"
                       name="MedicalContextId"
                       value="2">
                Hôpital
            </label>
        </div>

        <div class="col-6 col-md-3">
            <label class="compact-context w-100">
                <input class="form-check-input me-2"
                       type="radio"
                       name="MedicalContextId"
                       value="3">
                Maison de repos
            </label>
        </div>

        <div class="col-6 col-md-3">
            <label class="compact-context w-100">
                <input class="form-check-input me-2"
                       type="radio"
                       name="MedicalContextId"
                       value="4">
                Accès direct
            </label>
        </div>

    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-primary fw-medium">
            <i class="bi bi-play-circle me-1"></i>Commencer le bilan
        </button>
    </div>
</form>




<style>
    .mini-card {
        border: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,.06);
        transition: .2s ease;
        padding: .25rem;
    }

    .mini-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,.1);
    }

    .mini-card .card-body {
        padding: .75rem;
    }

    .compact-context {
        padding: .5rem .75rem;
        border: 1px solid #e5e5e5;
        border-radius: .5rem;
        cursor: pointer;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        if (window.RedFlagsStore) {
            RedFlagsStore.set(0);
        }
    });
</script>
