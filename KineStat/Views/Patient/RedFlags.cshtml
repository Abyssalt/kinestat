@model IEnumerable<Question>
@{
    ViewData["Title"] = "Red Flags";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    var patientId = ViewData["PatientId"];

}

<h2>Red Flags </h2>
<a asp-controller="Patients" asp-action="Index" class="btn btn-secondary">Retour</a>

<ul class="nav nav-tabs mb-3" id="redflagsTabs">
    <li class="nav-item">
        <a class="nav-link active" href="#" data-category="1">Tumeur / Métastase</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-category="2">Infection</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-category="3">Neurologique</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-category="4">Traumatisme / Fracture</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-category="5">Inflammatoire</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-category="6">Vasculaire / Circulatoire</a>
    </li>
</ul>



<div id="baseContainer" class="container mt-4">
    <div class="row">
        <div id="questionnaireContainer" class="col-md-8">
        </div>
        <div id="testsContainer" class="col-md-4">
            <h4>Tests suggérés</h4>
            <ul class="list-group">
                <li class="list-group-item">
                    <a href="#" class="text-decoration-none">Test de Lasègue</a>
                </li>
                <li class="list-group-item">
                    <a href="#" class="text-decoration-none">Test de Schober</a>
                </li>
                <li class="list-group-item">
                    <a href="#" class="text-decoration-none">Test de Slump</a>
                </li>
            </ul>
            <div class="card mt-4 border-primary">
                <div class="card-body">
                    <h5 class="card-title">Probabilité pathologie grave</h5>
                    <div style="height: 40px;">
                        <canvas id="redFlagsGauge"></canvas>
                    </div>
                    <div class="text-center mt-2">
                        <h4 id="probabilityValue" class="text-primary">0%</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="redFlagCriticalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Alerte Red Flag Critique</h5>
            </div>

            <div class="modal-body">
                <p>
                    Un seuil de redflags grave a été detecté. Souhaitez vous continuer le bilan ?
                </p>
                <p class="text-muted">
                    Vous pouvez poursuivre le questionnaire ou passer immédiatement aux résultats.
                </p>
            </div>

            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Continuer
                </button>

                <a id="redirectToSummaryBtn"
                   class="btn btn-danger text-white">
                    Arrêter
                </a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    async function loadQuestionsByCategory(categoryId) {
        const patientId = @patientId;
        const response = await fetch(`/Patient/${patientId}/GetRedFlagsQuestions?patientId=${patientId}&categoryId=${categoryId}`);
        const html = await response.text();
        document.getElementById("questionnaireContainer").innerHTML = html;
        attachNoteToggleEvents();
        attachAnswerListeners();
        initializeTooltips();
    }

    function initializeTabs() {
        document.querySelectorAll('#redflagsTabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function (e) {
            e.preventDefault();

            // activate selected tab
            document.querySelectorAll('#redflagsTabs .nav-link')
                .forEach(el => el.classList.remove('active'));
                this.classList.add('active');

            // load questions 
            const categoryId = this.dataset.category;
            loadQuestionsByCategory(categoryId);
            });
        });
    }

        // Function to initialize all Bootstrap tooltips on the page
    function initializeTooltips() {
        const tooltipElements = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipElements.forEach(el => {
            new bootstrap.Tooltip(el);
        });
    }


    function attachNoteToggleEvents() {
        document.querySelectorAll("[id^='notes_button_']").forEach(btn => {
            if (btn.dataset.listenersAdded === "true") return;
            btn.dataset.listenersAdded = "true";
            const targetSelector = btn.getAttribute("data-bs-target");
            const target = document.querySelector(targetSelector);

            if (!target) return;
            const textarea = target.querySelector('textarea');
            let btnText = "";
            if (textarea && textarea.value.trim() !== "")  {
                btnText = "Afficher la note";
            }else {
                btnText = "Ajouter une note";
            }
            btn.textContent = btnText; 

            target.addEventListener('shown.bs.collapse', () => {
                btn.textContent = "Masquer la note";
            });

            target.addEventListener('hidden.bs.collapse', () => {
                btn.textContent = btnText;
            });
        });
    }

    function showCriticalRedFlagModal(patientId) {
        const btn = document.getElementById("redirectToSummaryBtn");
        btn.href = `/Patient/${patientId}/Resultat`;

        const modal = new bootstrap.Modal(document.getElementById("redFlagCriticalModal"));
        modal.show();
         }

    document.addEventListener("DOMContentLoaded", function () {
        initializeTabs();
        loadQuestionsByCategory(1);
        initializeGauge();
        updateGauge(75);    // Change here the value of the gauge : 0..33 Green, 34..66 Yellow and 67..100 Red
        
    });

     function attachAnswerListeners() {

        const radios = document.querySelectorAll('input[name^="q_"]');
        radios.forEach(radio => {
            radio.addEventListener('change', handleRadioChange);
        });

        const textareas = document.querySelectorAll('textarea[name^="note_"]');
        textareas.forEach(textarea => {
            textarea.addEventListener('change', handleTextareaInput);
        });
    }

    function handleRadioChange(event) {
        const radio = event.target;
        const questionId = radio.dataset.questionId;
        const value = radio.value === "true";
        const patientId = @ViewData["PatientId"];
        const comment = getCommentForQuestion(questionId);

        saveAnswer(patientId, questionId, value, comment);
    }

    function handleTextareaInput(event) {
        const textarea = event.target;
        const questionId = textarea.dataset.questionId;
        const comment = textarea.value;
        const patientId = @ViewData["PatientId"];
        const value = getRadioValueForQuestion(questionId);

        saveAnswer(patientId, questionId, value, comment);
    }

    function getCommentForQuestion(questionId) {
        const textarea = document.querySelector(`textarea[name="note_${questionId}"]`);
        return textarea ? textarea.value : "";
    }

    function getRadioValueForQuestion(questionId) {
        const radio = document.querySelector(`input[name="q_${questionId}"]:checked`);
        return radio ? (radio.value === "true") : null;
    }

    function saveAnswer(patientId, questionId, boolValue, comment) {
        const dto = {
            PatientId: patientId,
            QuestionId: questionId,
            BoolValue: boolValue,
            Comment: comment
        };

        fetch(`/Patient/SaveOrUpdateAnswer`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dto)
        })
        .then(async response => {
            if (!response.ok) {
                const text = await response.text();
                console.error("Erreur serveur:", text);
                throw new Error('Erreur serveur');
            }
            return response.json();
        })
    .then(data => console.log("Saved:", data))
    .catch(err => console.error("Erreur sauvegarde:", err));

    }

    let currentProbability = 0;
    let gaugeChart = null;

    function initializeGauge() {
        const ctx = document.getElementById('redFlagsGauge');
        if (!ctx) return;

        gaugeChart = new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: [''],
                datasets: [
                    {
                        data: [currentProbability],
                        backgroundColor: getColorForValue(currentProbability)
                    },
                    {
                        data: [100 - currentProbability],
                        backgroundColor: '#e9ecef'
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true, max: 100, display: false },
                    y: { stacked: true, display: false }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { enabled: false }
                }
            }
        });
    }

    function getColorForValue(value) {
        if (value <= 33) return '#28a745';
        else if (value <= 66) return '#ffc107';
        else return '#dc3545';
    }

    function updateGauge(newValue) {
        currentProbability = newValue;

        if (gaugeChart) {
            gaugeChart.data.datasets[0].data[0] = newValue;
            gaugeChart.data.datasets[0].backgroundColor = getColorForValue(newValue);
            gaugeChart.data.datasets[1].data[0] = 100 - newValue;
            gaugeChart.update();
        }

        const elem = document.getElementById('probabilityValue');
        if (elem) elem.textContent = newValue + '%';
    }

</script>