@{
    ViewData["Title"] = "Prior";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item'><a href='/Patients'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Prior</li>";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Prior</h2>
        <a asp-controller="Patients" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>
    
    <div class="card mb-5 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class ="mb-0"> <i class ="bi bi-clipboard2-pulse"></i>Catégories et probabilités </h4>
        </div>
        
        <div class="card-body">
                <div class="row g-4 text-center">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">Tumoral </h5>
                                <h2 class="fw-bold text-dark">5%</h2>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">  Infectieux </h5>
                                <h2 class="fw-bold text-dark">10%</h2>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">Neurologique </h5>
                                <h2 class="fw-bold text-dark">8%</h2>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">Traumatisme </h5>
                                <h2 class="fw-bold text-dark">12%</h2>
                            </div>
                        </div>

                    </div>


                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">Inflammatoire </h5>
                                <h2 class="fw-bold text-dark">7%</h2>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary">Vasculaire </h5>
                                <h2 class="fw-bold text-dark">6%</h2>
                            </div>
                        </div>

                    </div>

                </div>

        </div>
    </div>

    
    <div class="d-flex justify-content-end mb-5">
        <button type="button" class="btn btn-primary btn-lg">
            <i class="bi bi-save"></i> Enregistrer et continuer
        </button>
    </div>
</div>

