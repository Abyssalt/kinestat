@model KineStat.Models.Dossier

@{
    ViewData["Title"] = "Détails du dossier";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-folder-open"></i>
            @Model.Titre
        </h2>

        <a asp-action="Anamnese"
           asp-route-id="@Model.PatientId"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à l’anamnèse
        </a>
    </div>

<div class="card mb-4">
    <div class="card-header bg-success text-white d-flex justify-content-between">
        <strong>Bilans </strong>

        <a asp-action="CreateAssessment"
           asp-route-dossierId="@Model.Id"
           class="btn btn-light btn-sm">
            <i class="bi bi-plus-circle"></i> Nouveau bilan
        </a>
    </div>

    <div class="card-body">

        @if (!Model.Assessments.Any())
        {
            <p class="text-muted text-center">
                Aucun bilan pour ce dossier
            </p>
        }
        else
        {
            <div class="list-group">
                @foreach (var assessment in Model.Assessments.OrderByDescending(a => a.Date))
                {
                    <a asp-action="AssessmentDetails"
                       asp-route-id="@assessment.Id"
                       class="list-group-item list-group-item-action d-flex justify-content-between">

                        <div>
                            <strong>Bilan du @assessment.Date.ToString("dd/MM/yyyy")</strong><br />
                            <small class="text-muted">
                                Kiné : @assessment.Physio?.FirstName
                            </small>
                        </div>
                    </a>
                }
            </div>
        }

    </div>
</div>
</div>
