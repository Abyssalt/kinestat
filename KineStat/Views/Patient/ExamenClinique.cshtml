@{
    ViewData["Title"] = "Examen clinique";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    var patientId = ViewData["PatientId"];
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-search me-2"></i>Examen clinique
                    </h1>
                </div>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="row g-2" id="dimensionsTabs">
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-primary w-100 h-100 py-3" data-category="Toutes">Toutes</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Articulaire/structurel">Articulaire / structurel</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Myofascial">Myofascial</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Nociceptif">Nociceptif</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Neuropathique">Neuropathique</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Nociplastique">Nociplastique</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Contrôle sensorimoteur">Contrôle sensorimoteur</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Croyances et cognition">Croyances et cognition</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Socio-environnemental">Socio-environnemental</button>
                </div>
                <div class="col-6 col-md-4 col-lg">
                    <button class="btn btn-outline-primary w-100 h-100 py-3" data-category="Émotionnel/affectif">Émotionnel / affectif</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div id="questionnaireContainer" class="col-12 col-lg-8 mb-4 mb-lg-0"></div>
        <div id="testsContainer" class="col-12 col-lg-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-check me-2"></i>Tests suggérés
                    </h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de mobilité articulaire (amplitude active et passive)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de force musculaire (échelle MRC)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de sensibilité cutanée (tact, piqûre, température)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de réflexes ostéo-tendineux</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test d'équilibre et de coordination (Romberg / doigt-nez)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de contrôle moteur (stabilité lombo-pelvienne)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test palpatoire myofascial (points gâchettes, tonus musculaire)</a>
                        </li>
                        <li class="list-group-item py-3">
                            <a href="#" class="text-decoration-none">Test de douleur provoquée (pression, étirement, mouvement)</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    const patientId = @patientId;

    function initializeTabs() {
        document.querySelectorAll('#dimensionsTabs button[data-category]').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();

                document.querySelectorAll('#dimensionsTabs button')
                    .forEach(el => {
                        el.classList.remove('btn-primary');
                        el.classList.add('btn-outline-primary');
                    });
                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary');

                const category = this.dataset.category;
                loadQuestionnaire(category);
            });
        });
    }

    async function loadQuestionnaire(category) {
        const response = await fetch(`/Patient/${patientId}/GetQuestionsClinique`);
        const data = await response.json();
        const container = document.getElementById('questionnaireContainer');
        container.innerHTML = '';

        for (const subCategory in data) {
            if (category !== "Toutes" && subCategory !== category) continue;
            const questions = data[subCategory];

            const subCatDiv = document.createElement('div');
            subCatDiv.classList.add('mb-4');

            const title = document.createElement('h5');
            title.classList.add('fw-bold', 'text-primary', 'mb-3');
            title.textContent = subCategory;
            subCatDiv.appendChild(title);

            questions.forEach((q, index) => {
                const questionDiv = document.createElement('div');
                questionDiv.classList.add('card', 'border-0', 'shadow-sm', 'mb-3');

                const cardBody = document.createElement('div');
                cardBody.classList.add('card-body', 'p-3', 'p-md-4');

                const questionText = document.createElement('p');
                questionText.classList.add('fw-medium', 'mb-3');
                questionText.innerHTML = `${q.question}`;
                cardBody.appendChild(questionText);

                if (q.options && q.options.length > 0) {
                    const optionsDiv = document.createElement('div');
                    optionsDiv.classList.add('d-flex', 'flex-wrap', 'gap-3', 'mb-3');
                    q.options.forEach(opt => {
                        const div = document.createElement('div');
                        div.classList.add('form-check');
                        div.innerHTML = `
                            <input class="form-check-input" type="radio" name="q_${index}" value="${opt}">
                            <label class="form-check-label">${opt}</label>
                        `;
                        optionsDiv.appendChild(div);
                    });
                    cardBody.appendChild(optionsDiv);
                }

                const toggleBtn = document.createElement('button');
                toggleBtn.type = 'button';
                toggleBtn.classList.add('btn', 'btn-sm', 'btn-outline-secondary', 'fw-medium');
                toggleBtn.innerHTML = '<i class="bi bi-pencil me-1"></i>Ajouter une note';
                cardBody.appendChild(toggleBtn);

                const notesContainer = document.createElement('div');
                notesContainer.style.display = 'none';
                notesContainer.classList.add('mt-3');

                const notesLabel = document.createElement('label');
                notesLabel.classList.add('form-label', 'fw-medium', 'small', 'text-secondary');
                notesLabel.textContent = 'Notes';
                notesContainer.appendChild(notesLabel);

                const textarea = document.createElement('textarea');
                textarea.classList.add('form-control');
                textarea.name = `notes_${index}`;
                textarea.rows = 3;
                textarea.placeholder = 'Notes (optionnel)';
                notesContainer.appendChild(textarea);

                cardBody.appendChild(notesContainer);
                questionDiv.appendChild(cardBody);

                toggleBtn.addEventListener('click', () => {
                    if (notesContainer.style.display === 'none') {
                        notesContainer.style.display = 'block';
                        toggleBtn.innerHTML = '<i class="bi bi-eye-slash me-1"></i>Masquer la note';
                    } else {
                        notesContainer.style.display = 'none';
                        toggleBtn.innerHTML = '<i class="bi bi-pencil me-1"></i>Ajouter une note';
                    }
                });

                subCatDiv.appendChild(questionDiv);
            });

            container.appendChild(subCatDiv);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        initializeTabs();
        loadQuestionnaire('Toutes');
    });
</script>