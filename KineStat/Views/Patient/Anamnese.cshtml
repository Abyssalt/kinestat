@model KineStat.Models.Patient

@{
    ViewData["Title"] = "Anamnèse";
    ViewData["PatientId"] = Model.Id.ToString();
    ViewData["HideFloatingEye"] = true;
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Index'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Anamnèse</li>";
    var patientId = ViewData["PatientId"];
}

<div class="container-fluid px-2 px-sm-3 px-lg-4 py-3 py-md-4">

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 class="h2 fw-bold text-primary mb-2">
                    <i class="bi bi-clipboard-pulse me-2"></i>Anamnèse
                </h1>
                <p class="text-secondary mb-0">@Model.FirstName @Model.LastName</p>
            </div>
            <a asp-controller="Index" asp-action="Index" class="btn btn-outline-secondary fw-medium btn-tablet-lg">
                <i class="bi bi-arrow-left me-2"></i>Retour à la liste
            </a>
        </div>
        <hr class="border-primary border-2 opacity-25 mt-3">
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<form asp-controller="Patient" asp-action="SaveAnamnese" method="post">
    <div class="card border-0 shadow mb-4">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-person-badge me-2"></i>Informations administratives
                </h5>
                <button type="button"
                            class="btn btn-warning fw-medium btn-tablet-lg edit-patient-btn"
                        title="Modifier"
                        data-id="@Model.Id"
                        data-lastname="@Model.LastName"
                        data-firstname="@Model.FirstName"
                        data-email="@Model.Email"
                        data-phonenumber="@Model.PhoneNumber"
                        data-status="@((int)Model.Status)"
                        data-gender="@((int)Model.Gender)"
                        data-birthdate="@Model.BirthDate.ToString("yyyy-MM-dd")"
                        data-socialsecuritynumber="@(Model.SocialSecurityNumber ?? "")"
                        data-physioid="@(Model.PhysioId)"
                        data-weight="@(Model.Weight?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                        data-height="@(Model.Height?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                        data-doctorid="@(Model.DoctorId?.ToString() ?? "")"
                        data-address="@(Model.Address ?? "")"
                        data-country="@(Model.Country)">
                    <i class="bi bi-pencil me-1"></i>Modifier
                </button>
            </div>
        </div>
        <div id="adminInfo" class="collapse show">
            <div class="card-body p-3 p-md-4">
                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Nom</label>
                        <p class="form-control-plaintext mb-0">@Model.LastName</p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Prénom</label>
                        <p class="form-control-plaintext mb-0">@Model.FirstName</p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Statut</label>
                        <p class="form-control-plaintext mb-0">
                            <span class="badge fs-6 px-3 py-2
                            @(Model.Status == PatientStatus.Actif || Model.Status == PatientStatus.Terminé ? "bg-success" :
                                                                  Model.Status == PatientStatus.Inactif ? "bg-dark" :
                            Model.Status == PatientStatus.Abandonné ? "bg-danger" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Genre</label>
                        <p class="form-control-plaintext mb-0">
                            @(Model.Gender == KineStat.Models.Gender.Homme ? "Homme" : Model.Gender == KineStat.Models.Gender.Femme ? "Femme" : "Autre")
                        </p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Date de naissance</label>
                        <p class="form-control-plaintext mb-0">@(Model.BirthDate.ToString("dd/MM/yyyy"))</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Adresse</label>
                        <p class="form-control-plaintext mb-0">@(Model.Address ?? "Non renseignée")</p>
                    </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Pays</label>
                            <p class="form-control-plaintext mb-0"> @(Model.Country.ToString() ?? "Non renseigné")</p>
                        </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Téléphone</label>
                        <p class="form-control-plaintext mb-0">
                            <a href="tel:@Model.PhoneNumber" class="text-decoration-none">@Model.PhoneNumber</a>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Email</label>
                        <p class="form-control-plaintext mb-0">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Poids (kg)</label>
                        <p class="form-control-plaintext mb-0">@(Model.Weight?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Non renseigné")</p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Taille (cm)</label>
                        <p class="form-control-plaintext mb-0">@(Model.Height?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Non renseignée")</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">N° Sécurité sociale</label>
                        <p class="form-control-plaintext mb-0">@(Model.SocialSecurityNumber ?? "Non renseigné")</p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Médecin traitant</label>
                        <p class="form-control-plaintext mb-0">
                            @if (Model.Doctor != null)
                            {
                                <text>Dr. @Model.Doctor.FirstName @Model.Doctor.LastName</text>
                            }
                            else
                            {
                                <text>Non renseigné</text>
                            }
                        </p>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">N° INAMI du médecin</label>
                        <p class="form-control-plaintext mb-0">@(Model.Doctor?.NumeroINAMI ?? "Non renseigné")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow mb-4">
        <div class="card-header bg-success text-white py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <h5 class="mb-0 fw-bold" data-bs-toggle="collapse" data-bs-target="#medicalInfo" role="button" aria-expanded="true" aria-controls="medicalInfoCollapse">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Informations médicales
                </h5>
                <button type="button"
                            class="btn btn-light fw-medium btn-tablet-lg edit-medical-btn"
                        title="Modifier"
                        data-profession="@(Model.Profession ?? "")"
                        data-activites="@(Model.ActivitesPhysiques ?? "")"
                        data-antecedents="@(Model.AntecedentsMedicaux ?? "")"
                        data-medication="@(Model.MedicationActuelle ?? "")">
                    <i class="bi bi-pencil me-1"></i>Modifier
                </button>
            </div>
        </div>
        <div id="medicalInfo" class="collapse show">
            <div class="card-body p-3 p-md-4">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Profession</label>
                        <p class="form-control-plaintext mb-0">@(Model.Profession ?? "Non renseignée")</p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Activités physiques</label>
                        <p class="form-control-plaintext mb-0 white-space-pre-line">@(Model.ActivitesPhysiques ?? "Non renseignées")</p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Antécédents médicaux</label>
                        <p class="form-control-plaintext mb-0 white-space-pre-line">@(Model.AntecedentsMedicaux ?? "Non renseignés")</p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Médication actuelle</label>
                        <p class="form-control-plaintext mb-0 white-space-pre-line">@(Model.MedicationActuelle ?? "Non renseignée")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow mb-4">
        <div class="card-header bg-info text-white py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <h5 class="mb-0 fw-bold" data-bs-toggle="collapse" data-bs-target="#dossiersCollapse" role="button" aria-expanded="true" aria-controls="dossiersCollapse">
                    <i class="bi bi-folder2-open me-2"></i>Dossiers
                </h5>
                <a asp-controller="Folder"
                   asp-action="CreateFolder"
                   asp-route-id="@Model.Id"
                       class="btn btn-light fw-medium btn-tablet-lg">
                    <i class="bi bi-plus-circle me-1"></i>Nouveau dossier
                </a>
            </div>
        </div>
        <div id="dossiersCollapse" class="collapse show">
            <div class="card-body p-3 p-md-4">
                @if (!Model.Dossiers.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-folder display-4 text-secondary"></i>
                        <p class="text-secondary mt-3 mb-0">Aucun dossier pour ce patient</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var dossier in Model.Dossiers.OrderByDescending(d => d.DateOuverture))
                        {
                            <a asp-controller="Folder" asp-action="DossierDetails"
                               asp-route-id="@dossier.Id"
                               class="list-group-item list-group-item-action border-0 border-bottom px-0 py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 fw-semibold">
                                            <i class="bi bi-folder text-info me-2"></i>@dossier.Titre
                                        </h6>
                                        <small class="text-secondary">
                                            <i class="bi bi-calendar3 me-1"></i>Ouvert le @dossier.DateOuverture.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                    <i class="bi bi-chevron-right text-secondary"></i>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</form>
</div>
<!--Medical Informations modal-->
<div class="modal fade" id="editMedicalModal" tabindex="-1" aria-labelledby="editMedicalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="editMedicalModalLabel">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Modifier les informations médicales
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editMedicalForm" asp-controller="Patient" asp-action="UpdateMedicalInfo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PatientId" value="@Model.Id">

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Profession</label>
                            <input type="text" class="form-control medical-field" id="edit_Profession" name="Profession">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Activités physiques</label>
                            <textarea class="form-control medical-field" id="edit_ActivitesPhysiques" name="ActivitesPhysiques" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Antécédents médicaux</label>
                            <textarea class="form-control medical-field" id="edit_AntecedentsMedicaux" name="AntecedentsMedicaux" rows="4"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Médication actuelle</label>
                            <textarea class="form-control medical-field" id="edit_MedicationActuelle" name="MedicationActuelle" rows="3"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary fw-medium btn-tablet-lg" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveMedicalBtn" class="btn btn-success fw-medium btn-tablet-lg">
                    <i class="bi bi-save me-2"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<!--Add modal-->
<div class="modal fade" id="editPatientModal" tabindex="-1" aria-labelledby="editPatientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning py-3">
                <h5 class="modal-title fw-bold" id="editPatientModalLabel">
                    <i class="bi bi-pencil me-2"></i>Modifier le patient
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editPatientForm" asp-controller="Patient" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit_Id" name="Id">
                    
                    <input type="hidden" id="edit_newDoctorLastName_hidden" name="NewDoctorLastName" value="">
                    <input type="hidden" id="edit_newDoctorFirstName_hidden" name="NewDoctorFirstName" value="">
                    <input type="hidden" id="edit_newDoctorINAMI_hidden" name="NewDoctorINAMI" value="">

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Nom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_LastName" name="LastName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Prénom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_FirstName" name="FirstName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Statut</label>
                            <select class="form-select edit-field" id="edit_Status" name="Status" data-validation="select">
                                <option value="0">Actif</option>
                                <option value="1">Terminé</option>
                                <option value="2">Inactif</option>
                                <option value="3">Abandonné</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Genre <span class="text-danger">*</span></label>
                            <select class="form-select edit-field" id="edit_Gender" name="Gender" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Date de naissance <span class="text-danger">*</span></label>
                            <input type="date" class="form-control edit-field" id="edit_BirthDate" name="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control edit-field" id="edit_Email" name="Email" data-validation="email" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Téléphone <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control edit-field" id="edit_PhoneNumber" name="PhoneNumber" data-validation="phone" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Adresse</label>
                            <input type="text" class="form-control edit-field" id="edit_Address" name="Address">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">
                                Pays <span class="text-danger">*</span>
                            </label>
                            <select class="form-select edit-field"
                                    id="edit_Country"
                                    name="Country"
                                    data-validation="select"
                                    required>
                                <option value="">-- Sélectionner un pays --</option>
                                <option value="0">Belgique</option>
                                <option value="1">France</option>
                                <option value="2">Luxembourg</option>
                                <option value="3">Suisse</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">N° Sécurité sociale <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_SocialSecurityNumber" name="SocialSecurityNumber" data-validation="SocialSecNumber" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Kinésithérapeute <span class="text-danger">*</span></label>
                            <select class="form-select edit-field" id="edit_PhysioId" name="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control edit-field" id="edit_Weight" name="Weight" data-validation="decimal">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control edit-field" id="edit_Height" name="Height" data-validation="decimal">
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark px-2 py-1 rounded d-inline-block">Médecin traitant</label>
                            <select class="form-select edit-field" name="DoctorId" id="edit_DoctorSelect">
                                <option value="">-- Aucun médecin --</option>
                                @if (ViewBag.Doctors != null)
                                {
                                    @foreach (var doctor in ViewBag.Doctors)
                                    {
                                        <option value="@doctor.Id" data-inami="@doctor.NumeroINAMI">
                                            Dr. @doctor.FirstName @doctor.LastName (INAMI: @doctor.NumeroINAMI)
                                        </option>
                                    }
                                }
                            </select>
                            <div class="mt-2" id="edit_addDoctorBtnContainer" style="display: none;">
                                <button type="button" class="btn btn-sm btn-outline-primary btn-tablet-lg" id="edit_addDoctorBtn">
                                    <i class="bi bi-plus-circle me-1"></i>Ajouter un nouveau médecin
                                </button>
                            </div>
                        </div>

                        <div class="col-12 collapse" id="editAddDoctorSection">
                            <div class="card mt-2 border-primary">
                                <div class="card-body">
                                    <h6 class="text-uppercase text-muted small fw-semibold mb-3">
                                        <i class="bi bi-person-plus me-2"></i>Nouveau médecin
                                    </h6>
                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">Nom *</label>
                                            <input type="text" class="form-control" id="edit_newDoctorLastName" required>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">Prénom *</label>
                                            <input type="text" class="form-control" id="edit_newDoctorFirstName" required>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">N° INAMI *</label>
                                            <input type="text" class="form-control" id="edit_newDoctorINAMI" 
                                                   placeholder="11 chiffres sans tirets" 
                                                   maxlength="11"
                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary fw-medium btn-tablet-lg" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-secondary fw-medium btn-tablet-lg" disabled>
                    <i class="bi bi-save me-2"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ========== TABLET ========== */
        @@media (min-width: 768px) and (max-width: 1199px) {
            .container-fluid {
                max-width: 100% !important;
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .card-body {
                padding: 1.25rem !important;
            }
                .card-body .row > .col-md-4 {
                    flex: 0 0 50%;
                    max-width: 50%;
                }
        }

        @@media (min-width: 768px) and (max-width: 1199px) {
            .modal-dialog.modal-xl {
                max-width: 95% !important;
                margin: 1rem auto;
            }
        }

        .is-valid-custom {
            border-color: #198754 !important;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        .is-invalid-custom {
            border-color: #dc3545 !important;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        .white-space-pre-line {
            white-space: pre-line;
        }
    </style>

    <script>
        // ========== VALIDATION ==========
        function validateField(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (!isRequired && !value) {
                return true;
            }

            if (isRequired && !value) {
                return false;
            }

            switch (validationType) {
                case 'text':
                    const textRegex = /^[a-zA-ZÀ-ÿ\s\-']+$/;
                    return value.length >= 1 && textRegex.test(value);

                case 'email':
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    return emailRegex.test(value);

                case 'phone':
                    const phoneRegex = /^[\d\s\+\-\(\)]+$/;
                    const digitsOnly = value.replace(/[\s\+\-\(\)]/g, '');
                    return phoneRegex.test(value) && digitsOnly.length >= 9;

                case 'number':
                    const numRegex = /^\d+$/;
                    if (!numRegex.test(value)) return false;
                    const num = parseInt(value);
                    return !isNaN(num) && num > 0;

                case 'inami':
                    if (!value) return true;
                    const inamiRegex = /^\d+$/;
                    return inamiRegex.test(value);

                case 'decimal':
                    if (!value) return true;
                    const dec = parseFloat(value);
                    return !isNaN(dec) && dec > 0;

                case 'date':
                    if (!value) return false;
                    const date = new Date(value);
                    const now = new Date();
                    return date < now;

                case 'select':
                    return value !== '';

                case 'SocialSecNumber':
                    if (!value) return false;
                    const nissClean = value.replace(/[\s\.\-]/g, '');
                    if (!/^\d{11}$/.test(nissClean)) return false;

                    const year = parseInt(nissClean.substring(0, 2));
                    const month = parseInt(nissClean.substring(2, 4));
                    const day = parseInt(nissClean.substring(4, 6));
                    const checkDigits = parseInt(nissClean.substring(9, 11));

                    const validMonths = (month >= 1 && month <= 12) ||
                        (month >= 21 && month <= 32) ||
                        (month >= 41 && month <= 52) ||
                        (month >= 61 && month <= 72);
                    if (!validMonths) return false;
                    if (day < 1 || day > 31) return false;

                    let baseNumber = parseInt(nissClean.substring(0, 9));
                    let calculatedCheck = 97 - (baseNumber % 97);

                    if (calculatedCheck !== checkDigits) {
                        baseNumber = parseInt('2' + nissClean.substring(0, 9));
                        calculatedCheck = 97 - (baseNumber % 97);
                    }

                    return calculatedCheck === checkDigits;

                default:
                    return value.length > 0;
            }
        }

        function updateFieldVisualState(input) {
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (value === '' && !isRequired) {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
                return;
            }

            if (value === '') {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
                return;
            }

            const isValid = validateField(input);

            if (isValid) {
                input.classList.remove('is-invalid-custom');
                input.classList.add('is-valid-custom');
            } else {
                input.classList.remove('is-valid-custom');
                input.classList.add('is-invalid-custom');
            }
        }

        // ========== EDIT FORM ==========
        function areEditRequiredFieldsFilled() {
            const requiredInputs = document.querySelectorAll('.edit-field[required]');

            for (let input of requiredInputs) {
                const value = input.value.trim();

                if (!value || value === '') {
                    return false;
                }

                if (!validateField(input)) {
                    return false;
                }
            }

            return true;
        }

        function updateEditButton() {
            const btn = document.getElementById('saveEditBtn');
            const allValid = areEditRequiredFieldsFilled();

            if (allValid) {
                btn.disabled = false;
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-warning');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-secondary');
            }
        }

        // ========== EVENT LISTENERS ==========
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.edit-field').forEach(input => {
                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });

                input.addEventListener('blur', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });

                input.addEventListener('change', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });
            });

        document.getElementById('saveEditBtn').addEventListener('click', async function(e) {
            e.preventDefault();

            if (areEditRequiredFieldsFilled()) {
                const selectedDoctorId = document.getElementById('edit_DoctorSelect').value;

                if (selectedDoctorId === '') {
                    const dLastName = document.getElementById('edit_newDoctorLastName').value.trim();
                    const dFirstName = document.getElementById('edit_newDoctorFirstName').value.trim();
                    const dInami = document.getElementById('edit_newDoctorINAMI').value.trim();

                    if (dLastName || dFirstName || dInami) {
                        if (!dLastName || !dFirstName || !dInami) {
                            alert("Veuillez remplir tous les champs pour le nouveau médecin (Nom, Prénom et INAMI).");
                            return;
                        }
                        if (!/^\d{11}$/.test(dInami)) {
                            alert("Le numéro INAMI doit contenir exactement 11 chiffres.");
                            const inamiInput = document.getElementById('edit_newDoctorINAMI');
                            inamiInput.classList.add('is-invalid-custom');
                            inamiInput.focus();
                            return;
                        }
                    }

                    document.getElementById('edit_newDoctorLastName_hidden').value = dLastName;
                    document.getElementById('edit_newDoctorFirstName_hidden').value = dFirstName;
                    document.getElementById('edit_newDoctorINAMI_hidden').value = dInami;
                } else {
                    document.getElementById('edit_newDoctorLastName_hidden').value = '';
                    document.getElementById('edit_newDoctorFirstName_hidden').value = '';
                    document.getElementById('edit_newDoctorINAMI_hidden').value = '';
                }

                document.getElementById('editPatientForm').submit();
            }
        });

            document.querySelectorAll('.edit-patient-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const data = this.dataset;

                    document.getElementById('edit_Id').value = data.id;
                    document.getElementById('edit_LastName').value = data.lastname;
                    document.getElementById('edit_FirstName').value = data.firstname;
                    document.getElementById('edit_Email').value = data.email;
                    document.getElementById('edit_PhoneNumber').value = data.phonenumber;
                    document.getElementById('edit_Address').value = data.address || '';
                    document.getElementById('edit_Gender').value = data.gender;
                    document.getElementById('edit_Status').value = data.status;
                    document.getElementById('edit_BirthDate').value = data.birthdate;
                    document.getElementById('edit_SocialSecurityNumber').value = data.socialsecuritynumber;
                    document.getElementById('edit_PhysioId').value = data.physioid;
                    document.getElementById('edit_Weight').value = data.weight;
                    document.getElementById('edit_Height').value = data.height;
                    document.getElementById('edit_DoctorSelect').value = data.doctorid || '';
                    document.getElementById('edit_Country').value = data.country;

                    const editModal = new bootstrap.Modal(document.getElementById('editPatientModal'));
                    editModal.show();

                    setTimeout(() => {
                        document.querySelectorAll('.edit-field').forEach(input => {
                            if (input.value.trim()) {
                                updateFieldVisualState(input);
                            }
                        });
                        updateEditButton();
                        updateEditAddDoctorButtonVisibility();
                    }, 150);
                });
            });

            document.getElementById('edit_newDoctorINAMI').addEventListener('input', function(e) {
                const val = e.target.value;
                e.target.classList.remove('is-valid-custom', 'is-invalid-custom');
    
                if (val.length === 0) return;

                if (/^\d{11}$/.test(val)) {
                    e.target.classList.add('is-valid-custom');
                } else {
                    e.target.classList.add('is-invalid-custom');
                }
                    });
            
            const editDoctorSelect = document.getElementById('edit_DoctorSelect');
            const editAddDoctorBtnContainer = document.getElementById('edit_addDoctorBtnContainer');
            const editAddDoctorBtn = document.getElementById('edit_addDoctorBtn');
            const editAddDoctorSection = document.getElementById('editAddDoctorSection');
            
            function updateEditAddDoctorButtonVisibility() {
                const selectedValue = editDoctorSelect.value;
                
                if (selectedValue === '') {
                    editAddDoctorBtnContainer.style.display = 'block';
                } else {
                    editAddDoctorBtnContainer.style.display = 'none';
                    
                    const bsCollapse = bootstrap.Collapse.getInstance(editAddDoctorSection);
                    if (bsCollapse) {
                        bsCollapse.hide();
                    }
                    
                    document.getElementById('edit_newDoctorLastName').value = '';
                    document.getElementById('edit_newDoctorFirstName').value = '';
                    document.getElementById('edit_newDoctorINAMI').value = '';
                }
            }
            
            editDoctorSelect.addEventListener('change', updateEditAddDoctorButtonVisibility);
            
            editAddDoctorBtn.addEventListener('click', function() {
                const bsCollapse = new bootstrap.Collapse(editAddDoctorSection, { toggle: true });
            });
        });

        // ========== MODAL EVENTS ==========
        document.getElementById('editPatientModal').addEventListener('shown.bs.modal', function() {
            updateEditButton();
        });

        document.getElementById('editPatientModal').addEventListener('hidden.bs.modal', function() {
            document.querySelectorAll('.edit-field').forEach(input => {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
            });
        });

        // ========== MEDICAL MODAL ==========
        document.querySelectorAll('.edit-medical-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const data = this.dataset;

                document.getElementById('edit_Profession').value = data.profession || '';
                document.getElementById('edit_ActivitesPhysiques').value = data.activites || '';
                document.getElementById('edit_AntecedentsMedicaux').value = data.antecedents || '';
                document.getElementById('edit_MedicationActuelle').value = data.medication || '';

                const medicalModal = new bootstrap.Modal(document.getElementById('editMedicalModal'));
                medicalModal.show();
            });
        });

        document.getElementById('saveMedicalBtn').addEventListener('click', function() {
            document.getElementById('editMedicalForm').submit();
        });
    </script>
}
