@model KineStat.Models.Patient

@{
    ViewData["Title"] = "Anamnèse";
    ViewData["PatientId"] = Model.Id.ToString();
    ViewData["HideFloatingEye"] = true;
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Anamnèse - {Model.FirstName} {Model.LastName}</li>";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-clipboard-pulse me-2"></i>Anamnèse
                    </h1>
                    <p class="text-secondary mb-0">@Model.FirstName @Model.LastName</p>
                </div>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    <form asp-controller="Patient" asp-action="SaveAnamnese" method="post">
        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge me-2"></i>Informations administratives
                    </h5>
                    <button type="button"
                            class="btn btn-warning btn-sm fw-medium edit-patient-btn"
                            title="Modifier"
                            data-id="@Model.Id"
                            data-lastname="@Model.LastName"
                            data-firstname="@Model.FirstName"
                            data-email="@Model.Email"
                            data-phonenumber="@Model.PhoneNumber"
                            data-status="@((int)Model.Status)"
                            data-gender="@((int)Model.Gender)"
                            data-birthdate="@Model.BirthDate.ToString("yyyy-MM-dd")"
                            data-socialsecuritynumber="@(Model.SocialSecurityNumber ?? "")"
                            data-physioid="@(Model.PhysioId)"
                            data-weight="@(Model.Weight?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-height="@(Model.Height?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-doctorname="@(Model.DoctorName ?? "")"
                            data-doctorinami="@(Model.DoctorINAMI ?? "")"
                            data-address="@(Model.Address ?? "")">
                        <i class="bi bi-pencil me-1"></i>Modifier
                    </button>
                </div>
            </div>
            <div id="adminInfo" class="collapse show">
                <div class="card-body p-3 p-md-4">
                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Nom</label>
                            <p class="form-control-plaintext fw-semibold mb-0">@Model.LastName</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Prénom</label>
                            <p class="form-control-plaintext fw-semibold mb-0">@Model.FirstName</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Statut</label>
                            <p class="form-control-plaintext mb-0">
                                <span class="badge fs-6 px-3 py-2
                            @(Model.Status == PatientStatus.Actif || Model.Status == PatientStatus.Terminé ? "bg-success" :
                                                                    Model.Status == PatientStatus.Suspendu ? "bg-warning" :
                                                                    Model.Status == PatientStatus.Abandonné ? "bg-danger" : "bg-secondary")">
                                    @Model.Status
                                </span>
                            </p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Genre</label>
                            <p class="form-control-plaintext mb-0">
                                @(Model.Gender == KineStat.Models.Gender.Homme ? "Homme" : Model.Gender == KineStat.Models.Gender.Femme ? "Femme" : "Autre")
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Date de naissance</label>
                            <p class="form-control-plaintext mb-0">@(Model.BirthDate.ToString("dd/MM/yyyy"))</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Adresse</label>
                            <p class="form-control-plaintext mb-0">@(Model.Address ?? "Non renseignée")</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Téléphone</label>
                            <p class="form-control-plaintext mb-0">
                                <a href="tel:@Model.PhoneNumber" class="text-decoration-none">@Model.PhoneNumber</a>
                            </p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Email</label>
                            <p class="form-control-plaintext mb-0">
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            </p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Poids (kg)</label>
                            <p class="form-control-plaintext mb-0">@(Model.Weight?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Non renseigné")</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Taille (cm)</label>
                            <p class="form-control-plaintext mb-0">@(Model.Height?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Non renseignée")</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">N° Sécurité sociale</label>
                            <p class="form-control-plaintext mb-0">@(Model.SocialSecurityNumber ?? "Non renseigné")</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">Médecin traitant</label>
                            <p class="form-control-plaintext mb-0">@(Model.DoctorName ?? "Non renseigné")</p>
                        </div>
                        <div class="col-12 col-md-4 mb-3">
                            <label class="form-label fw-medium text-secondary small">N° INAMI du médecin</label>
                            <p class="form-control-plaintext mb-0">@(Model.DoctorINAMI ?? "Non renseigné")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-success text-white py-3" data-bs-toggle="collapse" data-bs-target="#medicalInfo" role="button" aria-expanded="false" aria-controls="medicalInfo">
                <h5 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Informations médicales
                    <i class="bi bi-chevron-down ms-auto"></i>
                </h5>
            </div>
            <div id="medicalInfo" class="collapse">
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium">Profession</label>
                            <input type="text" class="form-control" name="Profession" placeholder="Profession du patient">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Activités physiques</label>
                            <textarea class="form-control" name="ActivitesPhysiques" rows="3" placeholder="Décrivez les activités physiques du patient"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Antécédents médicaux</label>
                            <textarea class="form-control" name="AntecedentsMedicaux" rows="4" placeholder="Listez les antécédents médicaux"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Médication actuelle</label>
                            <textarea class="form-control" name="MedicationActuelle" rows="3" placeholder="Listez les médicaments actuels"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-info text-white py-3">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <h5 class="mb-0 fw-bold" data-bs-toggle="collapse" data-bs-target="#dossiersCollapse" role="button" aria-expanded="true" aria-controls="dossiersCollapse">
                        <i class="bi bi-folder2-open me-2"></i>Dossiers
                    </h5>
                    <a asp-controller="Patient"
                       asp-action="CreateDossier"
                       asp-route-id="@Model.Id"
                       class="btn btn-light btn-sm fw-medium">
                        <i class="bi bi-plus-circle me-1"></i>Nouveau dossier
                    </a>
                </div>
            </div>
            <div id="dossiersCollapse" class="collapse show">
                <div class="card-body p-3 p-md-4">
                    @if (!Model.Dossiers.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-folder display-4 text-secondary"></i>
                            <p class="text-secondary mt-3 mb-0">Aucun dossier pour ce patient</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var dossier in Model.Dossiers.OrderByDescending(d => d.DateOuverture))
                            {
                                <a asp-action="DossierDetails"
                                   asp-route-id="@dossier.Id"
                                   class="list-group-item list-group-item-action border-0 border-bottom px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-semibold">
                                                <i class="bi bi-folder text-info me-2"></i>@dossier.Titre
                                            </h6>
                                            <small class="text-secondary">
                                                <i class="bi bi-calendar3 me-1"></i>Ouvert le @dossier.DateOuverture.ToString("dd/MM/yyyy")
                                            </small>
                                        </div>
                                        <i class="bi bi-chevron-right text-secondary"></i>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="editPatientModal" tabindex="-1" aria-labelledby="editPatientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning py-3">
                <h5 class="modal-title fw-bold" id="editPatientModalLabel">
                    <i class="bi bi-pencil me-2"></i>Modifier le patient
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editPatientForm" asp-controller="Patient" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit_Id" name="Id">

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Nom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_LastName" name="LastName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Prénom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_FirstName" name="FirstName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-medium">Statut</label>
                            <select class="form-select edit-field" id="edit_Status" name="Status" data-validation="select">
                                <option value="0">Actif</option>
                                <option value="1">Terminé</option>
                                <option value="2">Suspendu</option>
                                <option value="3">Abandonné</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-medium">Genre <span class="text-danger">*</span></label>
                            <select class="form-select edit-field" id="edit_Gender" name="Gender" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-medium">Date de naissance <span class="text-danger">*</span></label>
                            <input type="date" class="form-control edit-field" id="edit_BirthDate" name="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control edit-field" id="edit_Email" name="Email" data-validation="email" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Téléphone <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control edit-field" id="edit_PhoneNumber" name="PhoneNumber" data-validation="phone" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Adresse</label>
                            <input type="text" class="form-control edit-field" id="edit_Address" name="Address">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">N° Sécurité sociale <span class="text-danger">*</span></label>
                            <input type="text" class="form-control edit-field" id="edit_SocialSecurityNumber" name="SocialSecurityNumber" data-validation="SocialSecNumber" required>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Kinésithérapeute <span class="text-danger">*</span></label>
                            <select class="form-select edit-field" id="edit_PhysioId" name="PhysioId" data-validation="select" required>
                                <option value="">-- Sélectionner un kiné --</option>
                                @if (ViewBag.Physios != null)
                                {
                                    @foreach (var physio in ViewBag.Physios)
                                    {
                                        <option value="@physio.Id">@physio.FirstName @physio.LastName (INAMI: @physio.INAMINumber)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Poids (kg)</label>
                            <input type="number" step="0.1" class="form-control edit-field" id="edit_Weight" name="Weight" data-validation="decimal">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Taille (cm)</label>
                            <input type="number" step="0.1" class="form-control edit-field" id="edit_Height" name="Height" data-validation="decimal">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">Médecin traitant</label>
                            <input type="text" class="form-control edit-field" id="edit_DoctorName" name="DoctorName">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-medium">N° INAMI du médecin</label>
                            <input type="text" class="form-control edit-field" id="edit_DoctorINAMI" name="DoctorINAMI" data-validation="inami">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary fw-medium" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-warning fw-medium" disabled>
                    <i class="bi bi-save me-2"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ========== VALIDATION ==========
        function validateField(input) {
            const validationType = input.dataset.validation;
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (!isRequired && !value) {
                return true;
            }

            if (isRequired && !value) {
                return false;
            }

            switch (validationType) {
                case 'text':
                    const textRegex = /^[a-zA-ZÀ-ÿ\s\-']+$/;
                    return value.length >= 1 && textRegex.test(value);

                case 'email':
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    return emailRegex.test(value);

                case 'phone':
                    const phoneRegex = /^[\d\s\+\-\(\)]+$/;
                    const digitsOnly = value.replace(/[\s\+\-\(\)]/g, '');
                    return phoneRegex.test(value) && digitsOnly.length >= 9;

                case 'number':
                    const numRegex = /^\d+$/;
                    if (!numRegex.test(value)) return false;
                    const num = parseInt(value);
                    return !isNaN(num) && num > 0;

                case 'inami':
                    if (!value) return true;
                    const inamiRegex = /^\d+$/;
                    return inamiRegex.test(value);

                case 'decimal':
                    if (!value) return true;
                    const dec = parseFloat(value);
                    return !isNaN(dec) && dec > 0;

                case 'date':
                    if (!value) return false;
                    const date = new Date(value);
                    const now = new Date();
                    return date < now;

                case 'select':
                    return value !== '';

                case 'SocialSecNumber':
                    if (!value) return false;
                    const nissClean = value.replace(/[\s\.\-]/g, '');
                    if (!/^\d{11}$/.test(nissClean)) return false;

                    const year = parseInt(nissClean.substring(0, 2));
                    const month = parseInt(nissClean.substring(2, 4));
                    const day = parseInt(nissClean.substring(4, 6));
                    const checkDigits = parseInt(nissClean.substring(9, 11));

                    const validMonths = (month >= 1 && month <= 12) ||
                        (month >= 21 && month <= 32) ||
                        (month >= 41 && month <= 52) ||
                        (month >= 61 && month <= 72);
                    if (!validMonths) return false;
                    if (day < 1 || day > 31) return false;

                    let baseNumber = parseInt(nissClean.substring(0, 9));
                    let calculatedCheck = 97 - (baseNumber % 97);

                    if (calculatedCheck !== checkDigits) {
                        baseNumber = parseInt('2' + nissClean.substring(0, 9));
                        calculatedCheck = 97 - (baseNumber % 97);
                    }

                    return calculatedCheck === checkDigits;

                default:
                    return value.length > 0;
            }
        }

        // ========== EDIT FORM ==========
        function areEditRequiredFieldsFilled() {
            const requiredInputs = document.querySelectorAll('.edit-field[required]');

            for (let input of requiredInputs) {
                const value = input.value.trim();

                if (!value || value === '') {
                    return false;
                }

                if (!validateField(input)) {
                    return false;
                }
            }

            return true;
        }

        function updateEditButton() {
            const btn = document.getElementById('saveEditBtn');
            const allValid = areEditRequiredFieldsFilled();

            if (allValid) {
                btn.disabled = false;
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-warning');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-secondary');
            }
        }

        // ========== EVENT LISTENERS ==========
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.edit-field').forEach(input => {
                input.addEventListener('input', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });

                input.addEventListener('blur', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });

                input.addEventListener('change', function() {
                    updateFieldVisualState(this);
                    updateEditButton();
                });
            });

            document.getElementById('saveEditBtn').addEventListener('click', function() {
                if (areEditRequiredFieldsFilled()) {
                    document.getElementById('editPatientForm').submit();
                }
            });

            document.querySelectorAll('.edit-patient-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const data = this.dataset;

                    document.getElementById('edit_Id').value = data.id;
                    document.getElementById('edit_LastName').value = data.lastname;
                    document.getElementById('edit_FirstName').value = data.firstname;
                    document.getElementById('edit_Email').value = data.email;
                    document.getElementById('edit_PhoneNumber').value = data.phonenumber;
                    document.getElementById('edit_Address').value = data.address || '';
                    document.getElementById('edit_Gender').value = data.gender;
                    document.getElementById('edit_Status').value = data.status;
                    document.getElementById('edit_BirthDate').value = data.birthdate;
                    document.getElementById('edit_SocialSecurityNumber').value = data.socialsecuritynumber;
                    document.getElementById('edit_PhysioId').value = data.physioid;
                    document.getElementById('edit_Weight').value = data.weight;
                    document.getElementById('edit_Height').value = data.height;
                    document.getElementById('edit_DoctorName').value = data.doctorname || '';
                    document.getElementById('edit_DoctorINAMI').value = data.doctorinami || '';

                    const editModal = new bootstrap.Modal(document.getElementById('editPatientModal'));
                    editModal.show();

                    setTimeout(() => {
                        document.querySelectorAll('.edit-field').forEach(input => {
                            if (input.value.trim()) {
                                updateFieldVisualState(input);
                            }
                        });
                        updateEditButton();
                    }, 150);
                });
            });
        });

        // ========== MODAL EVENTS ==========
        document.getElementById('editPatientModal').addEventListener('shown.bs.modal', function() {
            updateEditButton();
        });

        document.getElementById('editPatientModal').addEventListener('hidden.bs.modal', function() {
            document.querySelectorAll('.edit-field').forEach(input => {
                input.classList.remove('is-valid-custom', 'is-invalid-custom');
            });
        });
    </script>
}