@model KineStat.Models.Patient

@{
    ViewData["Title"] = "Anamnèse";
    ViewData["PatientId"] = Model.Id.ToString();
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item'><a href='/Patients'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Anamnèse - {Model.FirstName} {Model.LastName}</li>";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Anamnèse - @Model.FirstName @Model.LastName</h2>
        <a asp-controller="Patients" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <form asp-controller="Patient" asp-action="SaveAnamnese" method="post">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white" data-bs-toggle="collapse" data-bs-target="#adminInfo" style="cursor:pointer;">
                <h4 class="mb-0"><i class="bi bi-person-badge"></i> Informations administratives</h4>
            </div>
            <div id="adminInfo" class="collapse show">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nom</label>
                            <p class="form-control-plaintext">@Model.LastName</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Prénom</label>
                            <p class="form-control-plaintext">@Model.FirstName</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Genre</label>
                            <p class="form-control-plaintext">
                                @(Model.Gender == KineStat.Models.Gender.Homme ? "M" : Model.Gender == KineStat.Models.Gender.Femme ? "F" : "A")
                            </p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Date de naissance</label>
                            <p class="form-control-plaintext">@Model.BirthDate.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Âge</label>
                            <p class="form-control-plaintext">@((DateTime.Now.Year - Model.BirthDate.Year - (DateTime.Now.DayOfYear < Model.BirthDate.DayOfYear ? 1 : 0))) ans</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Date de première évaluation</label>
                            <p class="form-control-plaintext">@DateTime.Now.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Adresse</label>
                            <p class="form-control-plaintext">@(Model.Address ?? "Non renseignée")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Téléphone</label>
                            <p class="form-control-plaintext">@Model.PhoneNumber</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <p class="form-control-plaintext">@Model.Email</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Médecin traitant</label>
                            <p class="form-control-plaintext">@(Model.DoctorName ?? "Non renseigné")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">N° INAMI du médecin</label>
                            <p class="form-control-plaintext">@(Model.DoctorINAMI ?? "Non renseigné")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white" data-bs-toggle="collapse" data-bs-target="#medicalInfo" style="cursor:pointer;">
                <h4 class="mb-0"><i class="bi bi-clipboard2-pulse"></i> Informations médicales</h4>
            </div>
            <div id="medicalInfo" class="collapse">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Profession</label>
                            <input type="text" class="form-control" name="Profession" placeholder="">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Activités physiques</label>
                            <textarea class="form-control" name="ActivitesPhysiques" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Antécédents médicaux</label>
                            <textarea class="form-control" name="AntecedentsMedicaux" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Médication actuelle</label>
                            <textarea class="form-control" name="MedicationActuelle" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-danger text-white" data-bs-toggle="collapse" data-bs-target="#douleurInfo" style="cursor:pointer;">
                <h4 class="mb-0"><i class="bi bi-heart-pulse"></i> Douleur actuelle (SOCRATE)</h4>
            </div>
            <div id="douleurInfo" class="collapse">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">S - Site</label>
                            <input type="text" class="form-control" name="DouleurSite" placeholder="">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">O - Origine</label>
                            <textarea class="form-control" name="DouleurOrigine" rows="2" placeholder=""></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">C - Caractéristiques</label>
                            <textarea class="form-control" name="DouleurCaracteristiques" rows="2" placeholder=""></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">R - Radiations</label>
                            <input type="text" class="form-control" name="DouleurRadiations" placeholder="">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">A - Associations</label>
                            <textarea class="form-control" name="DouleurAssociations" rows="2" placeholder=""></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">T - Temporalité</label>
                            <textarea class="form-control" name="DouleurTemporalite" rows="2" placeholder=""></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">E - Empiré par</label>
                            <textarea class="form-control" name="DouleurEmpire" rows="3" placeholder=""></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Amélioré par</label>
                            <textarea class="form-control" name="DouleurAmeliore" rows="3" placeholder=""></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <div data-bs-toggle="collapse" data-bs-target="#bilanHistorique" style="cursor:pointer; flex-grow:1;">
                    <h4 class="mb-0"><i class="bi bi-clock-history"></i> Historique des bilans</h4>
                </div>
                <button type="button" class="btn btn-light btn-sm ms-2">
                    <i class="bi bi-plus-circle"></i> Nouveau bilan
                </button>
            </div>
            <div id="bilanHistorique" class="collapse">
                <div class="card-body">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><i class="bi bi-file-text"></i> Bilan du 25/10/2024</h6>
                                <small class="text-muted">Bilan complémentaire - Mathis P.</small>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-eye"></i> Voir
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Modifier
                                </button>
                            </div>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><i class="bi bi-file-text"></i> Bilan du 15/09/2024</h6>
                                <small class="text-muted">Bilan intermédiaire - Mathis P.</small>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-eye"></i> Voir
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Modifier
                                </button>
                            </div>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><i class="bi bi-file-text"></i> Bilan du 03/08/2024</h6>
                                <small class="text-muted">Bilan initial - Mathis P.</small>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-eye"></i> Voir
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Modifier
                                </button>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-warning text-dark" data-bs-toggle="collapse" data-bs-target="#profilClinique" style="cursor:pointer;">
                <h4 class="mb-0"><i class="bi bi-graph-up"></i> Profil clinique</h4>
            </div>
            <div id="profilClinique" class="collapse">
                <div class="card-body">
                </div>
            </div>
        </div>
    </form>
</div>