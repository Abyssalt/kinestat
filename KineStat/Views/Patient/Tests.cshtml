@using KineStat.Models
@{
    ViewData["Title"] = "Test Neurologique";

    // Descriptions des tests
    var descriptions = new Dictionary<int, string>
    {
        { 101, "Patient en décubitus dorsal, jambe tendue. Élever passivement la jambe. Positif si douleur irradiante dans le membre inférieur avant 70° d'élévation." },
        { 102, "Tester la sensibilité au toucher léger dans la région périnéale (zone en selle). Une diminution ou absence de sensibilité est un signe d'urgence." },
        { 103, "Patient assis, jambe pendante. Percuter le tendon rotulien avec un marteau réflexe. Normal : extension de la jambe." },
        { 104, "Patient en décubitus ventral ou assis. Percuter le tendon d'Achille. Normal : flexion plantaire du pied." },
        { 105, "Patient assis, genou fléchi à 90°. Demander d'étendre le genou contre résistance. Coter de 0 (aucune contraction) à 5 (force normale)." },
        { 106, "Observer la démarche du patient sur une distance de 10 mètres. Évaluer l'équilibre, la symétrie et les compensations." }
    };

    var cluster = new Cluster
    {
        Id = 1,
        Name = "Tests Neurologiques",
        Description = "Évaluation des atteintes neurologiques et sensitives du membre inférieur",
        Questions = new List<Question>
        {
            new QuestionBool
            {
                Id = 101,
                Title = "Test de Lasègue",
                RVPositif = 8,
                RVNegatif = 0
            },
            new QuestionBool
            {
                Id = 102,
                Title = "Test de sensibilité périnéale (anesthésie en selle)",
                RVPositif = 10,
                RVNegatif = 0
            },
            new QuestionBool
            {
                Id = 103,
                Title = "Réflexe rotulien",
                RVPositif = 5,
                RVNegatif = 0
            },
            new QuestionBool
            {
                Id = 104,
                Title = "Réflexe achilléen",
                RVPositif = 5,
                RVNegatif = 0
            },
            new QuestionLadder
            {
                Id = 105,
                Title = "Force musculaire - Extension du genou (échelle 0-5)",
                RVPositif = 6,
                RVNegatif = 0,
                min = 0,
                max = 5
            },
            new QuestionQCM
            {
                Id = 106,
                Title = "Évaluation de la démarche",
                RVPositif = 7,
                RVNegatif = 0,
                ListAnswers = new List<string>
                {
                    "Démarche normale",
                    "Boiterie légère",
                    "Boiterie marquée",
                    "Démarche antalgique sévère",
                    "Impossibilité de marcher"
                }
            }
        }
    };

    var patientNom = "PAUL Melvyn";
    var patientId = 1;
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item'><a href='/Patients'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Tests - Melvyn PAUL</li>";
}

<div class="container mt-4">
    <!-- En-tête -->
    <div class="card border-primary mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="text-primary mb-2">
                        <i class="bi bi-clipboard2-pulse me-2"></i>@cluster.Name
                    </h2>
                    <p class="text-muted mb-0">
                        <i class="bi bi-person-badge"></i> Patient : <strong>@patientNom</strong>
                        <span class="ms-3">
                            <i class="bi bi-calendar-event"></i> @DateTime.Now.ToString("dd/MM/yyyy - HH:mm")
                        </span>
                    </p>
                </div>
                <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@patientId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <!-- Description du cluster -->
    @if (!string.IsNullOrEmpty(cluster.Description))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Objectif :</strong> @cluster.Description
        </div>
    }

    <!-- Barre de progression -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">
                    <i class="bi bi-list-check"></i> Progression
                </h6>
                <span class="badge bg-primary" id="progressBadge">0 / @cluster.Questions.Count</span>
            </div>
            <div class="progress" style="height: 25px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     role="progressbar"
                     id="progressBar"
                     style="width: 0%"
                     aria-valuenow="0"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    0%
                </div>
            </div>
        </div>
    </div>

    <!-- Bouton pour ajouter un test/cluster spécifique -->
    <div class="mb-4">
        <button type="button" class="btn btn-outline-primary" onclick="toggleAddTestForm()">
            <i class="bi bi-plus-circle"></i> Ajouter un test ou cluster spécifique
        </button>

        <!-- Formulaire d'ajout de test (masqué par défaut) -->
        <div class="collapse mt-3" id="addTestForm">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-plus-square"></i> Ajouter un test personnalisé
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nom du test</label>
                            <input type="text" class="form-control" id="customTestName" placeholder="Ex: Test de Slump">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Type de test</label>
                            <select class="form-select" id="customTestType">
                                <option value="bool">Positif / Négatif</option>
                                <option value="scale">Échelle numérique</option>
                                <option value="text">Texte libre</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description / Protocole (optionnel)</label>
                        <textarea class="form-control" id="customTestDescription" rows="2" placeholder="Protocole d'exécution du test..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" onclick="addCustomTest()">
                            <i class="bi bi-check-circle"></i> Ajouter ce test
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="toggleAddTestForm()">
                            <i class="bi bi-x-circle"></i> Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form id="formTests" onsubmit="return handleSubmit(event)">
        <input type="hidden" name="clusterId" value="@cluster.Id">
        <input type="hidden" name="patientId" value="@patientId">

        <!-- Conteneur pour les tests (y compris les tests ajoutés dynamiquement) -->
        <div id="testsContainer">
            <!-- Liste des tests -->
            @{
                int testIndex = 0;
            }
            @foreach (var question in cluster.Questions)
            {
                testIndex++;
                <div class="card mb-3 test-card" id="test-@question.Id" data-test-id="@question.Id">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <h5 class="mb-2">
                                    <span class="badge bg-primary me-2">@testIndex</span>
                                    @question.Title
                                </h5>
                                <small class="text-muted">
                                    RV+ : <span class="badge bg-danger">@question.RVPositif</span>
                                </small>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <button type="button"
                                        class="btn btn-sm btn-outline-info"
                                        onclick="toggleDescription(@question.Id)"
                                        title="Voir le protocole">
                                    <i class="bi bi-journal-medical"></i> Protocole
                                </button>
                                <span class="badge bg-success answered-badge" id="badge-@question.Id" style="display: none;">
                                    <i class="bi bi-check-circle-fill"></i> Complété
                                </span>
                            </div>
                        </div>

                        <!-- Description du protocole -->
                        @if (descriptions.ContainsKey(question.Id))
                        {
                            <div class="alert alert-info mt-3 mb-0 collapse" id="description-@question.Id">
                                <small>
                                    <i class="bi bi-clipboard-check"></i>
                                    <strong>Protocole :</strong> @descriptions[question.Id]
                                </small>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        @if (question is QuestionBool)
                        {
                            <!-- Test Bool - Positif/Négatif -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Résultat</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio"
                                           class="btn-check"
                                           name="test-@question.Id-value"
                                           id="oui-@question.Id"
                                           value="true"
                                           onchange="markAsAnswered(@question.Id)">
                                    <label class="btn btn-outline-success btn-lg" for="oui-@question.Id">
                                        <i class="bi bi-check-circle-fill"></i> Positif
                                    </label>

                                    <input type="radio"
                                           class="btn-check"
                                           name="test-@question.Id-value"
                                           id="non-@question.Id"
                                           value="false"
                                           onchange="markAsAnswered(@question.Id)">
                                    <label class="btn btn-outline-secondary btn-lg" for="non-@question.Id">
                                        <i class="bi bi-x-circle-fill"></i> Négatif
                                    </label>
                                </div>
                            </div>

                            <!-- Bouton observations -->
                            <div class="mb-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="toggleObservations(@question.Id)">
                                    <i class="bi bi-chat-left-text"></i> Ajouter des observations
                                </button>
                            </div>

                            <!-- Zone d'observations (masquée par défaut) -->
                            <div class="collapse" id="observations-@question.Id">
                                <div class="card card-body bg-light">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat-left-dots"></i> Observations complémentaires
                                    </label>
                                    <textarea class="form-control"
                                      name="test-@question.Id-observations"
                                      rows="3"
                                      placeholder="Notez ici vos observations : douleur ressentie, côté affecté, compensations, limitations..."></textarea>
                                </div>
                            </div>
                        }
                        else if (question is QuestionLadder ladder)
                        {
                            <!-- Test Échelle - Slider -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    Valeur mesurée (@ladder.min - @ladder.max)
                                </label>
                                <input type="number"
                                       class="form-control form-control-lg mb-3"
                                       name="test-@question.Id-value"
                                       min="@ladder.min"
                                       max="@ladder.max"
                                       placeholder="Entrez la valeur"
                                       onchange="markAsAnswered(@question.Id); updateRangeFromInput(this, 'range-@question.Id', 'display-@question.Id')"
                                       id="input-@question.Id">

                                <label class="form-label small text-muted">Ou utilisez le curseur :</label>
                                <input type="range"
                                       class="form-range"
                                       id="range-@question.Id"
                                       min="@ladder.min"
                                       max="@ladder.max"
                                       value="@ladder.min"
                                       step="1"
                                       oninput="syncInputs(this, 'input-@question.Id', 'display-@question.Id')">
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted fw-semibold">@ladder.min</small>
                                    <span class="badge bg-primary fs-5" id="display-@question.Id">@ladder.min</span>
                                    <small class="text-muted fw-semibold">@ladder.max</small>
                                </div>
                            </div>

                            <!-- Bouton observations -->
                            <div class="mb-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="toggleObservations(@question.Id)">
                                    <i class="bi bi-chat-left-text"></i> Ajouter des observations
                                </button>
                            </div>

                            <!-- Zone d'observations (masquée par défaut) -->
                            <div class="collapse" id="observations-@question.Id">
                                <div class="card card-body bg-light">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat-left-dots"></i> Observations complémentaires
                                    </label>
                                    <textarea class="form-control"
                                      name="test-@question.Id-observations"
                                      rows="3"
                                      placeholder="Notez ici vos observations : douleur ressentie, côté affecté, compensations, limitations..."></textarea>
                                </div>
                            </div>
                        }
                        else if (question is QuestionQCM qcm)
                        {
                            <!-- Test QCM -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Observation</label>
                                <select class="form-select form-select-lg"
                                        name="test-@question.Id-value"
                                        onchange="markAsAnswered(@question.Id)">
                                    <option value="">-- Sélectionnez une observation --</option>
                                    @foreach (var choix in qcm.ListAnswers)
                                    {
                                        <option value="@choix">@choix</option>
                                    }
                                </select>
                            </div>

                            <!-- Bouton observations -->
                            <div class="mb-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="toggleObservations(@question.Id)">
                                    <i class="bi bi-chat-left-text"></i> Ajouter des observations
                                </button>
                            </div>

                            <!-- Zone d'observations (masquée par défaut) -->
                            <div class="collapse" id="observations-@question.Id">
                                <div class="card card-body bg-light">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat-left-dots"></i> Observations complémentaires
                                    </label>
                                    <textarea class="form-control"
                                      name="test-@question.Id-observations"
                                      rows="3"
                                      placeholder="Notez ici vos observations : douleur ressentie, côté affecté, compensations, limitations..."></textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Synthèse du cluster -->
        <div class="card mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-journal-text"></i> Synthèse de l'évaluation
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Bilan général</label>
                    <textarea class="form-control"
                              name="syntheseCluster"
                              rows="4"
                              placeholder="Synthèse globale des tests neurologiques effectués..."></textarea>
                </div>
            </div>
        </div>

        <!-- Red Flags détectés -->
        <div class="card mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i> Analyse des Red Flags
                </h5>
            </div>
            <div class="card-body">
                <div id="redFlagsContainer">
                    <p class="text-muted">Répondez aux tests pour voir les red flags potentiels.</p>
                </div>
                <button type="button" class="btn btn-warning mt-3" onclick="calculateRedFlags()">
                    <i class="bi bi-calculator"></i> Analyser les Red Flags
                </button>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="d-flex justify-content-between mb-5">
            <div>
                <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@patientId" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> Annuler
                </a>
                <button type="button" class="btn btn-outline-secondary btn-lg ms-2" onclick="resetForm()">
                    <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                </button>
            </div>
            <div>
                <button type="button" class="btn btn-info btn-lg me-2" onclick="saveData()">
                    <i class="bi bi-save"></i> Enregistrer
                </button>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-check-circle-fill"></i> Valider l'évaluation
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let customTestCounter = 1000; // Commencer à 1000 pour les tests personnalisés

        // Toggle formulaire d'ajout de test
        function toggleAddTestForm() {
            const form = document.getElementById('addTestForm');
            form.classList.toggle('show');
        }

        // Ajouter un test personnalisé
        function addCustomTest() {
            const testName = document.getElementById('customTestName').value.trim();
            const testType = document.getElementById('customTestType').value;
            const testDescription = document.getElementById('customTestDescription').value.trim();

            if (!testName) {
                alert('Veuillez entrer un nom pour le test.');
                return;
            }

            const testId = customTestCounter++;
            const testIndex = document.querySelectorAll('.test-card').length + 1;

            let testHTML = `
                <div class="card mb-3 test-card border-primary" id="test-${testId}" data-test-id="${testId}" data-custom="true">
                    <div class="card-header bg-light border-primary">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <h5 class="mb-2">
                                    <span class="badge bg-primary me-2">${testIndex}</span>
                                    ${testName}
                                    <span class="badge bg-secondary ms-2">Personnalisé</span>
                                </h5>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                ${testDescription ? `
                                <button type="button"
                                        class="btn btn-sm btn-outline-info"
                                        onclick="toggleDescription(${testId})"
                                        title="Voir le protocole">
                                    <i class="bi bi-journal-medical"></i> Protocole
                                </button>` : ''}
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="removeCustomTest(${testId})"
                                        title="Supprimer ce test">
                                    <i class="bi bi-trash"></i>
                                </button>
                                <span class="badge bg-success answered-badge" id="badge-${testId}" style="display: none;">
                                    <i class="bi bi-check-circle-fill"></i> Complété
                                </span>
                            </div>
                        </div>
                        ${testDescription ? `
                        <div class="alert alert-info mt-3 mb-0 collapse" id="description-${testId}">
                            <small>
                                <i class="bi bi-clipboard-check"></i>
                                <strong>Protocole :</strong> ${testDescription}
                            </small>
                        </div>` : ''}
                    </div>
                    <div class="card-body">
            `;

            if (testType === 'bool') {
                testHTML += `
                    <div class="mb-3">
                        <label class="form-label fw-bold">Résultat</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio"
                                   class="btn-check"
                                   name="test-${testId}-value"
                                   id="oui-${testId}"
                                   value="true"
                                   onchange="markAsAnswered(${testId})">
                            <label class="btn btn-outline-success btn-lg" for="oui-${testId}">
                                <i class="bi bi-check-circle-fill"></i> Positif
                            </label>
                            <input type="radio"
                                   class="btn-check"
                                   name="test-${testId}-value"
                                   id="non-${testId}"
                                   value="false"
                                   onchange="markAsAnswered(${testId})">
                            <label class="btn btn-outline-secondary btn-lg" for="non-${testId}">
                                <i class="bi bi-x-circle-fill"></i> Négatif
                            </label>
                        </div>
                    </div>
                `;
            } else if (testType === 'scale') {
                testHTML += `
                    <div class="mb-3">
                        <label class="form-label fw-bold">Valeur (0-10)</label>
                        <input type="number"
                               class="form-control form-control-lg mb-3"
                               name="test-${testId}-value"
                               min="0"
                               max="10"
                               placeholder="Entrez la valeur"
                               onchange="markAsAnswered(${testId}); updateRangeFromInput(this, 'range-${testId}', 'display-${testId}')"
                               id="input-${testId}">
                        <label class="form-label small text-muted">Ou utilisez le curseur :</label>
                        <input type="range"
                               class="form-range"
                               id="range-${testId}"
                               min="0"
                               max="10"
                               value="0"
                               step="1"
                               oninput="syncInputs(this, 'input-${testId}', 'display-${testId}')">
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted fw-semibold">0</small>
                            <span class="badge bg-primary fs-5" id="display-${testId}">0</span>
                            <small class="text-muted fw-semibold">10</small>
                        </div>
                    </div>
                `;
            } else if (testType === 'text') {
                testHTML += `
                    <div class="mb-3">
                        <label class="form-label fw-bold">Observations</label>
                        <textarea class="form-control"
                                  name="test-${testId}-value"
                                  rows="4"
                                  placeholder="Notez vos observations..."
                                  onchange="markAsAnswered(${testId})"></textarea>
                    </div>
                `;
            }

            testHTML += `
                        <div class="mb-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="toggleObservations(${testId})">
                                <i class="bi bi-chat-left-text"></i> Ajouter des observations
                            </button>
                        </div>
                        <div class="collapse" id="observations-${testId}">
                            <div class="card card-body bg-light">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-chat-left-dots"></i> Observations complémentaires
                                </label>
                                <textarea class="form-control"
                                      name="test-${testId}-observations"
                                      rows="3"
                                      placeholder="Notez ici vos observations : douleur ressentie, côté affecté, compensations, limitations..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Ajouter le test au conteneur
            document.getElementById('testsContainer').insertAdjacentHTML('beforeend', testHTML);

            // Réinitialiser et fermer le formulaire
            document.getElementById('customTestName').value = '';
            document.getElementById('customTestDescription').value = '';
            toggleAddTestForm();

            // Mettre à jour les numéros de tous les tests
            updateTestNumbers();

            alert(`✓ Test "${testName}" ajouté avec succès!`);
        }

        // Supprimer un test personnalisé
        function removeCustomTest(testId) {
            if (confirm('Êtes-vous sûr de vouloir supprimer ce test ?')) {
                const testCard = document.getElementById('test-' + testId);
                testCard.remove();
                updateTestNumbers();
                updateProgress();
            }
        }

        // Mettre à jour les numéros de tous les tests
        function updateTestNumbers() {
            const testCards = document.querySelectorAll('.test-card');
            testCards.forEach((card, index) => {
                const badge = card.querySelector('.badge.bg-primary');
                if (badge) {
                    badge.textContent = index + 1;
                }
            });
        }

        // Toggle description du protocole
        function toggleDescription(questionId) {
            const description = document.getElementById('description-' + questionId);
            description.classList.toggle('show');
        }

        // Marquer une question comme répondue
        function markAsAnswered(questionId) {
            const badge = document.getElementById('badge-' + questionId);
            const card = document.getElementById('test-' + questionId);

            badge.style.display = 'inline-block';
            card.classList.add('border-success', 'border-2');

            updateProgress();
        }

        // Toggle zone d'observations
        function toggleObservations(questionId) {
            const observationsZone = document.getElementById('observations-' + questionId);
            observationsZone.classList.toggle('show');
        }

        // Synchroniser input number et range
        function syncInputs(range, inputId, displayId) {
            document.getElementById(inputId).value = range.value;
            document.getElementById(displayId).textContent = range.value;
        }

        function updateRangeFromInput(input, rangeId, displayId) {
            document.getElementById(rangeId).value = input.value;
            document.getElementById(displayId).textContent = input.value;
        }

        // Mise à jour de la progression
        function updateProgress() {
            const total = document.querySelectorAll('.test-card').length;
            const answered = document.querySelectorAll('.answered-badge[style*="inline-block"]').length;
            const percentage = total > 0 ? Math.round((answered / total) * 100) : 0;

            document.getElementById('progressBar').style.width = percentage + '%';
            document.getElementById('progressBar').textContent = percentage + '%';
            document.getElementById('progressBar').setAttribute('aria-valuenow', percentage);
            document.getElementById('progressBadge').textContent = answered + ' / ' + total;
        }

        // Réinitialiser le formulaire
        function resetForm() {
            if (confirm('Êtes-vous sûr de vouloir réinitialiser tous les tests ?')) {
                document.getElementById('formTests').reset();

                document.querySelectorAll('.answered-badge').forEach(badge => {
                    badge.style.display = 'none';
                });

                document.querySelectorAll('.test-card').forEach(card => {
                    card.classList.remove('border-success', 'border-2');
                });

                document.querySelectorAll('.collapse').forEach(zone => {
                    zone.classList.remove('show');
                });

                updateProgress();
            }
        }

        // Calculer les Red Flags
        function calculateRedFlags() {
            let scoreTotal = 0;
            const testsEffectues = [];

            // Parcourir toutes les questions
            @foreach (var q in cluster.Questions)
            {
                        <text>
                        // Question @q.Id
                        const input@(q.Id) = document.querySelector('input[name="test-@q.Id-value"]:checked, input[name="test-@q.Id-value"]:not([type="radio"]), select[name="test-@q.Id-value"]');
                        if (input@(q.Id) && input@(q.Id).value) {
                            const value = input@(q.Id).value;
                            let isPositive = false;

                            @if (q is QuestionBool)
                            {
                                        <text>isPositive = value === 'true';</text>
                            }
                            else if (q is QuestionLadder)
                            {
                                        <text>isPositive = parseInt(value) >= 3;</text>
                            }
                            else if (q is QuestionQCM)
                            {
                                        <text>isPositive = value !== 'Démarche normale' && value !== '';</text>
                            }

                            if (isPositive) {
                                scoreTotal += @q.RVPositif;
                                testsEffectues.push({
                                    title: '@q.Title',
                                    score: @q.RVPositif,
                                    value: value
                                });
                            }
                        }
                        </text>
            }

            // Red Flags hardcodés
            const redFlags = [
                {
                    nom: "Syndrome de la Queue de Cheval",
                    seuil: 15,
                    niveau: "Urgence",
                    couleur: "danger",
                    description: "Compression médullaire nécessitant une intervention chirurgicale urgente",
                    action: "ORIENTATION IMMÉDIATE VERS LES URGENCES"
                },
                {
                    nom: "Atteinte Neurologique Sévère",
                    seuil: 10,
                    niveau: "Critique",
                    couleur: "warning",
                    description: "Déficit neurologique significatif nécessitant une évaluation médicale",
                    action: "Consultation neurologique urgente sous 24h"
                },
                {
                    nom: "Déficit Neurologique Modéré",
                    seuil: 5,
                    niveau: "Élevé",
                    couleur: "info",
                    description: "Signes neurologiques nécessitant une surveillance",
                    action: "Consultation médicale sous 48-72h"
                }
            ];

            const redFlagsDetected = redFlags.filter(rf => scoreTotal >= rf.seuil);
            displayRedFlags(redFlagsDetected, scoreTotal, testsEffectues);
        }

        // Afficher les Red Flags
        function displayRedFlags(redFlags, scoreTotal, testsEffectues) {
            const container = document.getElementById('redFlagsContainer');

            let html = `
                <div class="alert ${redFlags.length > 0 ? 'alert-danger' : 'alert-success'}">
                    <h6>
                        <i class="bi bi-${redFlags.length > 0 ? 'exclamation-triangle-fill' : 'check-circle-fill'}"></i>
                        Score total: <strong>${scoreTotal} points</strong>
                    </h6>
                    <p class="mb-0 small">Basé sur ${testsEffectues.length} test(s) positif(s)</p>
                </div>
            `;

            if (redFlags.length > 0) {
                html += '<div class="list-group mb-3">';
                redFlags.forEach(rf => {
                    const badgeClass = rf.niveau === 'Urgence' ? 'bg-danger' :
                                      rf.niveau === 'Critique' ? 'bg-warning text-dark' : 'bg-info';

                    html += `
                        <div class="list-group-item list-group-item-danger">
                            <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                <h6 class="mb-1">
                                    <i class="bi bi-flag-fill"></i> ${rf.nom}
                                </h6>
                                <span class="badge ${badgeClass}">${rf.niveau}</span>
                            </div>
                            <p class="mb-1 small">${rf.description}</p>
                            <small class="text-danger">
                                <i class="bi bi-arrow-right-circle"></i>
                                <strong>Action:</strong> ${rf.action}
                            </small>
                        </div>
                    `;
                });
                html += '</div>';
            } else {
                html += `
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i>
                        Aucun red flag détecté pour ce cluster.
                    </div>
                `;
            }

            if (testsEffectues.length > 0) {
                html += '<h6 class="mt-3">Tests contributeurs:</h6><ul class="small">';
                testsEffectues.forEach(test => {
                    html += `<li>${test.title}: +${test.score} points</li>`;
                });
                html += '</ul>';
            }

            container.innerHTML = html;
        }

        // Sauvegarder les données
        function saveData() {
            const formData = new FormData(document.getElementById('formTests'));
            const data = {
                clusterId: formData.get('clusterId'),
                patientId: formData.get('patientId'),
                tests: []
            };

            // Tests prédéfinis
            @foreach (var q in cluster.Questions)
            {
                        <text>
                        const value@(q.Id) = formData.get('test-@q.Id-value');
                        if (value@(q.Id)) {
                            data.tests.push({
                                id: @q.Id,
                                value: value@(q.Id),
                                observations: formData.get('test-@q.Id-observations')
                            });
                        }
                        </text>
            }

            // Tests personnalisés
            document.querySelectorAll('[data-custom="true"]').forEach(card => {
                const testId = card.getAttribute('data-test-id');
                const testName = card.querySelector('h5').textContent.trim();
                const valueInput = formData.get('test-' + testId + '-value');
                if (valueInput) {
                    data.tests.push({
                        id: testId,
                        name: testName,
                        value: valueInput,
                        observations: formData.get('test-' + testId + '-observations'),
                        custom: true
                    });
                }
            });

            data.syntheseCluster = formData.get('syntheseCluster');

            console.log('Données sauvegardées:', data);
            alert(`✓ Données enregistrées!\n\n${data.tests.length} test(s) complété(s).\n\nVoir console (F12) pour les détails.`);
        }

        // Soumettre le formulaire
        function handleSubmit(event) {
            event.preventDefault();

            const answered = document.querySelectorAll('.answered-badge[style*="inline-block"]').length;
            if (answered === 0) {
                alert('⚠️ Veuillez répondre à au moins un test avant de valider.');
                return false;
            }

            saveData();
            alert(`✓ Évaluation validée!\n\n${answered} test(s) complété(s).`);

            return false;
        }
    </script>

    <style>
        /* Styles minimalistes avec Bootstrap */
        .test-card {
            transition: all 0.2s ease;
        }

            .test-card:hover {
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

            .test-card.border-success {
                box-shadow: 0 4px 12px rgba(25, 135, 84, 0.25);
            }

        .border-2 {
            border-width: 2px !important;
        }

        .btn-check:checked + .btn-outline-success {
            background-color: #198754;
            border-color: #198754;
            color: white;
        }

        .btn-check:checked + .btn-outline-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .gap-2 {
            gap: 0.5rem;
        }
    </style>
}
