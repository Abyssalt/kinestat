@model List<KineStat.Models.Cluster>
@using KineStat.Models

@{
    ViewData["Title"] = "Tests";

    var clusters = Model; 
    var patientNom = ViewData["PatientNom"]?.ToString() ?? "Patient";
    var patientId = ViewData["PatientId"] != null ? Convert.ToInt32(ViewData["PatientId"]) : 0;
    var patient = ViewData["Patient"] as Patient;

    int totalQuestions = clusters.Sum(c => c.Questions.Count);
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="card border-0 shadow mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-clipboard2-pulse me-2"></i>Évaluation complète
                    </h1>
                    <p class="text-secondary mb-0">
                        <i class="bi bi-person-badge me-1"></i>Patient : <strong>@patientNom</strong>
                    </p>
                </div>

                <a asp-controller="Patient" asp-action="ExamenClinique" asp-route-id="@patientId" class="btn btn-outline-secondary fw-medium">

                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-list-check me-2"></i>Progression globale
                </h6>
                <span class="badge bg-primary" id="progressBadge">0 / @totalQuestions</span>
            </div>
            <div class="progress" style="height: 25px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     role="progressbar"
                     id="progressBar"
                     style="width: 0%"
                     aria-valuenow="0"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    0%
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button type="button" class="btn btn-outline-primary fw-medium" onclick="toggleAddTestForm()">
            <i class="bi bi-plus-circle me-2"></i>Ajouter un test spécifique
        </button>

        <div class="collapse mt-3" id="addTestForm">
            <div class="card border-0 shadow border-start border-primary border-4">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-plus-square me-2"></i>Ajouter un test personnalisé
                    </h6>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-medium">
                                <i class="bi bi-folder2-open me-1"></i>Dans quel cluster ajouter ce test ?
                            </label>
                            <select class="form-select" id="customTestCluster">
                                <option value="">-- Sélectionnez un cluster --</option>
                                @foreach (var cluster in clusters)
                                {
                                    <option value="@cluster.Id">@cluster.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="button" class="btn btn-primary fw-medium" onclick="addCustomTest()">
                            <i class="bi bi-check-circle me-2"></i>Ajouter ce test
                        </button>
                        <button type="button" class="btn btn-outline-secondary fw-medium" onclick="toggleAddTestForm()">
                            <i class="bi bi-x-circle me-2"></i>Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form id="formTests" asp-controller="Patients" asp-action="SaveTestResults" method="post" onsubmit="return handleSubmit(event)">
        <input type="hidden" name="patientId" value="@patientId">

        @{
            int globalTestIndex = 0;
        }
        @foreach (var cluster in clusters)
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-folder2-open me-2"></i>@cluster.Name
                    </h4>
                    <small>@cluster.Questions.Count question(s)</small>
                </div>
                <div class="card-body p-3">
                    <div id="testsContainer-@cluster.Id">
                        @foreach (var question in cluster.Questions)
                        {
                            globalTestIndex++;
                            <div class="card border-0 shadow-sm mb-3 test-card" id="test-@question.Id" data-test-id="@question.Id">
                                <div class="card-header bg-light py-3">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                                        <div class="flex-grow-1">
                                            <h5 class="mb-2 fw-bold">
                                                <span class="badge bg-primary me-2">@globalTestIndex</span>
                                                @question.Title
                                            </h5>
                                            <small class="text-secondary">
                                                RV+ : <span class="badge bg-danger">@question.RVPositive</span>
                                                @if (!string.IsNullOrWhiteSpace(question.SourceRv))
                                                {
                                                    <span class="ms-2">
                                                        <i class="bi bi-book me-1"></i>@question.SourceRv
                                                    </span>
                                                }
                                            </small>
                                        </div>
                                        
                                        <span class="badge bg-success answered-badge" id="badge-@question.Id" style="display: none;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Complété
                                        </span>
                                        
                                    </div>

                                    
                                </div>

                                <div class="card-body p-3 p-md-4">
                                    @if (question is QuestionBool)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-medium">Résultat</label>
                                            <div class="btn-group w-100" role="group">
                                                <input type="radio"
                                                       class="btn-check"
                                                       name="test-@question.Id-value"
                                                       id="oui-@question.Id"
                                                       value="true"
                                                       onchange="markAsAnswered(@question.Id)">
                                                <label class="btn btn-outline-success btn-lg fw-medium" for="oui-@question.Id">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Positif
                                                </label>

                                                <input type="radio"
                                                       class="btn-check"
                                                       name="test-@question.Id-value"
                                                       id="non-@question.Id"
                                                       value="false"
                                                       onchange="markAsAnswered(@question.Id)">
                                                <label class="btn btn-outline-secondary btn-lg fw-medium" for="non-@question.Id">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Négatif
                                                </label>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fw-medium"
                                                    onclick="toggleObservations(@question.Id)">
                                                <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                            </button>
                                        </div>

                                        <div class="collapse" id="observations-@question.Id">
                                            <div class="card border-0 bg-light mt-3">
                                                <div class="card-body p-3">
                                                    <label class="form-label fw-medium">
                                                        <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                    </label>
                                                    <textarea class="form-control"
                                                  name="test-@question.Id-observations"
                                                  rows="3"
                                                  placeholder="Notez ici vos observations..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (question is QuestionLadder ladder)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-medium">
                                                Valeur mesurée (@ladder.Min - @ladder.Max)
                                            </label>
                                            <input type="number"
                                                   class="form-control form-control-lg mb-3"
                                                   name="test-@question.Id-value"
                                                   min="@ladder.Min"
                                                   max="@ladder.Max"
                                                   placeholder="Entrez la valeur"
                                                   onchange="markAsAnswered(@question.Id); updateRangeFromInput(this, 'range-@question.Id', 'display-@question.Id')"
                                                   id="input-@question.Id">

                                            <label class="form-label small text-secondary">Ou utilisez le curseur :</label>
                                            <input type="range"
                                                   class="form-range"
                                                   id="range-@question.Id"
                                                   min="@ladder.Min"
                                                   max="@ladder.Max"
                                                   value="@ladder.Min"
                                                   step="1"
                                                   oninput="syncInputs(this, 'input-@question.Id', 'display-@question.Id')">
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <small class="text-secondary fw-semibold">@ladder.Min</small>
                                                <span class="badge bg-primary fs-5" id="display-@question.Id">@ladder.Min</span>
                                                <small class="text-secondary fw-semibold">@ladder.Max</small>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fw-medium"
                                                    onclick="toggleObservations(@question.Id)">
                                                <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                            </button>
                                        </div>

                                        <div class="collapse" id="observations-@question.Id">
                                            <div class="card border-0 bg-light mt-3">
                                                <div class="card-body p-3">
                                                    <label class="form-label fw-medium">
                                                        <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                    </label>
                                                    <textarea class="form-control"
                                                  name="test-@question.Id-observations"
                                                  rows="3"
                                                  placeholder="Notez ici vos observations..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (question is QuestionQCM qcm)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-medium">Observation</label>
                                            <select class="form-select form-select-lg"
                                                    name="test-@question.Id-value"
                                                    onchange="markAsAnswered(@question.Id)">
                                                <option value="">-- Sélectionnez une observation --</option>
                                            </select>
                                        </div>

                                        <div class="mb-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fw-medium"
                                                    onclick="toggleObservations(@question.Id)">
                                                <i class="bi bi-chat-left-text me-1"></i>Ajouter des observations
                                            </button>
                                        </div>

                                        <div class="collapse" id="observations-@question.Id">
                                            <div class="card border-0 bg-light mt-3">
                                                <div class="card-body p-3">
                                                    <label class="form-label fw-medium">
                                                        <i class="bi bi-chat-left-dots me-1"></i>Observations complémentaires
                                                    </label>
                                                    <textarea class="form-control"
                                                  name="test-@question.Id-observations"
                                                  rows="3"
                                                  placeholder="Notez ici vos observations..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }

        <div class="card border-0 shadow">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-between align-items-center">
                    <button type="button"
                            class="btn btn-outline-secondary btn-lg fw-medium w-100 w-sm-auto"
                            onclick="resetForm()">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Réinitialiser
                    </button>

                    <div class="d-flex gap-2 w-100 w-sm-auto">
                        <button type="button"
                                class="btn btn-primary btn-lg fw-medium flex-fill"
                                onclick="saveData()">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Enregistrer le brouillon
                        </button>
                        <button type="submit"
                                class="btn btn-success btn-lg fw-medium flex-fill">
                            <i class="bi bi-check-circle-fill me-2"></i>Valider l'évaluation
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </form>

</div>

@section Scripts {
    <script src="~/js/Tests.js"></script>

    <script>
        @{
                var existingResponsesList = ViewData["ExistingResponses"] as IEnumerable<dynamic>;
                var responsesData = new List<object>();

                if (existingResponsesList != null)
                {
                        foreach (var r in existingResponsesList)
                        {
                                responsesData.Add(new
                                {
                                        questionId = r.QuestionId,
                                        answerId = r.AnswerId,
                                        value = r.ResponseValue,
                                        observations = r.Observations,
                                        isCustom = r.IsCustomTest,
                                        customName = r.CustomTestName,
                                        customType = r.CustomTestType
                                });
                        }
                }
        }

        var existingResponses = @Html.Raw(Json.Serialize(responsesData));

        document.addEventListener('DOMContentLoaded', function() {
            loadExistingResponses(existingResponses);
        });

        function saveData() {
            const formData = new FormData(document.getElementById('formTests'));
            const data = {
                patientId: parseInt(formData.get('patientId')),
                tests: []
            };

            document.querySelectorAll('.test-card:not([data-custom="true"])').forEach(card => {
                const testId = parseInt(card.getAttribute('data-test-id'));
                const valueInput = formData.get('test-' + testId + '-value');

                if (valueInput) {
                    data.tests.push({
                        id: testId,
                        value: valueInput,
                        observations: formData.get('test-' + testId + '-observations') || null,
                        custom: false
                    });
                }
            });

            document.querySelectorAll('[data-custom="true"]').forEach(card => {
                const testId = card.getAttribute('data-test-id');
                const testName = card.querySelector('h5').textContent.replace(/\d+/, '').replace('Personnalisé', '').trim();
                const valueInput = formData.get('test-' + testId + '-value');

                if (valueInput) {
                    let testType = 'text';
                    const radioInput = card.querySelector('input[type="radio"]');
                    const numberInput = card.querySelector('input[type="number"]');

                    if (radioInput) testType = 'bool';
                    else if (numberInput) testType = 'scale';

                    data.tests.push({
                        id: parseInt(testId),
                        name: testName,
                        type: testType,
                        value: valueInput,
                        observations: formData.get('test-' + testId + '-observations') || null,
                        custom: true
                    });
                }
            });

            console.log('Données à envoyer:', data);

            fetch('/Patients/SaveTestResults', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    alert(`✓ Évaluation enregistrée avec succès!\n\n${result.testCount} réponse(s) enregistrée(s)\nDate: ${result.dateEvaluation}`);
                    console.log('Succès:', result);
                } else {
                    alert(`❌ Erreur: ${result.message}`);
                    console.error('Erreur:', result);
                }
            })
            .catch(error => {
                alert('❌ Erreur de connexion au serveur');
                console.error('Erreur:', error);
            });
        }
    </script>

    <style>
        .test-card {
            transition: all 0.2s ease;
        }
        .test-card:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .test-card.border-success {
            box-shadow: 0 4px 12px rgba(25, 135, 84, 0.25);
        }
        .border-2 {
            border-width: 2px !important;
        }
        .btn-check:checked + .btn-outline-success {
            background-color: #198754;
            border-color: #198754;
            color: white;
        }
        .btn-check:checked + .btn-outline-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }
    </style>
}

