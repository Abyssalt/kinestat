@model KineStat.Models.Dossier

<h2>Nouveau dossier</h2>

<form asp-controller="Patient"
      asp-action="CreateDossier"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PatientId" />

    <div class="mb-3">
        <label class="form-label fw-bold">Titre du dossier</label>
        <input asp-for="Titre" class="form-control" />
        <span asp-validation-for="Titre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Date d'ouverture</label>
        <input asp-for="DateOuverture" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">
        <i class="bi bi-check-circle"></i> Créer le dossier
    </button>
</form>

