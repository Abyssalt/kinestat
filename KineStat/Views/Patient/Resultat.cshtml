@{
    ViewData["Title"] = "Resultat";
    ViewData["PatientId"] = ViewContext.RouteData.Values["id"]?.ToString();
    ViewData["Breadcrumbs"] = "<li class='breadcrumb-item'><a href='/'>Accueil</a></li><li class='breadcrumb-item'><a href='/Patients'>Patients</a></li><li class='breadcrumb-item active' aria-current='page'>Resultat</li>";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-graph-up me-2"></i>Résultat
                    </h1>
                </div>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-4 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Tests effectués</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a class="list-group-item py-3">Test Lasègue</a>
                    <a class="list-group-item py-3">Test Schober</a>
                    <a class="list-group-item py-3">Test Slump</a>
                    <a class="list-group-item py-3">Question 1</a>
                    <a class="list-group-item py-3">Question 2</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-header bg-warning py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-activity me-2"></i>Analyse du risque</h5>
                </div>
                <div class="card-body text-center p-3 p-md-4">
                    <div class="row mb-3 g-2">
                        <div class="col-6 col-sm-3">
                            <span class="fw-semibold small">Neuro</span><br />
                            <span class="fs-4 fw-bold text-primary">12%</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="fw-semibold small">Onco</span><br />
                            <span class="fs-4 fw-bold text-primary">26%</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="fw-semibold small">Trauma</span><br />
                            <span class="fs-4 fw-bold text-primary">8%</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="fw-semibold small">Vasculaire</span><br />
                            <span class="fs-4 fw-bold text-primary">32%</span>
                        </div>
                    </div>

                    <div class="progress mb-2" style="height: 18px;">
                        <div class="progress-bar bg-success" style="width: 25%"></div>
                        <div class="progress-bar bg-warning" style="width: 25%"></div>
                        <div class="progress-bar bg-danger" style="width: 50%"></div>
                    </div>
                    <small class="text-danger fw-bold">Risque élevé</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard2-pulse me-2"></i>Pathologies suspectées</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Tumoral</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">26%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Infectieux</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">10%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Neurologique</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">12%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Traumatique</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">8%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Inflammatoire</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">7%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Vasculaire</span>
                        <span class="badge bg-primary bg-opacity-75 fs-6" style="min-width: 60px;">32%</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-pentagon me-2"></i>Profil clinique</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row text-center">
                        <div class="col-12 col-lg-6 mb-4 mb-lg-0">
                            <h6 class="fw-bold mb-3">Profil clinique (9 catégories)</h6>
                            <div style="height: 350px;">
                                <canvas id="radarChart9" height="350"></canvas>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <h6 class="fw-bold mb-3">TINTIV (6 catégories)</h6>
                            <div style="height: 350px;">
                                <canvas id="radarChart6" height="350"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <button type="button" class="btn btn-primary btn-lg fw-medium">
            <i class="bi bi-save me-2"></i>Enregistrer
        </button>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        const defaultOptions = {
            responsive: true,
            maintainAspectRatio: false,
            elements: {
                line: { tension: 0.3 },
                point: { radius: 5, hoverRadius: 7 }
            },
            scales: {
                r: {
                    min: 0,
                    grid: {
                        color: "rgba(0,0,0,0.1)"
                    },
                    angleLines: {
                        color: "rgba(0,0,0,0.2)"
                    },
                    ticks: {
                        backdropColor: "transparent",
                        showLabelBackdrop: false
                    }
                }
            },
            plugins: {
                legend: { display: false }
            }
        };

        new Chart(document.getElementById("radarChart9"), {
            type: 'radar',
            data: {
                labels: [
                    "Articulaire/structurel",
                    "Myofascial",
                    "Nociceptif",
                    "Neuropathique",
                    "Nociplastique",
                    "Contrôle sensorimoteur",
                    "Croyance & cognition",
                    "Socio-environnemental",
                    "Émotionnel/Affectif"
                ],
                datasets: [{
                    label: "Profil clinique",
                    data: [10, 9, 8, 7, 5, 6, 4, 7, 5],
                    backgroundColor: "rgba(13,110,253,0.25)",
                    borderColor: "rgb(13,110,253)",
                    borderWidth: 3,
                    pointBackgroundColor: "rgb(13,110,253)",
                    pointBorderColor: "#fff"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        min: 0,
                        max: 10,
                        ticks: {
                            stepSize: 10,
                            backdropColor: "transparent"
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        new Chart(document.getElementById("radarChart6"), {
            type: 'radar',
            data: {
                labels: [
                    "Tumeur",
                    "Infection",
                    "Neurologique",
                    "Traumatisme",
                    "Inflammatoire",
                    "Vasculaire"
                ],
                datasets: [{
                    label: "Profil TINTIV",
                    data: [3, 10, 2, 8, 7, 1],
                    backgroundColor: "rgba(255,99,132,0.25)",
                    borderColor: "rgb(255,99,132)",
                    borderWidth: 3,
                    pointBackgroundColor: "rgb(255,99,132)",
                    pointBorderColor: "#fff"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        min: 0,
                        max: 10,
                        ticks: {
                            stepSize: 10,
                            backdropColor: "transparent"
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

    });
</script>