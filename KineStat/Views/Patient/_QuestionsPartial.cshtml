@model IEnumerable<KineStat.Models.QuestionBool> 

@foreach (var question in Model)
{
    <div class="mb-3 border p-3 rounded">
        <p>@question.Title</p>

        @if (question is QuestionBool qb)
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" name="q_@question.Id" value="true">
                <label class="form-check-label">Oui</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="q_@question.Id" value="false">
                <label class="form-check-label">Non</label>
            </div>
        }

        <button type="button" id="notes_button" class="btn btn-sm btn-outline-secondary mt-2"
                data-bs-toggle="collapse" data-bs-target="#notesContainer_@question.Id">
            Ajouter une note
        </button>

        <div class="collapse mt-2" id="notesContainer_@question.Id">
            <label for="noteInput_@question.Id">Notes :</label>
            <textarea class="form-control" id="noteInput_@question.Id" name="note_@question.Id" placeholder="Notes (optionnel)"></textarea>
        </div>
    </div>
}