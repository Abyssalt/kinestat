@model KineStat.Models.Assessment

@{
    ViewData["Title"] = "Nouveau bilan";
    ViewData["Breadcrumbs"] =
        $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
        $"<li class='breadcrumb-item'><a href='/Patient/Anamnese/{Model.PatientId}'>Anamnèse</a></li>" +
        $"<li class='breadcrumb-item active'>Nouveau bilan</li>";
}

@{
    ViewData["PatientId"] = Model.PatientId;
}


<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 fw-bold text-primary mb-2">
                <i class="bi bi-clipboard2-pulse me-2"></i>Nouveau bilan
            </h1>
            <p class="text-secondary mb-0">Suivez les étapes pour réaliser le bilan complet</p>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Patient"
               asp-action="Socrate"
               asp-route-id="@ViewData["PatientId"]"
               class="card h-100 border-0 shadow-sm text-decoration-none">
                <div class="card-body text-center">
                    <i class="bi bi-clipboard-heart display-5 text-info mb-3"></i>
                    <h5 class="fw-bold text-dark">SOCRATE</h5>
                    <p class="text-secondary small mb-0">Analyse détaillée de la douleur</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Patient"
               asp-action="RedFlags"
               asp-route-id="@ViewData["PatientId"]"
               class="card h-100 border-0 shadow-sm text-decoration-none">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle display-5 text-danger mb-3"></i>
                    <h5 class="fw-bold text-dark">Red Flags</h5>
                    <p class="text-secondary small mb-0">Signes de gravité et exclusions</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Patient"
               asp-action="ExamenClinique"
               asp-route-id="@ViewData["PatientId"]"
               class="card h-100 border-0 shadow-sm text-decoration-none">
                <div class="card-body text-center">
                    <i class="bi bi-search display-5 text-success mb-3"></i>
                    <h5 class="fw-bold text-dark">Examen clinique</h5>
                    <p class="text-secondary small mb-0">Observation et tests fonctionnels</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Patient"
               asp-action="Tests"
               asp-route-id="@ViewData["PatientId"]"
               class="card h-100 border-0 shadow-sm text-decoration-none">
                <div class="card-body text-center">
                    <i class="bi bi-list-check display-5 text-warning mb-3"></i>
                    <h5 class="fw-bold text-dark">Tests</h5>
                    <p class="text-secondary small mb-0">Tests spécifiques et cliniques</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a asp-controller="Patient"
               asp-action="Resultat"
               asp-route-id="@ViewData["PatientId"]"
               class="card h-100 border-0 shadow-sm text-decoration-none">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-5 text-primary mb-3"></i>
                    <h5 class="fw-bold text-dark">Résultat</h5>
                    <p class="text-secondary small mb-0">Synthèse et orientation</p>
                </div>
            </a>
        </div>

    </div>
</div>
