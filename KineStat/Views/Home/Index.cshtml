@{
    ViewData["Title"] = "Accueil";
}

<div class="bg-white">
    <div class="container px-3 px-md-4 py-5">
        <div class="row align-items-center min-vh-75 py-5">
            <div class="col-12 col-lg-7 mb-5 mb-lg-0">
                <h1 class="display-1 fw-bold mb-4">
                    <span class="text-primary">KineStat</span>
                    <br>
                    <span class="text-dark">Votre assistant diagnostic</span>
                </h1>
                <p class="lead text-secondary mb-4 fs-4">
                    L'application conçue pour les kinésithérapeutes. Réalisez des bilans complets et détectez efficacement les Red Flags.
                </p>
                <div class="d-grid gap-2 d-sm-flex">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 fw-medium shadow">
                        <i class="bi bi-door-open me-2"></i>Se connecter
                    </a>
                    <a href="#features" class="btn btn-outline-primary btn-lg px-5 fw-medium">
                        <i class="bi bi-info-circle me-2"></i>En savoir plus
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-5 text-center">
                <img src="~/images/logo.png" alt="KineStat Logo" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<div id="features" class="bg-light">
    <div class="container px-3 px-md-4 py-5">
        <div class="text-center mb-5">
            <h2 class="h2 fw-bold text-primary mb-2">
                <i class="bi bi-gear me-2"></i>Fonctionnalités principales
            </h2>
            <p class="text-secondary">Des outils complets pour votre pratique quotidienne</p>
            <hr class="border-primary border-2 opacity-25 mx-auto" style="max-width: 100px;">
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-clipboard-pulse text-primary display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Anamnèse complète</h5>
                        <p class="card-text text-secondary mb-0">Collectez l'historique médical de vos patients de manière structurée et efficace.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-exclamation-triangle text-danger display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Détection Red Flags</h5>
                        <p class="card-text text-secondary mb-0">Identifiez automatiquement les signes d'alerte nécessitant une attention particulière.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-activity text-success display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Examen clinique</h5>
                        <p class="card-text text-secondary mb-0">Documentez vos observations cliniques avec des outils adaptés et intuitifs.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-clipboard-check text-info display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Tests et évaluations</h5>
                        <p class="card-text text-secondary mb-0">Réalisez des tests standardisés et suivez l'évolution de vos patients.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-bar-chart-line text-warning display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Analyse Bayésienne</h5>
                        <p class="card-text text-secondary mb-0">Bénéficiez d'une analyse statistique avancée pour vos diagnostics.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center p-4">
                        <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-people text-secondary display-5"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Gestion des patients</h5>
                        <p class="card-text text-secondary mb-0">Organisez et retrouvez facilement les dossiers de vos patients.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bg-white">
    <div class="container px-3 px-md-4 py-5">
        <div class="text-center mb-5">
            <h2 class="h2 fw-bold text-primary mb-2">
                <i class="bi bi-list-ol me-2"></i>Processus de bilan simplifié
            </h2>
            <p class="text-secondary">Un workflow optimisé en 5 étapes</p>
            <hr class="border-primary border-2 opacity-25 mx-auto" style="max-width: 100px;">
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="card border-0 border-start border-primary border-4 shadow">
                            <div class="card-body d-flex align-items-center p-3 p-md-4">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3 me-md-4 fw-bold fs-4" style="width: 60px; height: 60px;">
                                    1
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold mb-1">Anamnèse</h5>
                                    <p class="card-text text-secondary mb-0">Recueillez l'histoire complète du patient et ses antécédents médicaux</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-0 border-start border-danger border-4 shadow">
                            <div class="card-body d-flex align-items-center p-3 p-md-4">
                                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3 me-md-4 fw-bold fs-4" style="width: 60px; height: 60px;">
                                    2
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold mb-1">Red Flags</h5>
                                    <p class="card-text text-secondary mb-0">Vérifiez les signaux d'alerte et identifiez les situations nécessitant une référence</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-0 border-start border-success border-4 shadow">
                            <div class="card-body d-flex align-items-center p-3 p-md-4">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3 me-md-4 fw-bold fs-4" style="width: 60px; height: 60px;">
                                    3
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold mb-1">Examen clinique</h5>
                                    <p class="card-text text-secondary mb-0">Effectuez un examen physique complet avec documentation structurée</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-0 border-start border-info border-4 shadow">
                            <div class="card-body d-flex align-items-center p-3 p-md-4">
                                <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3 me-md-4 fw-bold fs-4" style="width: 60px; height: 60px;">
                                    4
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold mb-1">Tests</h5>
                                    <p class="card-text text-secondary mb-0">Appliquez des tests cliniques standardisés pour affiner votre évaluation</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-0 border-start border-warning border-4 shadow">
                            <div class="card-body d-flex align-items-center p-3 p-md-4">
                                <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3 me-md-4 fw-bold fs-4" style="width: 60px; height: 60px;">
                                    5
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold mb-1">Résultat</h5>
                                    <p class="card-text text-secondary mb-0">Obtenez une analyse complète et un diagnostic assisté par algorithme Bayésien</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
