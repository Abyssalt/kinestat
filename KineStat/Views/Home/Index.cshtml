@{
    ViewData["Title"] = "Accueil";
}

<div class="position-relative overflow-hidden bg-white">
    <div class="container py-5">
        <div class="row min-vh-75 align-items-center py-5">
            <div class="col-lg-7 mb-5 mb-lg-0">
                <h1 class="display-1 fw-bold mb-4" style="line-height: 1.1;">
                    <span class="text-primary">KineStat</span>
                    <br>
                    <span class="text-dark">Votre assistant diagnostic</span>
                </h1>
                <p class="lead text-muted mb-4 fs-4">
                    L'application conçue pour les kinésithérapeutes. Réalisez des bilans complets et détectez efficacement les Red Flags.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-lg">
                        <i class="bi bi-door-open me-2"></i>Se connecter
                    </a>
                    <a href="#features" class="btn btn-outline-primary btn-lg px-5">
                        <i class="bi bi-info-circle me-2"></i>En savoir plus
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="position-relative">
                    <div class="bg-primary bg-opacity-10 rounded-circle position-absolute top-50 start-50 translate-middle" style="width: 450px; height: 450px; z-index: -1;"></div>
                    <img src="~/images/logo.png" alt="KineStat Logo" class="img-fluid position-relative" style="filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));">
                </div>
            </div>
        </div>
    </div>

    <div class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden" style="z-index: -2;">
        <div class="position-absolute bg-primary bg-opacity-10 rounded-circle" style="width: 300px; height: 300px; top: -100px; right: -50px;"></div>
        <div class="position-absolute bg-info bg-opacity-10 rounded-circle" style="width: 200px; height: 200px; bottom: -50px; left: -50px;"></div>
    </div>
</div>

<div id="features" class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold mb-3">Fonctionnalités principales</h2>
        <p class="lead text-muted">Des outils complets pour votre pratique quotidienne</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-clipboard-pulse text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Anamnèse complète</h5>
                    <p class="card-text text-muted">Collectez l'historique médical de vos patients de manière structurée et efficace.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Détection Red Flags</h5>
                    <p class="card-text text-muted">Identifiez automatiquement les signes d'alerte nécessitant une attention particulière.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-activity text-success" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Examen clinique</h5>
                    <p class="card-text text-muted">Documentez vos observations cliniques avec des outils adaptés et intuitifs.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-clipboard-check text-info" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Tests et évaluations</h5>
                    <p class="card-text text-muted">Réalisez des tests standardisés et suivez l'évolution de vos patients.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-bar-chart-line text-warning" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Analyse Bayésienne</h5>
                    <p class="card-text text-muted">Bénéficiez d'une analyse statistique avancée pour vos diagnostics.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                         style="width: 100px; height: 100px; aspect-ratio: 1/1;">
                        <i class="bi bi-people text-secondary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Gestion des patients</h5>
                    <p class="card-text text-muted">Organisez et retrouvez facilement les dossiers de vos patients.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold mb-3">Processus de bilan simplifié</h2>
        <p class="lead text-muted">Un workflow optimisé en 5 étapes</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="row g-4">
                <div class="col-12">
                    <div class="card border-primary border-2 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-4" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                1
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-2">Anamnèse</h5>
                                <p class="card-text text-muted mb-0">Recueillez l'histoire complète du patient et ses antécédents médicaux</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-danger border-2 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-4" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                2
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-2">Red Flags</h5>
                                <p class="card-text text-muted mb-0">Vérifiez les signaux d'alerte et identifiez les situations nécessitant une référence</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-success border-2 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-4" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                3
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-2">Examen clinique</h5>
                                <p class="card-text text-muted mb-0">Effectuez un examen physique complet avec documentation structurée</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-info border-2 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-4" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                4
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-2">Tests</h5>
                                <p class="card-text text-muted mb-0">Appliquez des tests cliniques standardisés pour affiner votre évaluation</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-warning border-2 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-4" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                5
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-2">Résultat</h5>
                                <p class="card-text text-muted mb-0">Obtenez une analyse complète et un diagnostic assisté par algorithme Bayésien</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
