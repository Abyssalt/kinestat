@model IEnumerable<KineStat.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container-fluid px-3 px-md-4 mt-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
        <h2 class="fw-light text-uppercase letter-spacing-wide mb-0">Patients</h2>
        <button class="btn btn-primary btn-touch" data-bs-toggle="modal" data-bs-target="#addPatientModal">
            <i class="bi bi-plus-circle me-2"></i>Nouveau patient
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-0 bg-light"
                               placeholder="Rechercher un patient..." value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    <select id="statusFilter" class="form-select bg-light border-0">
                        <option value="Tous">Tous les statuts</option>
                        <option value="Actif">Actif</option>
                        <option value="Terminé">Terminé</option>
                        <option value="Inactif">Inactif</option>
                        <option value="Abandonné">Abandonné</option>
                    </select>
                </div>
            </div>

            <div id="loadingIndicator" class="alert alert-info border-0 py-3" style="display:none;">
                <i class="bi bi-hourglass-split me-2"></i>Chargement en cours...
            </div>

            <div id="noResultsMessage" class="alert alert-warning border-0 py-3" style="display:none;">
                <i class="bi bi-info-circle me-2"></i>Aucun patient ne correspond à votre recherche.
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="d-block d-lg-none" id="patientsCardsView">
                    @foreach (Patient patient in Model)
                    {
                        <div class="card mb-3 patient-card border-0 shadow-sm clickable-card"
                             data-href="@Url.Action("Anamnese", "Patient", new { id = patient.Id })">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="card-title mb-1 fw-semibold">
                                            @patient.LastName @patient.FirstName
                                        </h5>
                                        <p class="card-text text-muted small mb-0">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @patient.BirthDate.ToString("dd/MM/yyyy")
                                        </p>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        @switch (patient.Gender)
                                        {
                                            case Gender.Homme:
                                                <span class="badge bg-primary rounded-pill">H</span>
                                                break;
                                            case Gender.Femme:
                                                <span class="badge bg-danger rounded-pill">F</span>
                                                break;
                                            case Gender.Autre:
                                                <span class="badge bg-secondary rounded-pill">A</span>
                                                break;
                                        }
                                        @switch (patient.Status)
                                        {
                                            case PatientStatus.Actif:
                                                <span class="badge bg-success rounded-pill">Actif</span>
                                                break;
                                            case PatientStatus.Terminé:
                                                <span class="badge bg-secondary rounded-pill">Terminé</span>
                                                break;
                                            case PatientStatus.Inactif:
                                                <span class="badge bg-dark rounded-pill">Suspendu</span>
                                                break;
                                            case PatientStatus.Abandonné:
                                                <span class="badge bg-danger rounded-pill">Abandonné</span>
                                                break;
                                        }
                                    </div>
                                </div>

                                <div class="row g-2 mb-3 small">
                                    <div class="col-12">
                                        <span class="text-muted">
                                            <i class="bi bi-envelope me-2"></i>@patient.Email
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span class="text-muted">
                                            <i class="bi bi-telephone me-2"></i>@patient.PhoneNumber
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <form asp-controller="Index" asp-action="Delete" asp-route-id="@patient.Id"
                                          method="post" class="delete-form">
                                        <button type="submit" class="btn btn-outline-danger btn-touch"
                                                onclick="event.stopPropagation(); return confirm('Supprimer ce patient ?');">
                                            <i class="bi bi-trash me-2"></i>Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-none d-lg-block table-responsive">
                    <table class="table table-hover align-middle" id="patientsTable">
                        <thead>
                            <tr class="text-uppercase small text-muted">
                                <th class="fw-semibold py-3">Nom</th>
                                <th class="fw-semibold py-3">Prénom</th>
                                <th class="fw-semibold py-3">Email</th>
                                <th class="fw-semibold py-3">Genre</th>
                                <th class="fw-semibold py-3">Statut</th>
                                <th class="fw-semibold py-3">Naissance</th>
                                <th class="fw-semibold py-3">Téléphone</th>
                                <th class="fw-semibold py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="patientsTableBody">
                            @foreach (Patient patient in Model)
                            {
                                <tr class="clickable-row" data-href="@Url.Action("Anamnese", "Patient", new { id = patient.Id })">
                                    <td class="fw-medium py-3">@patient.LastName</td>
                                    <td class="py-3">@patient.FirstName</td>
                                    <td class="py-3">@patient.Email</td>
                                    <td class="py-3">
                                        @switch (patient.Gender)
                                        {
                                            case Gender.Homme:
                                                <span class="badge bg-primary rounded-pill px-3 py-2">H</span>
                                                break;
                                            case Gender.Femme:
                                                <span class="badge bg-danger rounded-pill px-3 py-2">F</span>
                                                break;
                                            case Gender.Autre:
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">A</span>
                                                break;
                                        }
                                    </td>
                                    <td class="py-3">
                                        @switch (patient.Status)
                                        {
                                            case PatientStatus.Actif:
                                                <span class="badge bg-success rounded-pill px-3 py-2">Actif</span>
                                                break;
                                            case PatientStatus.Terminé:
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">Terminé</span>
                                                break;
                                            case PatientStatus.Inactif:
                                                <span class="badge bg-muted text-dark rounded-pill px-3 py-2">Suspendu</span>
                                                break;
                                            case PatientStatus.Abandonné:
                                                <span class="badge bg-danger rounded-pill px-3 py-2">Abandonné</span>
                                                break;
                                        }
                                    </td>
                                    <td class="py-3">@patient.BirthDate.ToString("dd/MM/yyyy")</td>
                                    <td class="py-3">@patient.PhoneNumber</td>
                                    <td class="py-3 text-end actions-cell">
                                        <form asp-controller="Index" asp-action="Delete" asp-route-id="@patient.Id"
                                              method="post" class="delete-form d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="event.stopPropagation(); return confirm('Supprimer ce patient ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Page navigation" id="paginationContainer" class="mt-4">
                    <ul class="pagination justify-content-center gap-1" id="paginationControls"></ul>
                </nav>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="addPatientModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-lg-down modal-dialog-scrollable modal-fullwidth">
        <div class="modal-content border-0">
            <div class="modal-header border-0 sticky-top bg-white py-3 px-4">
                <h5 class="modal-title text-uppercase fw-light letter-spacing-wide fs-4">Nouveau patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addPatientForm" asp-controller="Index" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <input type="hidden" id="newDoctorLastName_hidden" name="NewDoctorLastName" value="">
                    <input type="hidden" id="newDoctorFirstName_hidden" name="NewDoctorFirstName" value="">
                    <input type="hidden" id="newDoctorINAMI_hidden" name="NewDoctorINAMI" value="">

                    <div class="row g-4">
                        <div class="col-12">
                            <div class="section-header d-flex align-items-center mb-2">
                                <div class="section-icon me-3">
                                    <i class="bi bi-person fs-4"></i>
                                </div>
                                <h6 class="text-uppercase text-muted small fw-semibold mb-0">Informations personnelles</h6>
                            </div>
                            <hr class="mt-0 mb-3">
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Nom *</label>
                            <input type="text" class="form-control cache-field" name="LastName" data-field="LastName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Prénom *</label>
                            <input type="text" class="form-control cache-field" name="FirstName" data-field="FirstName" data-validation="text" required>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Genre *</label>
                            <select class="form-select cache-field" name="Genre" data-field="Genre" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Homme</option>
                                <option value="1">Femme</option>
                                <option value="2">Autre</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Date de naissance *</label>
                            <input type="date" class="form-control cache-field" name="BirthDate" data-field="BirthDate" data-validation="date" required>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">N° Sécurité sociale *</label>
                            <input type="text" class="form-control cache-field" name="SocialSecurityNumber" data-field="SocialSecurityNumber" data-validation="SocialSecNumber" placeholder="XX.XX.XX-XXX.XX" required>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Téléphone *</label>
                            <input type="tel" class="form-control cache-field" name="PhoneNumber" data-field="PhoneNumber" data-validation="phone" required>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-uppercase text-muted">Email *</label>
                            <input type="email" class="form-control cache-field" name="Email" data-field="Email" data-validation="email" required>
                        </div>
                        <div class="col-12 col-xl-8">
                            <label class="form-label small text-uppercase text-muted">Adresse</label>
                            <input type="text" class="form-control cache-field" data-field="Address" name="Address">
                        </div>
                        <div class="col-12 col-xl-8">
                            <label class="form-label small text-uppercase text-muted">Pays</label>
                            <select class="form-select cache-field" name="Country" data-field="Country" data-validation="select" required>
                                <option value="">-- Sélectionner --</option>
                                <option value="0">Belgique</option>
                                <option value="1">France</option>
                                <option value="2">Luxembourg</option>
                                <option value="3">Suisse</option>

                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="section-header d-flex align-items-center mb-2">
                                <div class="section-icon me-3">
                                    <i class="bi bi-heart-pulse fs-4"></i>
                                </div>
                                <h6 class="text-uppercase text-muted small fw-semibold mb-0">Informations médicales</h6>
                            </div>
                            <hr class="mt-0 mb-3">
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small text-uppercase text-muted">Poids (kg)</label>
                            <input type="number" class="form-control cache-field" name="Weight" data-field="Weight" data-validation="decimal" min="0">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-uppercase text-muted">Taille (cm)</label>
                            <input type="number" class="form-control cache-field" name="Height" data-field="Height" data-validation="decimal" min="0">
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label class="form-label small text-uppercase text-muted">Médecin traitant</label>
                            <select class="form-select cache-field" name="DoctorId" id="doctorSelect" data-field="DoctorId">
                                <option value="">-- Aucun médecin --</option>
                                @if (ViewBag.Doctors != null)
                                {
                                    @foreach (var doctor in ViewBag.Doctors)
                                    {
                                        <option value="@doctor.Id" data-inami="@doctor.NumeroINAMI">
                                            Dr. @doctor.FirstName @doctor.LastName (INAMI: @doctor.NumeroINAMI)
                                        </option>
                                    }
                                }
                            </select>
                            <div class="mt-2" id="addDoctorBtnContainer" style="display: none;">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="addDoctorBtn">
                                    <i class="bi bi-plus-circle me-1"></i>Ajouter un nouveau médecin
                                </button>
                            </div>
                        </div>

                        <div class="col-12 collapse" id="addDoctorSection">
                            <div class="card mt-2 border-primary">
                                <div class="card-body">
                                    <h6 class="text-uppercase text-muted small fw-semibold mb-3">
                                        <i class="bi bi-person-plus me-2"></i>Nouveau médecin
                                    </h6>
                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">Nom *</label>
                                            <input type="text" class="form-control" id="newDoctorLastName" required>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">Prénom *</label>
                                            <input type="text" class="form-control" id="newDoctorFirstName" required>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label small">N° INAMI *</label>
                                            <input type="text" class="form-control" id="newDoctorINAMI" 
                                                   placeholder="11 chiffres sans tirets" 
                                                   maxlength="11"
                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 sticky-bottom bg-white py-3 px-4 gap-2">
                <button type="button" class="btn btn-light flex-grow-1 flex-sm-grow-0" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-secondary flex-grow-1 flex-sm-grow-0" id="createPatientBtn" disabled>
                    <i class="bi bi-check-circle me-2"></i>Créer le patient
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .letter-spacing-wide {
            letter-spacing: 0.1em;
        }

        .btn-touch {
            min-height: 44px;
            padding: 0.625rem 1rem;
        }

        .clickable-row {
            cursor: pointer;
            transition: background-color 0.15s ease-in-out;
        }

            .clickable-row:hover {
                background-color: var(--bs-gray-100) !important;
            }

        .clickable-card {
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .clickable-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
            }

            .clickable-card:active {
                transform: scale(0.98);
            }

        .delete-form {
            position: relative;
            z-index: 10;
        }

        .is-valid-custom {
            border-color: var(--bs-success) !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%234bbf73' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1rem 1rem;
            padding-right: calc(1.5em + 1.5rem);
        }

        .is-invalid-custom {
            border-color: var(--bs-danger) !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%23d9534f'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23d9534f' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1rem 1rem;
            padding-right: calc(1.5em + 1.5rem);
        }

        .table thead th {
            border-bottom: 2px solid var(--bs-gray-200);
            font-size: 0.7rem;
            letter-spacing: 0.05em;
        }

        .pagination .page-link {
            min-width: 44px;
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 0.5rem !important;
        }

        .pagination .page-item.active .page-link {
            background-color: var(--bs-gray-900);
        }

        .section-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--bs-gray-100);
            border-radius: 0.5rem;
            color: var(--bs-gray-700);
        }

        .modal-fullwidth {
            max-width: 95%;
            width: 95%;
            margin: 1.75rem auto;
        }

            .modal-fullwidth .modal-content {
                min-height: calc(100vh - 3.5rem);
            }

            .modal-fullwidth .modal-body {
                padding: 2rem 3rem;
            }

        @@media (min-width: 1400px) {
            .modal-fullwidth {
                max-width: 1320px;
            }
        }

        @@media (min-width: 576px) and (max-width: 991px) {
            #patientsCardsView {
                display: grid !important;
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }

                #patientsCardsView .patient-card {
                    margin-bottom: 0 !important;
                }
                    #patientsCardsView .patient-card:nth-last-child(1):nth-child(odd) {
                        grid-column: 1 / span 2;
                        justify-self: center;
                        width: 70%;
                    }
        }

        @@media (max-width: 991px) {
            input, select, textarea {
                font-size: 16px !important;
            }

            .modal-fullwidth .modal-body {
                padding: 1.25rem 1.5rem;
            }
        }
    </style>

    <script>
        const ADD_STORAGE_KEY = 'addPatientFormData';
        let addFormData = {}, currentPage = 1, currentSearch = '', currentStatus = 'Tous', searchTimeout = null;
        const pageSize = 5;

        function validateField(input) {
            const type = input.dataset.validation, value = input.value.trim();
            if (!type) return true;
            switch (type) {
                case 'text': return value.length >= 2;
                case 'email': return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value);
                case 'phone': return value.replace(/[\s\-\(\)\.]/g, '').length >= 9;
                case 'decimal': return !value || (parseFloat(value) > 0);
                case 'date': return value && new Date(value) < new Date();
                case 'select': return value !== '';
                case 'SocialSecNumber':
                    if (!value) return false;
                    const n = value.replace(/[\s\.\-]/g, '');
                    if (!/^\d{11}$/.test(n)) return false;
                    const month = parseInt(n.substring(2, 4)), day = parseInt(n.substring(4, 6));
                    const validMonth = (month >= 1 && month <= 12) || (month >= 21 && month <= 32) || (month >= 41 && month <= 52);
                    if (!validMonth || day < 1 || day > 31) return false;
                    let base = parseInt(n.substring(0, 9)), check = parseInt(n.substring(9, 11)), calc = 97 - (base % 97);
                    if (calc !== check) calc = 97 - (parseInt('2' + n.substring(0, 9)) % 97);
                    return calc === check;
                default: return value.length > 0;
            }
        }

        function updateFieldState(input) {
            const value = input.value.trim();
            input.classList.remove('is-valid-custom', 'is-invalid-custom');
            if (value) input.classList.add(validateField(input) ? 'is-valid-custom' : 'is-invalid-custom');
        }

        function updateCreateButton() {
            const required = ['LastName', 'FirstName', 'Email', 'PhoneNumber', 'Genre', 'BirthDate', 'SocialSecurityNumber'];
            const valid = required.every(f => { const input = document.querySelector(`.cache-field[data-field="${f}"]`); return input && input.value.trim() && validateField(input); });
            const btn = document.getElementById('createPatientBtn');
            btn.disabled = !valid;
            btn.classList.toggle('btn-primary', valid);
            btn.classList.toggle('btn-secondary', !valid);
        }

        function saveField(input) {
            updateFieldState(input);
            addFormData[input.dataset.field] = input.value;
            localStorage.setItem(ADD_STORAGE_KEY, JSON.stringify(addFormData));
            updateCreateButton();
        }

        function restoreForm() {
            try {
                addFormData = JSON.parse(localStorage.getItem(ADD_STORAGE_KEY)) || {};
                Object.entries(addFormData).forEach(([field, value]) => { const input = document.querySelector(`.cache-field[data-field="${field}"]`); if (input && value) { input.value = value; updateFieldState(input); } });
                updateCreateButton();
            } catch (e) {}
        }

        function performSearch() {
            currentSearch = document.getElementById('searchInput').value;
            currentStatus = document.getElementById('statusFilter').value;
            currentPage = 1;
            if (!currentSearch.trim()) {
                document.getElementById('patientsTableBody').innerHTML = '';
                document.getElementById('patientsCardsView').innerHTML = '';
                document.getElementById('paginationContainer').style.display = 'none';
                document.getElementById('noResultsMessage').style.display = 'none';
                return;
            }
            loadPatients();
        }

        function loadPatients() {
            document.getElementById('loadingIndicator').style.display = 'block';
            fetch(`/Index/SearchPatients?search=${currentSearch}&status=${currentStatus}&page=${currentPage}&pageSize=${pageSize}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('loadingIndicator').style.display = 'none';
                    if (!data.patients.length) {
                        document.getElementById('noResultsMessage').style.display = 'block';
                        document.getElementById('patientsTableBody').innerHTML = '';
                        document.getElementById('patientsCardsView').innerHTML = '';
                        document.getElementById('paginationContainer').style.display = 'none';
                    } else {
                        document.getElementById('noResultsMessage').style.display = 'none';
                        updateTable(data.patients);
                        updateCards(data.patients);
                        updatePagination(data.currentPage, data.totalPages);
                        document.getElementById('paginationContainer').style.display = 'block';
                    }
                });
        }

        function getGenderBadge(g, large) {
            const cls = large ? 'px-3 py-2' : '', labels = { 0: ['bg-primary', 'H'], 1: ['bg-danger', 'F'], 2: ['bg-secondary', 'A'] };
            return `<span class="badge ${labels[g][0]} rounded-pill ${cls}">${labels[g][1]}</span>`;
        }

        function getStatusBadge(s, large) {
            const cls = large ? 'px-3 py-2' : '', labels = { 0: ['bg-success', 'Actif'], 1: ['bg-secondary', 'Terminé'], 2: ['bg-warning text-dark', 'Inactif'], 3: ['bg-danger', 'Abandonné'] };
            return `<span class="badge ${labels[s][0]} rounded-pill ${cls}">${labels[s][1]}</span>`;
        }

        function formatDate(d) { const dt = new Date(d); return `${dt.getDate().toString().padStart(2,'0')}/${(dt.getMonth()+1).toString().padStart(2,'0')}/${dt.getFullYear()}`; }

        function updateTable(patients) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            document.getElementById('patientsTableBody').innerHTML = patients.map(p => `
                <tr class="clickable-row" data-href="/Patient/${p.id}/Anamnese/">
                    <td class="fw-medium py-3">${p.lastName}</td><td class="py-3">${p.firstName}</td><td class="py-3">${p.email}</td>
                    <td class="py-3">${getGenderBadge(p.gender, true)}</td><td class="py-3">${getStatusBadge(p.status, true)}</td>
                    <td class="py-3">${formatDate(p.birthDate)}</td><td class="py-3">${p.phoneNumber}</td>
                    <td class="py-3 text-end actions-cell"><form action="/Index/${p.id}/Delete" method="post" class="delete-form d-inline"><input type="hidden" name="__RequestVerificationToken" value="${token}"><button type="submit" class="btn btn-outline-danger btn-sm" onclick="event.stopPropagation(); return confirm('Supprimer ce patient ?');"><i class="bi bi-trash"></i></button></form></td>
                </tr>`).join('');
            attachRowEvents();
        }

        function updateCards(patients) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            document.getElementById('patientsCardsView').innerHTML = patients.map(p => `
                <div class="card mb-3 patient-card border-0 shadow-sm clickable-card" data-href="/Patient/${p.id}/Anamnese/">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div><h5 class="card-title mb-1 fw-semibold">${p.lastName} ${p.firstName}</h5><p class="card-text text-muted small mb-0"><i class="bi bi-calendar3 me-1"></i>${formatDate(p.birthDate)}</p></div>
                            <div class="d-flex gap-2">${getGenderBadge(p.gender, false)}${getStatusBadge(p.status, false)}</div>
                        </div>
                        <div class="row g-2 mb-3 small"><div class="col-12"><span class="text-muted"><i class="bi bi-envelope me-2"></i>${p.email}</span></div><div class="col-12"><span class="text-muted"><i class="bi bi-telephone me-2"></i>${p.phoneNumber}</span></div></div>
                        <div class="d-flex justify-content-end"><form action="/Index/${p.id}/Delete" method="post" class="delete-form"><input type="hidden" name="__RequestVerificationToken" value="${token}"><button type="submit" class="btn btn-outline-danger btn-touch" onclick="event.stopPropagation(); return confirm('Supprimer ce patient ?');"><i class="bi bi-trash me-2"></i>Supprimer</button></form></div>
                    </div>
                </div>`).join('');
            attachCardEvents();
        }

        function updatePagination(current, total) {
            const ul = document.getElementById('paginationControls');
            let html = `<li class="page-item ${current === 1 ? 'disabled' : ''}"><a class="page-link" href="#" data-page="${current-1}"><i class="bi bi-chevron-left"></i></a></li>`;
            for (let i = 1; i <= total; i++) html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
            html += `<li class="page-item ${current === total ? 'disabled' : ''}"><a class="page-link" href="#" data-page="${current+1}"><i class="bi bi-chevron-right"></i></a></li>`;
            ul.innerHTML = html;
            ul.querySelectorAll('a.page-link').forEach(a => a.addEventListener('click', e => { e.preventDefault(); if (!a.parentElement.classList.contains('disabled') && !a.parentElement.classList.contains('active')) { currentPage = parseInt(a.dataset.page); loadPatients(); } }));
        }

        function attachRowEvents() { document.querySelectorAll('.clickable-row').forEach(row => row.addEventListener('click', e => { if (!e.target.closest('.delete-form')) window.location.href = row.dataset.href; })); }
        function attachCardEvents() { document.querySelectorAll('.clickable-card').forEach(card => card.addEventListener('click', e => { if (!e.target.closest('.delete-form')) window.location.href = card.dataset.href; })); }

        document.addEventListener('DOMContentLoaded', () => {
            attachRowEvents();
            attachCardEvents();
            document.querySelectorAll('.cache-field').forEach(input => ['input', 'blur', 'change'].forEach(evt => input.addEventListener(evt, () => saveField(input))));
            document.getElementById('createPatientBtn').addEventListener('click', async (e) => {
            e.preventDefault();

            const selectedDoctorId = document.getElementById('doctorSelect').value;

            if (selectedDoctorId === '') {
                const dLastName = document.getElementById('newDoctorLastName').value.trim();
                const dFirstName = document.getElementById('newDoctorFirstName').value.trim();
                const dInami = document.getElementById('newDoctorINAMI').value.trim();


                if (dLastName || dFirstName || dInami) {

                    if (!dLastName || !dFirstName || !dInami) {
                        alert("Veuillez remplir tous les champs pour le nouveau médecin (Nom, Prénom et INAMI).");
                        return; 
                    }

                    if (!/^\d{11}$/.test(dInami)) {
                        alert("Le numéro INAMI doit contenir exactement 11 chiffres.");

                        const inamiInput = document.getElementById('newDoctorINAMI');
                        inamiInput.classList.add('is-invalid-custom');
                        inamiInput.focus();

                        return; 
                    }
                }

                document.getElementById('newDoctorLastName_hidden').value = dLastName;
                document.getElementById('newDoctorFirstName_hidden').value = dFirstName;
                document.getElementById('newDoctorINAMI_hidden').value = dInami;

            } else {
                document.getElementById('newDoctorLastName_hidden').value = '';
                document.getElementById('newDoctorFirstName_hidden').value = '';
                document.getElementById('newDoctorINAMI_hidden').value = '';
            }

            localStorage.removeItem(ADD_STORAGE_KEY);
            document.getElementById('addPatientForm').submit();
        });
            
            document.getElementById('searchInput').addEventListener('input', () => { clearTimeout(searchTimeout); searchTimeout = setTimeout(performSearch, 300); });
            document.getElementById('statusFilter').addEventListener('change', performSearch);
            
            const doctorSelect = document.getElementById('doctorSelect');
            const addDoctorBtnContainer = document.getElementById('addDoctorBtnContainer');
            const addDoctorBtn = document.getElementById('addDoctorBtn');
            const addDoctorSection = document.getElementById('addDoctorSection');
            
            function updateAddDoctorButtonVisibility() {
                const selectedValue = doctorSelect.value;
                
                if (selectedValue === '') {
                    addDoctorBtnContainer.style.display = 'block';
                } else {
                    addDoctorBtnContainer.style.display = 'none';
                    
                    const bsCollapse = bootstrap.Collapse.getInstance(addDoctorSection);
                    if (bsCollapse) {
                        bsCollapse.hide();
                    }
                    
                    document.getElementById('newDoctorLastName').value = '';
                    document.getElementById('newDoctorFirstName').value = '';
                    document.getElementById('newDoctorINAMI').value = '';
                }
            }
            
            doctorSelect.addEventListener('change', updateAddDoctorButtonVisibility);
            
            updateAddDoctorButtonVisibility();
            
            addDoctorBtn.addEventListener('click', function() {
                const bsCollapse = new bootstrap.Collapse(addDoctorSection, { toggle: true });
            });
            
            performSearch();
        });

        document.getElementById('newDoctorINAMI').addEventListener('input', function(e) {
            const val = e.target.value;
            e.target.classList.remove('is-valid-custom', 'is-invalid-custom');
    
            if (val.length === 0) return; 

            if (/^\d{11}$/.test(val)) {
                e.target.classList.add('is-valid-custom'); 
            } else {
                e.target.classList.add('is-invalid-custom'); 
            }
                });

        document.getElementById('addPatientModal').addEventListener('shown.bs.modal', restoreForm);
        document.getElementById('addPatientModal').addEventListener('hidden.bs.modal', () => document.querySelectorAll('.cache-field').forEach(i => i.classList.remove('is-valid-custom', 'is-invalid-custom')));
    </script>
}
