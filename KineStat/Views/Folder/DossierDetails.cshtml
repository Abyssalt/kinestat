@model KineStat.Models.Dossier

@{
    ViewData["Title"] = "Détails du dossier";
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Patients'>Patients</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Patient/{Model.Patient.Id}/Anamnese'>Anamnèse - {Model.Patient.FirstName} {Model.Patient.LastName}</a></li>" +
                              $"<li class='breadcrumb-item active'>Dossier {Model.Titre}</li>";}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-folder-open me-2"></i>@Model.Titre
                    </h1>
                </div>
                <a asp-action="Anamnese" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour à l'anamnèse
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-success text-white py-3">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-clipboard2-pulse me-2"></i>Bilans
                        </h5>
                        <a asp-controller="Assessments" asp-action="CreateAssessment" asp-route-dossierId="@Model.Id" class="btn btn-light fw-medium">
                            <i class="bi bi-plus-circle me-1"></i>Nouveau bilan
                        </a>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if (!Model.Assessments.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-clipboard display-4 text-secondary"></i>
                            <p class="text-secondary mt-3 mb-0">Aucun bilan pour ce dossier</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var assessment in Model.Assessments.OrderByDescending(a => a.Date))
                            {
                                <a asp-controller="Assessments" asp-action="AssessmentDetails"
                                   asp-route-id="@assessment.Id"
                                   class="list-group-item list-group-item-action border-0 border-bottom px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-semibold">
                                                <i class="bi bi-calendar3 text-success me-2"></i>Bilan du @assessment.Date.ToString("dd/MM/yyyy")
                                            </h6>
                                            <small class="text-secondary">
                                                <i class="bi bi-person-badge me-1"></i>Kiné : @assessment.Physio?.FirstName
                                            </small>
                                        </div>
                                        <i class="bi bi-chevron-right text-secondary"></i>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>