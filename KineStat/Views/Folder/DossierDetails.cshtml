@model KineStat.Models.Dossier

@{
    ViewData["Title"] = "Détails du dossier";
    ViewData["Breadcrumbs"] = $"<li class='breadcrumb-item'><a href='/Index'>Patients</a></li>" +
                              $"<li class='breadcrumb-item'><a href='/Patient/{Model.Patient.Id}/Anamnese'>Anamnèse</a></li>" +
                              $"<li class='breadcrumb-item active'>Dossier</li>";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-folder-open me-2"></i>@Model.Titre
                    </h1>
                </div>
                <a asp-controller="Patient" asp-action="Anamnese" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Retour à l'anamnèse
                </a>
            </div>
            <hr class="border-primary border-2 opacity-25 mt-3">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light py-3">
                                <h5 class="mb-0 fw-bold text-secondary">
                                    <i class="bi bi-journal-text me-2"></i>Notes du dossier
                                </h5>
                            </div>
                            <div class="card-body p-3 p-md-4">
                                <p class="mb-0 text-secondary" style="white-space: pre-line;">
                                    @Model.Notes
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-success text-white py-3">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-clipboard2-pulse me-2"></i>Bilans
                        </h5>
                        <a asp-controller="Assessments" asp-action="CreateAssessment" asp-route-dossierId="@Model.Id" class="btn btn-light fw-medium">
                            <i class="bi bi-plus-circle me-1"></i>Nouveau bilan
                        </a>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if (!Model.Assessments.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-clipboard display-4 text-secondary"></i>
                            <p class="text-secondary mt-3 mb-0">Aucun bilan pour ce dossier</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var assessment in Model.Assessments.OrderByDescending(a => a.Date))
                            {
                                <div class="list-group-item border-0 border-bottom px-0 py-3">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <a asp-controller="Assessments" asp-action="AssessmentDetails" asp-route-id="@assessment.Id"
                                           class="text-decoration-none text-reset flex-grow-1">
                                            <div>
                                                <h6 class="mb-1 fw-semibold">
                                                    <i class="bi bi-calendar3 text-success me-2"></i>Bilan du @assessment.Date.ToString("dd/MM/yyyy")
                                                </h6>
                                                <small class="text-secondary d-block">
                                                    <i class="bi bi-person-badge me-1"></i>Kiné : @assessment.Physio?.FirstName
                                                </small>
                                            </div>
                                        </a>

                                        <div class="d-flex align-items-center ms-3">

                                            @if (assessment.Status == AssessmentStatus.EnCours)
                                            {
                                                <a asp-controller="Assessments" asp-action="Socrate" asp-route-id="@Model.PatientId" asp-route-assessmentId="@assessment.Id"
                                                   class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3 me-3">
                                                    <i class="bi bi-play-fill me-1"></i>Reprendre
                                                </a>

                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 me-2 border border-success border-opacity-25">
                                                    En cours
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger px-3 py-2 rounded-pill fw-semibold me-2">
                                                    Clôturé
                                                </span>
                                            }

                                            <a asp-controller="Assessments" asp-action="AssessmentDetails" asp-route-id="@assessment.Id" class="text-secondary">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>