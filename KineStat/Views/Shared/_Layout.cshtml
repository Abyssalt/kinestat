<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KineStat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lux/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KineStat.styles.css" asp-append-version="true" />
    <script src="~/js/anamnese.js"></script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo KineStat" height="32" class="me-2" />
                    KineStat
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @if (ViewData["PatientId"] != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="Anamnese" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-clipboard-pulse d-lg-none me-2"></i>Anamnèse
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="Socrate" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-chat-square-text d-lg-none me-2"></i>SOCRATE
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="RedFlags" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-exclamation-triangle d-lg-none me-2"></i>Red flags
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="ExamenClinique" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-search d-lg-none me-2"></i>Examen clinique
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="Tests" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-list-check d-lg-none me-2"></i>Tests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium" asp-area="" asp-controller="Patient" asp-action="Resultat" asp-route-id="@ViewData["PatientId"]">
                                    <i class="bi bi-graph-up d-lg-none me-2"></i>Résultat
                                </a>
                            </li>
                        }
                    </ul>

                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item me-2">
                                <span class="navbar-text">
                                    <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserName")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-danger fw-medium">
                                        <i class="bi bi-box-arrow-right me-1"></i>Se déconnecter
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container px-3 px-md-4">
        @if (ViewData["Breadcrumbs"] != null)
        {
            <nav aria-label="breadcrumb" class="mt-3">
                <ol class="breadcrumb">
                    @Html.Raw(ViewData["Breadcrumbs"])
                </ol>
            </nav>
        }
    </div>

    <div class="container px-3 px-md-4 flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    @if (ViewData["PatientId"] != null && ViewData["HideFloatingEye"] == null)
    {
        <div class="position-fixed bottom-0 end-0 m-3 m-md-4" style="z-index: 1030;">
            <div class="collapse position-absolute bottom-100 end-0 mb-2" id="floatingInfoPanel">
                <div class="card shadow-lg border-0" style="width: 90vw; max-width: 600px; height: 70vh; max-height: 500px;">
                    <div class="card-body d-flex flex-column p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-bar-chart-line text-warning me-2"></i>Graphiques
                            </h6>
                            <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#floatingInfoPanel" aria-label="Fermer"></button>
                        </div>
                        <hr class="my-2">
                        <div class="flex-grow-1 overflow-auto">
                            <canvas id="radarChart9"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary rounded-circle shadow d-flex align-items-center justify-content-center"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#floatingInfoPanel"
                    aria-expanded="false"
                    aria-controls="floatingInfoPanel"
                    style="width: 50px; height: 50px;">
                <i class="bi bi-eye-fill fs-5"></i>
            </button>
        </div>
    }

    <footer class="border-top bg-light mt-auto">
        <div class="container">
            <div class="text-center py-3">
                <p class="mb-0 text-secondary small">&copy; 2025 KineStat - Licence MIT - HERS Section Informatique</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const canvas = document.getElementById("radarChart9");

            if (!canvas) {
                return;
            }

            new Chart(canvas, {
                type: 'radar',
                data: {
                    labels: [
                        "Tumeur",
                        "Infection",
                        "Neurologique",
                        "Traumatisme",
                        "Inflammatoire",
                        "Vasculaire"
                    ],
                    datasets: [{
                        label: "Profil TINTIV",
                        data: [3, 10, 2, 8, 7, 1],
                        backgroundColor: "rgba(255,99,132,0.25)",
                        borderColor: "rgb(255,99,132)",
                        borderWidth: 3,
                        pointBackgroundColor: "rgb(255,99,132)",
                        pointBorderColor: "#fff"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            min: 0,
                            max: 10,
                            ticks: {
                                stepSize: 2,
                                backdropColor: "transparent"
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
