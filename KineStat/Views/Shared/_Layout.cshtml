<!DOCTYPE html>
<html lang="fr">
<head>

    <meta charset="utf-8" />

    @if (ViewData["PatientId"] != null && ViewData["AssessmentId"] != null)
    {
        <meta name="patient-id" content="@ViewData["PatientId"]" />
        <meta name="assessment-id" content="@ViewData["AssessmentId"]" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>@ViewData["Title"] - KineStat</title>
    
    <!-- Si PB avec le thème bootswatch, décommenter cette ligne et on récupère le thème bootstrap basique -->
    <!-- <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> -->
    
    <link rel="stylesheet" href="~/css/bootstrap.min.css"/><!-- Thème bootswatch LUX -->
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Added for resizing the content for tablet -->
    <style>
        @@media (min-width: 768px) and (max-width: 1399px) {
            .btn-tablet-lg {
                padding: 0.75rem 1.5rem !important;
                font-size: 1.25rem !important;
            }
        }

        .modal {
            background-color: transparent !important;
        }

        .modal-dialog {
            box-shadow: none !important;
        }
    </style>
    
    <script src="~/js/redflags-store.js"></script>
    <script src="~/js/clinical-store.js"></script>

    </head>
    <body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            
            @if (ViewData["AssessmentId"] != null && ViewData["ShowSuspendButton"] != null)
            {
                var dossierId = ViewData["FolderId"];

                <div class="position-fixed top-0 end-0 mt-5 me-3 me-md-4" style="z-index: 1025; padding-top: 70px;">
                    <a asp-controller="Folder" 
                       asp-action="DossierDetails" 
                       asp-route-id="@dossierId"
                       class="btn btn-warning rounded-circle shadow d-flex align-items-center justify-content-center"
                       style="width: 50px; height: 50px;"
                       title="Suspendre le bilan"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right">
                        <i class="bi bi-pause-circle-fill fs-5"></i>
                    </a>
                </div>
            }
            <div class="container-fluid px-3 px-lg-4">

                @{
                    var userRole = Context.Session.GetString("UserRole");
                    string controller = null;
                    if (userRole == "Admin")
                    {
                        controller = "Admin";
                    }
                    else if (userRole == "Physio")
                    {
                        controller = "Index";
                    }
                }
                <a class="navbar-brand d-flex align-items-center fw-bold text-primary"
                   asp-area=""
                   asp-controller="@controller"
                   asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo KineStat" height="32" class="me-2"/>
                    KineStat
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarMain">

                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item me-2">
                                <span class="navbar-text">
                                    <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserName")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-danger fw-medium">
                                        <i class="bi bi-box-arrow-right me-1"></i>Se déconnecter
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

        <div class="container px-3 px-md-4">
            @if (ViewData["Breadcrumbs"] != null)
            {
                <nav aria-label="breadcrumb" class="mt-3">
                    <ol class="breadcrumb">
                        @Html.Raw(ViewData["Breadcrumbs"])
                    </ol>
                </nav>
            }
        </div>

        <div class="container px-3 px-md-4 flex-grow-1">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>

    @if (ViewData["PatientId"] != null && (ViewData["ShowFloatingEye"] != null || ViewData["ShowClinicalFloatingEye"] != null))
        {

            <div class="position-fixed bottom-0 end-0 me-3 me-md-4 mb-5" style="z-index: 1030; margin-bottom: 100px !important;">
                <div class="collapse position-absolute bottom-100 end-0 mb-2" id="floatingInfoPanel">
                    <div class="card shadow-lg border-0" style="width: 90vw; max-width: 600px; height: 70vh; max-height: 500px;">
                        <div class="card-body d-flex flex-column p-3 p-md-4">
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-2">
                                        <i class="bi bi-activity text-danger me-2"></i>Probabilité
                                    </h6>
                                    <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#floatingInfoPanel" aria-label="Fermer"></button>
                                </div>
                                <div style="height: 35px;">
                                    <canvas id="redFlagsGaugeEye"></canvas>
                                </div>

                                <div class="text-center mt-2">
                                    <span id="redFlagsGaugeEyeValue" class="fw-bold text-primary">0%</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 fw-bold">
                                    <i class="bi bi-bar-chart-line text-warning me-2"></i>Graphiques
                                </h6>
                                <button class="btn btn-sm btn-outline-primary" onclick="openChartModal()">
                                    <i class="bi bi-zoom-in"></i> Agrandir
                                </button>
                            </div>
                            <hr class="my-2">
                            <div class="flex-grow-1 overflow-auto">
                                @if (ViewData["ShowClinicalFloatingEye"] != null)
                                {
                                    <canvas id="radarChart9Eye"></canvas>
                                }
                                else
                                {
                                    <canvas id="radarChart6Eye"></canvas>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary rounded-circle shadow d-flex align-items-center justify-content-center"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#floatingInfoPanel"
                        aria-expanded="false"
                        aria-controls="floatingInfoPanel"
                        style="width: 50px; height: 50px;">
                    <i class="bi bi-eye-fill fs-5"></i>
                </button>
            </div>
        }
    <div class="modal fade" id="chartModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-bar-chart-line text-primary me-2"></i>
                        <span id="modalChartTitle">Graphique</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center justify-content-center" style="min-height: 80vh;">
                    <div style="width: 90%; max-width: 800px; height: 80vh;">
                        <canvas id="modalRadarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top bg-light mt-auto">
        <div class="container">
            <div class="text-center py-3">
                <p class="mb-0 text-secondary small">
                    &copy; 2025 KineStat –
                    <a href="https://mit-license.org/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="text-secondary text-decoration-none">
                        Licence MIT
                    </a> –
                    <a href="https://hers.be/formations/economique/bachelier-en-informatique/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="text-secondary text-decoration-none">
                        HERS Section Informatique
                    </a>
                </p>
            </div>
        </div>
    </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="~/js/gauge.js"></script>


        <script>
        document.addEventListener("DOMContentLoaded", () => {
            let radarChart6Instance = null;
            let radarChart9Instance = null;
            let radarChart6EyeInstance = null; 
            let radarChart9EyeInstance = null;
            let modalChartInstance = null;
            function initOrUpdateRadarChart6() {
                const ctx = document.getElementById("radarChart6");
                if (!ctx) return;

                const categoriesArray = window.RedFlagsStore ? RedFlagsStore.getCategories() : [0, 0, 0, 0, 0, 0];
                const data = categoriesArray.length === 6 ? categoriesArray : [0, 0, 0, 0, 0, 0];

                if (radarChart6Instance) {
                    radarChart6Instance.data.datasets[0].data = data;
                    radarChart6Instance.update();
                } else {
                        radarChart6Instance = new Chart(ctx, {
                        type: 'radar',
                        data: {
                            labels: ["Tumeur", "Infection", "Neurologique", "Traumatisme", "Inflammatoire", "Vasculaire"],
                            datasets: [{
                                label: "Profil TINTIV",
                                data: data,
                                backgroundColor: "rgba(255,99,132,0.30)",
                                borderColor: "rgb(255,99,132)",
                                borderWidth: 4,
                                pointRadius: 6,
                                pointHoverRadius: 9,
                                pointBackgroundColor: "rgb(255,99,132)",
                                pointBorderColor: "#fff",
                                tension: 0.25
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: {
                                duration: 300,
                                easing: 'easeOutQuart'
                            },
                            scales: {
                                r: {
                                    min: 0,
                                    max: 5,
                                    ticks: {
                                        stepSize: 2,
                                        backdropColor: "transparent"
                                    },
                                    pointLabels: {
                                        font: { size: 13 }
                                    }
                                }
                            },
                            plugins: {
                                legend: { display: false }
                            }
                        }
                    });

                }
            }
            function initOrUpdateRadarChart6Eye() {
                const ctx = document.getElementById("radarChart6Eye");
                if (!ctx) return;

                const categoriesArray = window.RedFlagsStore ? RedFlagsStore.getCategories() : [0, 0, 0, 0, 0, 0];
                const data = categoriesArray.length === 6 ? categoriesArray : [0, 0, 0, 0, 0, 0];

                if (radarChart6EyeInstance) {
                    radarChart6EyeInstance.data.datasets[0].data = data;
                    radarChart6EyeInstance.update();
                } else {
                    radarChart6EyeInstance = new Chart(ctx, {
                        type: 'radar',
                        data: {
                            labels: ["Tumeur", "Infection", "Neurologique", "Traumatisme", "Inflammatoire", "Vasculaire"],
                            datasets: [{
                                label: "Profil TINTIV",
                                data: data,
                                backgroundColor: "rgba(255,99,132,0.30)",
                                borderColor: "rgb(255,99,132)",
                                borderWidth: 4,
                                pointRadius: 6,
                                pointHoverRadius: 9,
                                pointBackgroundColor: "rgb(255,99,132)",
                                pointBorderColor: "#fff",
                                tension: 0.25
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: {
                                duration: 300,
                                easing: 'easeOutQuart'
                            },
                            scales: {
                                r: {
                                    min: 0,
                                    max: 5,
                                    ticks: {
                                        stepSize: 2,
                                        backdropColor: "transparent"
                                    },
                                    pointLabels: {
                                        font: { size: 13 }
                                    }
                                }
                            },
                            plugins: {
                                legend: { display: false }
                            }
                        }
                    });

                }
            }

            function initOrUpdateRadarChart9() {
                const ctx = document.getElementById("radarChart9");
                if (!ctx) return;

                const clinicalCategories = window.ClinicalProfileStore ? ClinicalProfileStore.get() : [0, 0, 0, 0, 0, 0, 0, 0, 0];
                const data = clinicalCategories.length === 9 ? clinicalCategories : [0, 0, 0, 0, 0, 0, 0, 0, 0];

                if (radarChart9Instance) {
                    radarChart9Instance.data.datasets[0].data = data;
                    radarChart9Instance.update();
                } else {
                    radarChart9Instance = new Chart(ctx, {
                        type: 'radar',
                        data: {
                            labels: [
                                "Articulaire/structurel", "Myofascial", "Nociceptif", "Neuropathique",
                                "Nociplastique", "Contrôle sensorimoteur", "Croyance & cognition",
                                "Socio-environnemental", "Émotionnel/Affectif"
                            ],
                            datasets: [{
                                label: "Profil clinique",
                                data: data,
                                backgroundColor: "rgba(13,110,253,0.25)",
                                borderColor: "rgb(13,110,253)",
                                borderWidth: 3,
                                pointBackgroundColor: "rgb(13,110,253)",
                                pointBorderColor: "#fff"
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                r: {
                                    min: 0,
                                    max: 5,
                                    ticks: { stepSize: 2, backdropColor: "transparent" }
                                }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
        }

                function initOrUpdateRadarChart9Eye() {
            const ctx = document.getElementById("radarChart9Eye");
            if (!ctx) return;

            const clinicalCategories = window.ClinicalProfileStore ? ClinicalProfileStore.get() : [0, 0, 0, 0, 0, 0, 0, 0, 0];
            const data = clinicalCategories.length === 9 ? clinicalCategories : [0, 0, 0, 0, 0, 0, 0, 0, 0];

            if (radarChart9EyeInstance) {
                radarChart9EyeInstance.data.datasets[0].data = data;
                radarChart9EyeInstance.update();
            } else {
                radarChart9EyeInstance = new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: [
                            "Articulaire/structurel", "Myofascial", "Nociceptif", "Neuropathique",
                            "Nociplastique", "Contrôle sensorimoteur", "Croyance & cognition",
                            "Socio-environnemental", "Émotionnel/Affectif"
                        ],
                        datasets: [{
                            label: "Profil clinique",
                            data: data,
                            backgroundColor: "rgba(13,110,253,0.25)",
                            borderColor: "rgb(13,110,253)",
                            borderWidth: 4,
                            pointRadius: 6,
                            pointHoverRadius: 9,
                            pointBackgroundColor: "rgb(13,110,253)",
                            pointBorderColor: "#fff",
                            tension: 0.25
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 300,
                            easing: 'easeOutQuart'
                        },
                        scales: {
                            r: {
                                min: 0,
                                max: 5,
                                ticks: {
                                    stepSize: 2,
                                    backdropColor: "transparent"
                                },
                                pointLabels: {
                                    font: { size: 11 }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        }

        window.openChartModal = function() {
                    const modal = new bootstrap.Modal(document.getElementById('chartModal'));
                    const isClinical = document.getElementById("radarChart9Eye") !== null;

                    if (modalChartInstance) {
                        modalChartInstance.destroy();
                    }

                    const ctx = document.getElementById("modalRadarChart");
                    document.getElementById("modalChartTitle").textContent = isClinical ? "Profil Clinique" : "Profil TINTIV";

                    if (isClinical) {
                        const clinicalCategories = window.ClinicalProfileStore ? ClinicalProfileStore.get() : [0, 0, 0, 0, 0, 0, 0, 0, 0];
                        modalChartInstance = new Chart(ctx, {
                            type: 'radar',
                            data: {
                                labels: [
                                    "Articulaire/structurel", "Myofascial", "Nociceptif", "Neuropathique",
                                    "Nociplastique", "Contrôle sensorimoteur", "Croyance & cognition",
                                    "Socio-environnemental", "Émotionnel/Affectif"
                                ],
                                datasets: [{
                                    label: "Profil clinique",
                                    data: clinicalCategories,
                                    backgroundColor: "rgba(13,110,253,0.25)",
                                    borderColor: "rgb(13,110,253)",
                                    borderWidth: 4,
                                    pointRadius: 8,
                                    pointHoverRadius: 12,
                                    pointBackgroundColor: "rgb(13,110,253)",
                                    pointBorderColor: "#fff",
                                    tension: 0.25
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    r: {
                                        min: 0,
                                        max: 5,
                                        ticks: {
                                            stepSize: 1,
                                            backdropColor: "transparent",
                                            font: { size: 14 }
                                        },
                                        pointLabels: {
                                            font: { size: 16, weight: 'bold' }
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: 'top',
                                        labels: { font: { size: 16 } }
                                    }
                                }
                            }
                        });
                    } else {
                        const categoriesArray = window.RedFlagsStore ? RedFlagsStore.getCategories() : [0, 0, 0, 0, 0, 0];
                        modalChartInstance = new Chart(ctx, {
                            type: 'radar',
                            data: {
                                labels: ["Tumeur", "Infection", "Neurologique", "Traumatisme", "Inflammatoire", "Vasculaire"],
                                datasets: [{
                                    label: "Profil TINTIV",
                                    data: categoriesArray,
                                    backgroundColor: "rgba(255,99,132,0.30)",
                                    borderColor: "rgb(255,99,132)",
                                    borderWidth: 4,
                                    pointRadius: 8,
                                    pointHoverRadius: 12,
                                    pointBackgroundColor: "rgb(255,99,132)",
                                    pointBorderColor: "#fff",
                                    tension: 0.25
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    r: {
                                        min: 0,
                                        max: 5,
                                        ticks: {
                                            stepSize: 1,
                                            backdropColor: "transparent",
                                            font: { size: 14 }
                                        },
                                        pointLabels: {
                                            font: { size: 16, weight: 'bold' }
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: 'top',
                                        labels: { font: { size: 16 } }
                                    }
                                }
                            }
                        });
                    }

                    modal.show();
                };


                    initOrUpdateRadarChart9();
            initOrUpdateRadarChart6();
            initOrUpdateRadarChart6Eye(); 
            initOrUpdateRadarChart9Eye();

            if (window.RedFlagsStore) {
                RedFlagsStore.subscribeCategories(categoriesArray => {
                    initOrUpdateRadarChart6();
                    initOrUpdateRadarChart6Eye();
                   //updatePathologiesList(categoriesArray);
                });
            }
            if (window.ClinicalProfileStore) {
                ClinicalProfileStore.subscribe(clinicalArray => {
                    initOrUpdateRadarChart9();
                    initOrUpdateRadarChart9Eye();
                });
            }

            const assessmentIdMeta = document.querySelector('meta[name="assessment-id"]');
            const patientIdMeta = document.querySelector('meta[name="patient-id"]');

            if (assessmentIdMeta && patientIdMeta) {
                const assessmentId = assessmentIdMeta.content;
                const patientId = patientIdMeta.content;

                fetch(`/Patient/${patientId}/Assessment/${assessmentId}/CategoryPercentages`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.categories) {
                            const hasValues = data.categories.some(cat => cat > 0);
                            if(hasValues && window.RedFlagsStore){
                                RedFlagsStore.setCategories(data.categories);
                                if (data.totalPercentage !== undefined) {
                                    RedFlagsStore.set(data.totalPercentage);
                                }
                            }else {
                                if(window.RedFlagesStore){
                                    RedFlagsStore.clear();
                                }
                            }
                        }else {
                            if(window.RedFlagesStore){
                                RedFlagsStore.clear();
                            }
                        }
                    })
                    .catch(error => {
                        console.error("Erreur lors du chargement des catégories:", error);
                         if (window.RedFlagsStore) {
                            RedFlagsStore.clear();
                        }
                    });

                fetch(`/Patient/${patientId}/Assessment/${assessmentId}/ClinicalCategoryPercentages`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.clinicalCategories) {
                            const hasValues = data.clinicalCategories.some(cat => cat > 0);

                            if (hasValues && window.ClinicalProfileStore) {
                                ClinicalProfileStore.set(data.clinicalCategories);
                            } else {
                                if (window.ClinicalProfileStore) {
                                    ClinicalProfileStore.set([0, 0, 0, 0, 0, 0, 0, 0, 0]);
                                }
                            }
                        } else {
                            if (window.ClinicalProfileStore) {
                                ClinicalProfileStore.set([0, 0, 0, 0, 0, 0, 0, 0, 0]);
                            }
                        }
                    })
                    .catch(error => {
                        console.error("Erreur lors du chargement des catégories cliniques:", error);
                    });
            }
        });
    </script>

        <script>

            document.addEventListener("DOMContentLoaded", () => {

                if (!window.RedFlagsStore) return;
                if (!document.getElementById("redFlagsGaugeEye")) return;
                GaugeManager.createGauge("redFlagsGaugeEye", "redFlagsGaugeEyeValue");

                RedFlagsStore.subscribe(value => {
                    GaugeManager.updateGauge("redFlagsGaugeEye", value);
                });
             
            });

        </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
