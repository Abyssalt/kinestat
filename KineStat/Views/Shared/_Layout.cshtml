<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KineStat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KineStat.styles.css" asp-append-version="true" />
    <script src="~/js/anamnese.js"></script>
    <style>
        .floating-info-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1030;
        }
        .floating-info-panel {
            position: absolute;
            bottom: 60px;
            right: 0;
            width: 320px;
            max-width: calc(100vw - 40px);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" height="30" class="me-2" />
                    KineStat
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Patients" asp-action="Index">Patients</a>
                        </li>

                        @if (ViewData["PatientId"] != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patient" asp-action="Anamnese" asp-route-id="@ViewData["PatientId"]">Anamnèse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patient" asp-action="RedFlags" asp-route-id="@ViewData["PatientId"]">Red flags</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patient" asp-action="ExamenClinique" asp-route-id="@ViewData["PatientId"]">Examen clinique</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patient" asp-action="Tests" asp-route-id="@ViewData["PatientId"]">Tests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patient" asp-action="Resultat" asp-route-id="@ViewData["PatientId"]">Résultat</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link text-dark">Se déconnecter</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (ViewData["Breadcrumbs"] != null)
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @Html.Raw(ViewData["Breadcrumbs"])
                </ol>
            </nav>
        }
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
<style>
    .floating-info-panel {
        position: absolute;
        bottom: 60px;
        right: 0;
        width: 650px !important;
        height: 650px !important;
        max-width: 90vw;
        max-height: 90vh;
    }

    .floating-info-content {
        height: 580px !important;
    }
</style>
    @if (ViewData["PatientId"] != null && ViewData["HideFloatingEye"] == null)
    {
        <div class="floating-info-container">
            <div class="collapse floating-info-panel" id="floatingInfoPanel">
                <div class="card shadow-lg border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">
                                <i class="bi bi-bar-chart-line text-warning"></i> Graphiques
                            </h6>
                            <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#floatingInfoPanel" aria-label="Close"></button>
                        </div>
                        <hr class="my-2">
                        <div class="floating-info-content" style="max-height: 80%; overflow-y: auto;">
                            <canvas id="radarChart9" width="80%" height="80%"></canvas>

                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary rounded-circle shadow"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#floatingInfoPanel"
                    aria-expanded="false"
                    aria-controls="floatingInfoPanel"
                    style="width: 50px; height: 50px;">
                <i class="bi bi-eye-fill fs-5"></i>
            </button>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="text-center py-1">
                <p class="mb-1">&copy; 2025 KineStat - Licence MIT - HERS Section Informatique</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const canvas = document.getElementById("radarChart9");

            if (!canvas) {
                console.error("Canvas radarChart9 introuvable !");
                return;
            }

            new Chart(canvas, {
                type: 'radar',
                data: {
                    labels: [
                        "Tumeur",
                        "Infection",
                        "Neurologique",
                        "Traumatisme",
                        "Inflammatoire",
                        "Vasculaire"
                    ],
                    datasets: [{
                        label: "Profil TINTIV",
                        data: [3, 10, 2, 8, 7, 1],
                        backgroundColor: "rgba(255,99,132,0.25)",
                        borderColor: "rgb(255,99,132)",
                        borderWidth: 3,
                        pointBackgroundColor: "rgb(255,99,132)",
                        pointBorderColor: "#fff"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            min: 0,
                            max: 10,
                            ticks: {
                                stepSize: 2,
                                backdropColor: "transparent"
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
</script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
